    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Themes/Theme.Dark.xaml"/>
                <ResourceDictionary Source="Resources/Languages/Lang.zh-TW.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- [2026-02-24] 全域 BoolToVis 轉換器，供所有 UserControl 使用 -->
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <!-- [2026-03-11] 檔案大小格式化轉換器 -->
            <conv:FileSizeConverter x:Key="FileSizeConverter"/>
            <!-- [2026-03-12] 字串比對轉換器（RadioButton Tab 切換用） -->
            <conv:StringEqualConverter x:Key="StringEqualConverter"/>

            <!-- ================================================================ -->
            <!-- [2026-03-04] BaseBtnStyle：全域按鈕基底樣式                       -->
            <!--   漸層凸起 + Hover 變亮 + Pressed 凹入 + Cursor=Hand             -->
            <!--   尺寸預設 Medium，各頁面可用行內或 DynamicResource 覆寫           -->
            <!-- ================================================================ -->
            <!-- [2026-03-12] BaseBtnStyle：漸層/陰影/邊框全部引用主題資源，切換主題時自動生效 -->
            <Style x:Key="BaseBtnStyle" TargetType="Button">
                <Setter Property="FontFamily" Value="{DynamicResource FontFamily.Default}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Padding" Value="{DynamicResource BtnPadding.Medium}"/>
                <Setter Property="Margin" Value="2"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Background" Value="{DynamicResource Brush.Btn.Gradient}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <!-- [2026-03-12] 外層：1px 底部深色陰影（實體按鍵感） -->
                            <Grid>
                                <Border CornerRadius="4" Background="{DynamicResource Brush.Btn.Shadow}" Margin="0,1,0,-1"/>
                                <Border x:Name="bd" CornerRadius="4"
                                        BorderThickness="1" BorderBrush="{DynamicResource Brush.Btn.Border}"
                                        Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}">
                                    <Grid>
                                        <Border x:Name="overlay" CornerRadius="3" Background="Transparent"/>
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.Hover.Border}"/>
                                    <Setter TargetName="overlay" Property="Background" Value="#20FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.Pressed.Border}"/>
                                    <Setter TargetName="overlay" Property="Background" Value="#30000000"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- [2026-03-12] BaseRadioBtnStyle：漸層/選取色全部引用主題資源 -->
            <Style x:Key="BaseRadioBtnStyle" TargetType="RadioButton">
                <Setter Property="FontFamily" Value="{DynamicResource FontFamily.Default}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
                <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Padding" Value="{DynamicResource BtnPadding.Medium}"/>
                <Setter Property="Margin" Value="2,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="bd" CornerRadius="4"
                                    BorderThickness="1" BorderBrush="{DynamicResource Brush.Btn.Border}"
                                    Background="{DynamicResource Brush.Btn.Gradient}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.Hover.Border}"/>
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Btn.HoverGradient}"/>
                                </Trigger>
                                <!-- [2026-03-12] IsChecked Foreground 改用主題資源（Cyber 亮底需深色文字） -->
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.Tab.SelectedBorder}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Tab.SelectedForeground}"/>
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Tab.Selected}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Hint}"/>
                                    <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- [2026-03-12] NavBtnStyle：漸層/選取色引用主題資源 -->
            <Style x:Key="NavBtnStyle" TargetType="RadioButton">
                <Setter Property="FontFamily" Value="{DynamicResource FontFamily.Default}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
                <Setter Property="FontSize" Value="{DynamicResource FontSize.Large}"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Height" Value="50"/>
                <Setter Property="Margin" Value="1,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="bd" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                    Background="{DynamicResource Brush.Btn.Gradient}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Btn.HoverGradient}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Tab.Selected}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- [2026-03-11] PanelTitleBorder：大區塊標題外框（統一深藍背景） -->
            <Style x:Key="PanelTitleBorder" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource Brush.PanelTitle.Background}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.PanelTitle.Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="3"/>
                <Setter Property="Padding" Value="8,5"/>
            </Style>

            <!-- [2026-03-11] PanelTitleText：大區塊標題文字 -->
            <Style x:Key="PanelTitleText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontSize" Value="{DynamicResource FontSize.Medium}"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
            </Style>

            <!-- [2026-03-11] GroupHeaderText：群組標題文字（#5E70FF 藍紫） -->
            <Style x:Key="GroupHeaderText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource Brush.GroupHeader.Foreground}"/>
                <Setter Property="FontSize" Value="{DynamicResource FontSize.Medium}"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>