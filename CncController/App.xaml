    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Themes/Theme.Dark.xaml"/>
                <ResourceDictionary Source="Resources/Languages/Lang.zh-TW.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- [2026-02-24] 全域 BoolToVis 轉換器，供所有 UserControl 使用 -->
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <!-- ================================================================ -->
            <!-- [2026-03-04] BaseBtnStyle：全域按鈕基底樣式                       -->
            <!--   漸層凸起 + Hover 變亮 + Pressed 凹入 + Cursor=Hand             -->
            <!--   尺寸預設 Medium，各頁面可用行內或 DynamicResource 覆寫           -->
            <!-- ================================================================ -->
            <Style x:Key="BaseBtnStyle" TargetType="Button">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontSize" Value="{DynamicResource BtnFontSize.Medium}"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Padding" Value="{DynamicResource BtnPadding.Medium}"/>
                <Setter Property="Margin" Value="2"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" CornerRadius="4"
                                    BorderThickness="1.5" BorderBrush="#666"
                                    Padding="{TemplateBinding Padding}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#5E5E5E" Offset="0"/>
                                        <GradientStop Color="#4A4A4A" Offset="0.5"/>
                                        <GradientStop Color="#353535" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="#0090FF"/>
                                    <Setter TargetName="bd" Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#727272" Offset="0"/>
                                                <GradientStop Color="#5E5E5E" Offset="0.5"/>
                                                <GradientStop Color="#484848" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="#40B0FF"/>
                                    <Setter TargetName="bd" Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#2A2A2A" Offset="0"/>
                                                <GradientStop Color="#383838" Offset="0.5"/>
                                                <GradientStop Color="#4A4A4A" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- [2026-03-04] BaseRadioBtnStyle：全域 RadioButton 基底（Tab / WCS 選擇） -->
            <Style x:Key="BaseRadioBtnStyle" TargetType="RadioButton">
                <Setter Property="Foreground" Value="#CCC"/>
                <Setter Property="FontSize" Value="{DynamicResource BtnFontSize.Medium}"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Padding" Value="{DynamicResource BtnPadding.Medium}"/>
                <Setter Property="Margin" Value="2,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="bd" CornerRadius="4"
                                    BorderThickness="1.5" BorderBrush="#555"
                                    Padding="{TemplateBinding Padding}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#5E5E5E" Offset="0"/>
                                        <GradientStop Color="#4A4A4A" Offset="0.5"/>
                                        <GradientStop Color="#353535" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="#0090FF"/>
                                    <Setter TargetName="bd" Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#727272" Offset="0"/>
                                                <GradientStop Color="#5E5E5E" Offset="0.5"/>
                                                <GradientStop Color="#484848" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="#40A0F0"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter TargetName="bd" Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#2090E8" Offset="0"/>
                                                <GradientStop Color="#0078D4" Offset="0.5"/>
                                                <GradientStop Color="#005FA3" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="#666"/>
                                    <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- [2026-03-04] NavBtnStyle：底部導航（漸層版） -->
            <Style x:Key="NavBtnStyle" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Height" Value="50"/>
                <Setter Property="Margin" Value="1,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="bd" BorderBrush="#444" BorderThickness="1">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#4A4A4A" Offset="0"/>
                                        <GradientStop Color="#3A3A3A" Offset="0.5"/>
                                        <GradientStop Color="#2A2A2A" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#5E5E5E" Offset="0"/>
                                                <GradientStop Color="#4E4E4E" Offset="0.5"/>
                                                <GradientStop Color="#3E3E3E" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="bd" Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#7A8AFF" Offset="0"/>
                                                <GradientStop Color="#5E70FF" Offset="0.5"/>
                                                <GradientStop Color="#4A5CE0" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>