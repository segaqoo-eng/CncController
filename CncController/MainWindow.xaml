<Window x:Class="CncController.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CncController.ViewModels"
        xmlns:pages="clr-namespace:CncController.Views.Pages"
        xmlns:layouts="clr-namespace:CncController.Views.Layouts"
        xmlns:views="clr-namespace:CncController.Views"
        Title="CncController" Height="1080" Width="1920"
        WindowStyle="None" WindowState="Maximized"
        Background="{DynamicResource Brush.WindowBackground}"
        FontFamily="{DynamicResource FontFamily.Default}">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <!-- [2026-03-06] 快捷鍵：ESC=全機停止 F1=電源 F2=急停 -->
    <Window.InputBindings>
        <KeyBinding Key="Esc" Command="{Binding EmergencyAbortCommand}"/>

        <KeyBinding Key="F1" Command="{Binding TogglePowerCommand}"/>
        <KeyBinding Key="F2" Command="{Binding ToggleEstopCommand}"/>
    </Window.InputBindings>
    <Window.Resources>
        <!-- [2026-02-24] BoolToVis 已移至 App.xaml 全域資源 -->
        <DataTemplate DataType="{x:Type vm:MonitorViewModel}">
            <pages:MonitorView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <pages:SettingsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
            <pages:HistoryView/>
        </DataTemplate>
        <!-- [2026-02-23] 新增 OffsetsViewModel DataTemplate，導航至 OffsetsView -->
        <DataTemplate DataType="{x:Type vm:OffsetsViewModel}">
            <pages:OffsetsView/>
        </DataTemplate>
        <!-- [2026-03-03] 新增 ToolTableViewModel DataTemplate，導航至 ToolTableView -->
        <DataTemplate DataType="{x:Type vm:ToolTableViewModel}">
            <pages:ToolTableView/>
        </DataTemplate>
        <!-- [2026-03-03] 新增 AtcViewModel DataTemplate，導航至 AtcView -->
        <DataTemplate DataType="{x:Type vm:AtcViewModel}">
            <pages:AtcView/>
        </DataTemplate>
        <!-- [2026-03-04] 新增 ProbingViewModel DataTemplate，導航至 ProbingView -->
        <DataTemplate DataType="{x:Type vm:ProbingViewModel}">
            <pages:ProbingView/>
        </DataTemplate>
    </Window.Resources>

    <Viewbox Stretch="Uniform">
        <!-- [2026-03-04] UI 全域縮放：設計尺寸 = 1920/1080 ÷ UiScale，Viewbox 自動等比縮放 -->
        <Grid Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="340"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <!-- [2026-03-03] JogPanel 寬度修正：180→250，避免 X+/X- 按鈕被裁切 -->
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>

            <!-- [2026-03-04] 紅色警告列：加入 RE-SCAN 按鈕 -->
            <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#D80000" Padding="5">
                <!-- [2026-03-04] 啟動階段隱藏紅色列：需 IsSystemReady=False 且 IsStartingUp=False 才顯示 -->
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsSystemReady}" Value="False"/>
                                    <Condition Binding="{Binding IsStartingUp}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="RE-SCAN" Margin="10,0,0,0"
                            Command="{Binding RescanHardwareCommand}"
                            Background="#FF8C00" Foreground="White" FontWeight="Bold"
                            Padding="15,3" FontSize="{DynamicResource FontSize.Medium}" VerticalAlignment="Center" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    <TextBlock Text="{Binding SystemStatus}" Foreground="White" FontWeight="Bold"
                               HorizontalAlignment="Center" FontSize="{DynamicResource FontSize.XLarge}" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <layouts:HeaderBar Grid.Row="1" Grid.ColumnSpan="2"/>

            <!-- [2026-03-06] 使用 CachedContentControl 快取 View，避免每次切換都重建 XAML 樹 -->
            <views:CachedContentControl Grid.Row="2" Grid.Column="0" Content="{Binding CurrentViewModel}"/>
            <layouts:JogPanel Grid.Row="2" Grid.Column="1"/>

            <UniformGrid Grid.Row="3" Grid.ColumnSpan="2" Rows="1" Background="{DynamicResource Brush.PanelBackground}">
                <RadioButton Content="MAIN" Style="{StaticResource NavBtnStyle}" IsChecked="True"
                             Command="{Binding NavigateCommand}" CommandParameter="Main"/>
                <RadioButton Content="FILE" Style="{StaticResource NavBtnStyle}"/>
                <!-- [2026-03-03] 新增 ATC Tab 導航按鈕 -->
                <RadioButton Content="ATC" Style="{StaticResource NavBtnStyle}"
                             Command="{Binding NavigateCommand}" CommandParameter="Atc"/>
                <!-- [2026-03-04] 新增 PROBING Tab 導航按鈕 -->
                <RadioButton Content="PROBING" Style="{StaticResource NavBtnStyle}"
                             Command="{Binding NavigateCommand}" CommandParameter="Probing"/>
                <!-- [2026-03-03] TOOL：綁定導航至 ToolTableView -->
                <RadioButton Content="TOOL" Style="{StaticResource NavBtnStyle}"
                             Command="{Binding NavigateCommand}" CommandParameter="Tool"/>
                <!-- [2026-02-23] 新增 OFFSETS Tab 導航按鈕 -->
                <RadioButton Content="OFFSETS" Style="{StaticResource NavBtnStyle}"
                             Command="{Binding NavigateCommand}" CommandParameter="Offsets"/>
                <RadioButton Content="HISTORY" Style="{StaticResource NavBtnStyle}"
                             Command="{Binding NavigateCommand}" CommandParameter="History"/>
                <RadioButton Content="SETTINGS" Style="{StaticResource NavBtnStyle}"
                         Command="{Binding NavigateCommand}" CommandParameter="Settings"
                         Visibility="Visible"/>
            </UniformGrid>

            <layouts:DashboardPanel Grid.Row="4" Grid.ColumnSpan="2"/>
        </Grid>
    </Viewbox>
</Window>