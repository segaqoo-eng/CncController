<!-- [2026-03-12] 主題 3：Cyber-Industrial（螢光青 + 螢光黃綠 + 極深灰） -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <FontFamily x:Key="FontFamily.Default">Microsoft JhengHei UI</FontFamily>
    <FontFamily x:Key="FontFamily.Mono">Consolas</FontFamily>

    <sys:Double x:Key="FontSize.XSmall">9</sys:Double>
    <sys:Double x:Key="FontSize.Small">10</sys:Double>
    <sys:Double x:Key="FontSize.Body">12</sys:Double>
    <sys:Double x:Key="FontSize.Medium">14</sys:Double>
    <sys:Double x:Key="FontSize.Large">16</sys:Double>
    <sys:Double x:Key="FontSize.XLarge">18</sys:Double>
    <sys:Double x:Key="FontSize.DRO">24</sys:Double>

    <sys:Double x:Key="FontSize.Header">12</sys:Double>
    <sys:Double x:Key="FontSize.Normal">14</sys:Double>
    <sys:Double x:Key="BtnFontSize.Large">16</sys:Double>
    <sys:Double x:Key="BtnFontSize.Medium">14</sys:Double>
    <sys:Double x:Key="BtnFontSize.Small">12</sys:Double>
    <sys:Double x:Key="BtnFontSize.XSmall">10</sys:Double>

    <Thickness x:Key="BtnPadding.Large">14,8</Thickness>
    <Thickness x:Key="BtnPadding.Medium">10,6</Thickness>
    <Thickness x:Key="BtnPadding.Small">8,4</Thickness>
    <Thickness x:Key="BtnPadding.XSmall">6,3</Thickness>

    <!-- ================================================================ -->
    <!-- 色彩系統 — Cyber-Industrial（未來工廠感）                         -->
    <!-- ================================================================ -->

    <!-- === 背景層次（極深灰，降低光污染） === -->
    <SolidColorBrush x:Key="Brush.WindowBackground" Color="#121212"/>
    <SolidColorBrush x:Key="Brush.PanelBackground" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="Brush.Panel.Secondary" Color="#161616"/>
    <SolidColorBrush x:Key="Brush.Panel.Overlay" Color="#DD1E1E1E"/>
    <SolidColorBrush x:Key="Brush.Border" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="Brush.Separator" Color="#2A2A2A"/>

    <!-- === 按鈕 === -->
    <SolidColorBrush x:Key="Brush.Button.Static" Color="#222222"/>
    <SolidColorBrush x:Key="Brush.Button.Active" Color="#00F5D4"/>
    <SolidColorBrush x:Key="Brush.Button.Danger" Color="#FF3B30"/>

    <!-- === 警告/錯誤 === -->
    <SolidColorBrush x:Key="Brush.Alert.Warning" Color="#FFD60A"/>
    <SolidColorBrush x:Key="Brush.Alert.Fatal" Color="#FF3B30"/>
    <SolidColorBrush x:Key="Brush.Alert.Banner" Color="#CC2020"/>

    <!-- === 文字 === -->
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#C0C0C0"/>
    <SolidColorBrush x:Key="Brush.Text.Muted" Color="#8E8E93"/>
    <SolidColorBrush x:Key="Brush.Text.Dim" Color="#666666"/>
    <SolidColorBrush x:Key="Brush.Text.Hint" Color="#444444"/>

    <!-- === DRO：極深底 + 螢光黃綠（極高辨識度） === -->
    <SolidColorBrush x:Key="Brush.DRO.Background" Color="#0D0D0D"/>
    <SolidColorBrush x:Key="Brush.DRO.Foreground" Color="#CCFF00"/>
    <SolidColorBrush x:Key="Brush.DRO.Border" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="Brush.DRO.Label" Color="#8E8E93"/>

    <!-- === 輸入框 === -->
    <SolidColorBrush x:Key="Brush.Input.Background" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="Brush.Input.Foreground" Color="#CCFF00"/>
    <SolidColorBrush x:Key="Brush.Input.Border" Color="#333333"/>
    <SolidColorBrush x:Key="Brush.Input.Placeholder" Color="#555555"/>

    <!-- === DataGrid === -->
    <SolidColorBrush x:Key="Brush.Grid.Background" Color="#121212"/>
    <SolidColorBrush x:Key="Brush.Grid.Row" Color="#161616"/>
    <SolidColorBrush x:Key="Brush.Grid.RowAlt" Color="#121212"/>
    <SolidColorBrush x:Key="Brush.Grid.Header" Color="#1E1E1E"/>
    <!-- [2026-03-12] DataGrid 格線 -->
    <SolidColorBrush x:Key="Brush.Grid.Line" Color="#2A2A2A"/>

    <!-- [2026-03-12] Offsets 座標區塊色彩（Cyber：螢光色系） -->
    <SolidColorBrush x:Key="Brush.Offset.Work.Background" Color="#0D1A0D"/>
    <SolidColorBrush x:Key="Brush.Offset.Work.Foreground" Color="#00FF41"/>
    <SolidColorBrush x:Key="Brush.Offset.Machine.Background" Color="#0D0D1A"/>
    <SolidColorBrush x:Key="Brush.Offset.Machine.Foreground" Color="#00F5D4"/>
    <SolidColorBrush x:Key="Brush.Offset.Value.Background" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="Brush.Offset.Value.Foreground" Color="#8E8E93"/>
    <SolidColorBrush x:Key="Brush.Offset.G92.Background" Color="#1A1A0D"/>
    <SolidColorBrush x:Key="Brush.Offset.G92.Foreground" Color="#CCFF00"/>
    <SolidColorBrush x:Key="Brush.Offset.Tool.Background" Color="#1A0D1A"/>
    <SolidColorBrush x:Key="Brush.Offset.Tool.Foreground" Color="#FF88FF"/>

    <!-- === G-Code 顯示（極深底 + 螢光色文字） === -->
    <SolidColorBrush x:Key="Brush.Code.Background" Color="#0D0D0D"/>
    <SolidColorBrush x:Key="Brush.Code.Foreground" Color="#B0CC80"/>
    <SolidColorBrush x:Key="Brush.Code.LineNum" Color="#555555"/>
    <SolidColorBrush x:Key="Brush.Code.LineNumBg" Color="#111111"/>

    <!-- === 強調色 / 動作觸發色：螢光青 #00F5D4 === -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#00F5D4"/>
    <SolidColorBrush x:Key="Brush.Checked" Color="#00F5D4"/>
    <SolidColorBrush x:Key="Brush.Hover.Border" Color="#33FFE0"/>
    <SolidColorBrush x:Key="Brush.Pressed.Border" Color="#66FFE8"/>
    <SolidColorBrush x:Key="Brush.StatusOn" Color="#00F5D4"/>
    <SolidColorBrush x:Key="Brush.StatusOn.Border" Color="#00B89E"/>

    <!-- === Encoder / 即時值顯示 === -->
    <SolidColorBrush x:Key="Brush.Encoder.Spindle" Color="#00F5D4"/>
    <SolidColorBrush x:Key="Brush.Encoder.Carousel" Color="#CCFF00"/>
    <SolidColorBrush x:Key="Brush.Encoder.Background" Color="#161616"/>

    <!-- === 使用者頭像 === -->
    <SolidColorBrush x:Key="Brush.Avatar" Color="#00F5D4"/>

    <!-- === 分頁選取：螢光青漸層 + 深色文字（對比度修正） === -->
    <LinearGradientBrush x:Key="Brush.Tab.Selected" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00D4B8" Offset="0"/>
        <GradientStop Color="#00B39C" Offset="0.5"/>
        <GradientStop Color="#009980" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.Tab.SelectedBorder" Color="#00F5D4"/>
    <!-- Cyber 螢光底色 → 深色文字（WCAG 對比度） -->
    <SolidColorBrush x:Key="Brush.Tab.SelectedForeground" Color="#0A0A0A"/>

    <!-- === 按鈕漸層：極暗灰 === -->
    <LinearGradientBrush x:Key="Brush.Btn.Gradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#3A3A3A" Offset="0"/>
        <GradientStop Color="#2A2A2A" Offset="0.5"/>
        <GradientStop Color="#1A1A1A" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.Btn.HoverGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#4A4A4A" Offset="0"/>
        <GradientStop Color="#3A3A3A" Offset="0.5"/>
        <GradientStop Color="#2A2A2A" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.Btn.Border" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="Brush.Btn.Shadow" Color="#000000"/>

    <!-- === 區塊標題：科技深藍 === -->
    <SolidColorBrush x:Key="Brush.PanelTitle.Background" Color="#0D1B2A"/>
    <SolidColorBrush x:Key="Brush.PanelTitle.Border" Color="#1B3A5C"/>
    <SolidColorBrush x:Key="Brush.GroupHeader.Foreground" Color="#00F5D4"/>

    <!-- === 3D 視圖 === -->
    <SolidColorBrush x:Key="Brush.Viewport.Background" Color="#0A0A0A"/>
    <SolidColorBrush x:Key="Brush.Viewport.Grid" Color="#1A1A1A"/>

    <!-- === MenuItem 下拉 === -->
    <SolidColorBrush x:Key="Brush.Menu.Foreground" Color="#333333"/>

</ResourceDictionary>
