<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ================================================================ -->
    <!-- [2026-03-09] 統一 FontFamily                                     -->
    <!-- ================================================================ -->
    <FontFamily x:Key="FontFamily.Default">Microsoft JhengHei UI</FontFamily>
    <FontFamily x:Key="FontFamily.Mono">Consolas</FontFamily>

    <!-- ================================================================ -->
    <!-- [2026-03-09] 統一 FontSize（全域 7 級）                           -->
    <!--   各頁面可在 UserControl.Resources 中覆蓋（DynamicResource 就近取值） -->
    <!-- ================================================================ -->
    <sys:Double x:Key="FontSize.XSmall">9</sys:Double>
    <sys:Double x:Key="FontSize.Small">10</sys:Double>
    <sys:Double x:Key="FontSize.Body">12</sys:Double>
    <sys:Double x:Key="FontSize.Medium">14</sys:Double>
    <sys:Double x:Key="FontSize.Large">16</sys:Double>
    <sys:Double x:Key="FontSize.XLarge">18</sys:Double>
    <sys:Double x:Key="FontSize.DRO">24</sys:Double>

    <!-- 向後相容別名（舊引用暫時保留，逐步移除） -->
    <sys:Double x:Key="FontSize.Header">12</sys:Double>
    <sys:Double x:Key="FontSize.Normal">14</sys:Double>
    <sys:Double x:Key="BtnFontSize.Large">16</sys:Double>
    <sys:Double x:Key="BtnFontSize.Medium">14</sys:Double>
    <sys:Double x:Key="BtnFontSize.Small">12</sys:Double>
    <sys:Double x:Key="BtnFontSize.XSmall">10</sys:Double>

    <!-- ================================================================ -->
    <!-- 按鈕 Padding                                                     -->
    <!-- ================================================================ -->
    <Thickness x:Key="BtnPadding.Large">14,8</Thickness>
    <Thickness x:Key="BtnPadding.Medium">10,6</Thickness>
    <Thickness x:Key="BtnPadding.Small">8,4</Thickness>
    <Thickness x:Key="BtnPadding.XSmall">6,3</Thickness>

    <!-- ================================================================ -->
    <!-- 色彩系統                                                         -->
    <!-- ================================================================ -->
    <SolidColorBrush x:Key="Brush.WindowBackground" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="Brush.PanelBackground" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="Brush.Border" Color="#444444"/>

    <SolidColorBrush x:Key="Brush.Button.Static" Color="#333333"/>
    <SolidColorBrush x:Key="Brush.Button.Active" Color="#5E70FF"/>
    <SolidColorBrush x:Key="Brush.Button.Danger" Color="#CC0000"/>
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="White"/>
    <SolidColorBrush x:Key="Brush.Text.Muted" Color="#AAAAAA"/>

    <SolidColorBrush x:Key="Brush.DRO.Background" Color="White"/>
    <SolidColorBrush x:Key="Brush.DRO.Foreground" Color="Black"/>
    <SolidColorBrush x:Key="Brush.DRO.Label" Color="#333333"/>

    <!-- [2026-03-09] 統一互動色 -->
    <SolidColorBrush x:Key="Brush.Checked" Color="#007ACC"/>
    <SolidColorBrush x:Key="Brush.Hover.Border" Color="#0090FF"/>
    <SolidColorBrush x:Key="Brush.Pressed.Border" Color="#40B0FF"/>

    <!-- [2026-03-11] PanelTitle 區塊標題統一色 -->
    <SolidColorBrush x:Key="Brush.PanelTitle.Background" Color="#1A5276"/>
    <SolidColorBrush x:Key="Brush.PanelTitle.Border" Color="#2980B9"/>

    <!-- [2026-03-11] GroupHeader 群組標題統一色 -->
    <SolidColorBrush x:Key="Brush.GroupHeader.Foreground" Color="#5E70FF"/>

</ResourceDictionary>
