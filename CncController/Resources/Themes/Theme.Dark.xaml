<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <SolidColorBrush x:Key="Brush.WindowBackground" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="Brush.PanelBackground" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="Brush.Border" Color="#444444"/>

    <SolidColorBrush x:Key="Brush.Button.Static" Color="#333333"/>
    <SolidColorBrush x:Key="Brush.Button.Active" Color="#5E70FF"/>
    <SolidColorBrush x:Key="Brush.Button.Danger" Color="#CC0000"/>
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="White"/>
    <SolidColorBrush x:Key="Brush.Text.Muted" Color="#AAAAAA"/>

    <SolidColorBrush x:Key="Brush.DRO.Background" Color="White"/>
    <SolidColorBrush x:Key="Brush.DRO.Foreground" Color="Black"/>
    <SolidColorBrush x:Key="Brush.DRO.Label" Color="#333333"/>
    <sys:Double x:Key="FontSize.Header">12</sys:Double>
    <sys:Double x:Key="FontSize.Normal">14</sys:Double>
    <sys:Double x:Key="FontSize.Large">18</sys:Double>
    <sys:Double x:Key="FontSize.DRO">24</sys:Double>

    <!-- [2026-03-04] 按鈕尺寸預設（方案 B：全域變數，各頁面引用） -->
    <sys:Double x:Key="BtnFontSize.Large">16</sys:Double>
    <sys:Double x:Key="BtnFontSize.Medium">14</sys:Double>
    <sys:Double x:Key="BtnFontSize.Small">12</sys:Double>
    <sys:Double x:Key="BtnFontSize.XSmall">10</sys:Double>
    <Thickness x:Key="BtnPadding.Large">14,8</Thickness>
    <Thickness x:Key="BtnPadding.Medium">10,6</Thickness>
    <Thickness x:Key="BtnPadding.Small">8,4</Thickness>
    <Thickness x:Key="BtnPadding.XSmall">6,3</Thickness>
</ResourceDictionary>