<!-- [2026-03-12] 主題 2：Industrial（湖水綠 + 真空管 DRO + 儀表板感） -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <FontFamily x:Key="FontFamily.Default">Microsoft JhengHei UI</FontFamily>
    <FontFamily x:Key="FontFamily.Mono">Consolas</FontFamily>

    <sys:Double x:Key="FontSize.XSmall">9</sys:Double>
    <sys:Double x:Key="FontSize.Small">10</sys:Double>
    <sys:Double x:Key="FontSize.Body">12</sys:Double>
    <sys:Double x:Key="FontSize.Medium">14</sys:Double>
    <sys:Double x:Key="FontSize.Large">16</sys:Double>
    <sys:Double x:Key="FontSize.XLarge">18</sys:Double>
    <sys:Double x:Key="FontSize.DRO">24</sys:Double>

    <sys:Double x:Key="FontSize.Header">12</sys:Double>
    <sys:Double x:Key="FontSize.Normal">14</sys:Double>
    <sys:Double x:Key="BtnFontSize.Large">16</sys:Double>
    <sys:Double x:Key="BtnFontSize.Medium">14</sys:Double>
    <sys:Double x:Key="BtnFontSize.Small">12</sys:Double>
    <sys:Double x:Key="BtnFontSize.XSmall">10</sys:Double>

    <Thickness x:Key="BtnPadding.Large">14,8</Thickness>
    <Thickness x:Key="BtnPadding.Medium">10,6</Thickness>
    <Thickness x:Key="BtnPadding.Small">8,4</Thickness>
    <Thickness x:Key="BtnPadding.XSmall">6,3</Thickness>

    <!-- ================================================================ -->
    <!-- 色彩系統 — 湖水綠 + 真空管 DRO + 細邊框儀表板                    -->
    <!-- ================================================================ -->

    <!-- === 背景層次（稍暗，拉開與 Default 的差距） === -->
    <SolidColorBrush x:Key="Brush.WindowBackground" Color="#161616"/>
    <SolidColorBrush x:Key="Brush.PanelBackground" Color="#222222"/>
    <SolidColorBrush x:Key="Brush.Panel.Secondary" Color="#1C1C1C"/>
    <SolidColorBrush x:Key="Brush.Panel.Overlay" Color="#DD282828"/>
    <SolidColorBrush x:Key="Brush.Border" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="Brush.Separator" Color="#333333"/>

    <!-- === 按鈕 === -->
    <SolidColorBrush x:Key="Brush.Button.Static" Color="#2E2E2E"/>
    <SolidColorBrush x:Key="Brush.Button.Active" Color="#00A896"/>
    <SolidColorBrush x:Key="Brush.Button.Danger" Color="#FF0000"/>

    <!-- === 警告/錯誤 === -->
    <SolidColorBrush x:Key="Brush.Alert.Warning" Color="#FFB000"/>
    <SolidColorBrush x:Key="Brush.Alert.Fatal" Color="#FF0000"/>
    <SolidColorBrush x:Key="Brush.Alert.Banner" Color="#CC0000"/>

    <!-- === 文字 === -->
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="White"/>
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#CCCCCC"/>
    <SolidColorBrush x:Key="Brush.Text.Muted" Color="#AAAAAA"/>
    <SolidColorBrush x:Key="Brush.Text.Dim" Color="#777777"/>
    <SolidColorBrush x:Key="Brush.Text.Hint" Color="#555555"/>

    <!-- === 真空管 DRO：深藍黑底 + 螢光綠字 === -->
    <SolidColorBrush x:Key="Brush.DRO.Background" Color="#0A1628"/>
    <SolidColorBrush x:Key="Brush.DRO.Foreground" Color="#00FF41"/>
    <SolidColorBrush x:Key="Brush.DRO.Border" Color="#1A3050"/>
    <SolidColorBrush x:Key="Brush.DRO.Label" Color="#6A8A6A"/>

    <!-- === 輸入框 === -->
    <SolidColorBrush x:Key="Brush.Input.Background" Color="#1A2030"/>
    <SolidColorBrush x:Key="Brush.Input.Foreground" Color="#00DD38"/>
    <SolidColorBrush x:Key="Brush.Input.Border" Color="#2A4060"/>
    <SolidColorBrush x:Key="Brush.Input.Placeholder" Color="#557755"/>

    <!-- === DataGrid === -->
    <SolidColorBrush x:Key="Brush.Grid.Background" Color="#161616"/>
    <SolidColorBrush x:Key="Brush.Grid.Row" Color="#1C1C1C"/>
    <SolidColorBrush x:Key="Brush.Grid.RowAlt" Color="#161616"/>
    <SolidColorBrush x:Key="Brush.Grid.Header" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="Brush.Grid.Line" Color="#333333"/>

    <!-- [2026-03-12] Offset 座標顯示色（WC/MC/Offset/G92/Tool） -->
    <SolidColorBrush x:Key="Brush.Offset.Work.Background" Color="#1A2E1A"/>
    <SolidColorBrush x:Key="Brush.Offset.Work.Foreground" Color="#90EE90"/>
    <SolidColorBrush x:Key="Brush.Offset.Machine.Background" Color="#1A1A2E"/>
    <SolidColorBrush x:Key="Brush.Offset.Machine.Foreground" Color="#00BFFF"/>
    <SolidColorBrush x:Key="Brush.Offset.Value.Background" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="Brush.Offset.Value.Foreground" Color="#AAAAAA"/>
    <SolidColorBrush x:Key="Brush.Offset.G92.Background" Color="#2A2A22"/>
    <SolidColorBrush x:Key="Brush.Offset.G92.Foreground" Color="#CCCC88"/>
    <SolidColorBrush x:Key="Brush.Offset.Tool.Background" Color="#2A222A"/>
    <SolidColorBrush x:Key="Brush.Offset.Tool.Foreground" Color="#CC88CC"/>

    <!-- === G-Code 顯示（深底 + 亮文字） === -->
    <SolidColorBrush x:Key="Brush.Code.Background" Color="#0A1220"/>
    <SolidColorBrush x:Key="Brush.Code.Foreground" Color="#C0D0C0"/>
    <SolidColorBrush x:Key="Brush.Code.LineNum" Color="#557755"/>
    <SolidColorBrush x:Key="Brush.Code.LineNumBg" Color="#0D1828"/>

    <!-- === 強調色 / 動作觸發色：湖水綠 #00A896 === -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#00A896"/>
    <SolidColorBrush x:Key="Brush.Checked" Color="#00A896"/>
    <SolidColorBrush x:Key="Brush.Hover.Border" Color="#00C8AA"/>
    <SolidColorBrush x:Key="Brush.Pressed.Border" Color="#00E0BE"/>
    <SolidColorBrush x:Key="Brush.StatusOn" Color="#00A896"/>
    <SolidColorBrush x:Key="Brush.StatusOn.Border" Color="#008070"/>

    <!-- === Encoder / 即時值顯示 === -->
    <SolidColorBrush x:Key="Brush.Encoder.Spindle" Color="#00DD38"/>
    <SolidColorBrush x:Key="Brush.Encoder.Carousel" Color="#88CC44"/>
    <SolidColorBrush x:Key="Brush.Encoder.Background" Color="#0D1828"/>

    <!-- === 使用者頭像 === -->
    <SolidColorBrush x:Key="Brush.Avatar" Color="#00A896"/>

    <!-- [2026-03-13] 分頁選取：藍紫色（與狀態按鈕青綠區分） -->
    <LinearGradientBrush x:Key="Brush.Tab.Selected" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#7A8AFF" Offset="0"/>
        <GradientStop Color="#5E70FF" Offset="0.5"/>
        <GradientStop Color="#4A5CE0" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.Tab.SelectedBorder" Color="#7A8AFF"/>
    <SolidColorBrush x:Key="Brush.Tab.SelectedForeground" Color="White"/>

    <!-- === 按鈕漸層（帶微量青綠色調，與 Default 明顯區隔） === -->
    <LinearGradientBrush x:Key="Brush.Btn.Gradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#4A5250" Offset="0"/>
        <GradientStop Color="#383E3D" Offset="0.5"/>
        <GradientStop Color="#262C2B" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.Btn.HoverGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#5E6664" Offset="0"/>
        <GradientStop Color="#4C5453" Offset="0.5"/>
        <GradientStop Color="#3A4241" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.Btn.Border" Color="#4A5555"/>
    <SolidColorBrush x:Key="Brush.Btn.Shadow" Color="#080808"/>

    <!-- === 區塊標題 === -->
    <SolidColorBrush x:Key="Brush.PanelTitle.Background" Color="#0D2E3E"/>
    <SolidColorBrush x:Key="Brush.PanelTitle.Border" Color="#1A5E6E"/>
    <SolidColorBrush x:Key="Brush.GroupHeader.Foreground" Color="#00A896"/>

    <!-- === 3D 視圖 === -->
    <SolidColorBrush x:Key="Brush.Viewport.Background" Color="#060D18"/>
    <SolidColorBrush x:Key="Brush.Viewport.Grid" Color="#1A3030"/>

    <!-- === MenuItem 下拉 === -->
    <SolidColorBrush x:Key="Brush.Menu.Foreground" Color="#333333"/>

</ResourceDictionary>
