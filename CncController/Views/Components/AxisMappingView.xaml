<UserControl x:Class="CncController.Views.Components.AxisMappingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="800"
             FontFamily="{DynamicResource FontFamily.Default}">

    <Grid Background="{DynamicResource Brush.Grid.Background}">
        <DataGrid ItemsSource="{Binding AxisMaps}" 
                  AutoGenerateColumns="False"
                  HeadersVisibility="Column"
                  Background="Transparent"
                  RowBackground="{DynamicResource Brush.Grid.Row}"
                  AlternatingRowBackground="{DynamicResource Brush.Grid.RowAlt}"
                  Foreground="{DynamicResource Brush.Text.Primary}"
                  RowHeight="40"
                  BorderThickness="0"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{DynamicResource Brush.Input.Background}"
                  CanUserAddRows="False">

            <DataGrid.Resources>
                <!-- [2026-03-12] 替換硬編碼色 #444444 → DynamicResource Brush.Border -->
                <StaticResource x:Key="{x:Static SystemColors.HighlightBrushKey}" ResourceKey="Brush.Border"/>
                <StaticResource x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" ResourceKey="Brush.Border"/>

                <Style TargetType="DataGridColumnHeader">
                    <!-- [2026-03-12] 替換硬編碼色 #333333 → DynamicResource -->
                    <Setter Property="Background" Value="{DynamicResource Brush.Grid.Header}"/>
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/> <!-- [2026-03-12] 替換硬編碼色 -->
                    <Setter Property="Padding" Value="10,8"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>  
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Btn.Border}"/> <!-- [2026-03-12] 替換硬編碼色 #555 -->
                    <Setter Property="FontWeight" Value="Bold"/>
                </Style>

                <Style TargetType="ComboBox">
                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                </Style>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Logic Axis" Binding="{Binding AxisName}" Width="150" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="10,0"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/> <!-- [2026-03-12] 替換硬編碼色 #007ACC -->
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTemplateColumn Header="Physical Device (EtherCAT Slave)" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding DataContext.AvailableSlaves, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      DisplayMemberPath="DisplayName"
                                      SelectedItem="{Binding SelectedSlave, UpdateSourceTrigger=PropertyChanged}"
                                      Margin="2"
                                      Background="{DynamicResource Brush.Input.Background}" Foreground="{DynamicResource Brush.Menu.Foreground}" BorderThickness="0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Vendor ID" Binding="{Binding SelectedSlave.VendorId}" Width="150" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>