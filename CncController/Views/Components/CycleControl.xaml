<UserControl x:Class="CncController.Views.Components.CycleControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CncController.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             d:DesignHeight="350" d:DesignWidth="350"
             FontFamily="{DynamicResource FontFamily.Default}">

    <UserControl.Resources>
        <!-- [2026-03-04] CycleBtnStyle 改繼承 BaseBtnStyle，移除本地 Template -->
        <!-- [2026-03-11] 還原字體層級 Large→Body（base 已全域加大） -->
        <Style x:Key="CycleBtnStyle" TargetType="Button" BasedOn="{StaticResource BaseBtnStyle}">
            <Setter Property="Height" Value="45"/>
            <Setter Property="Margin" Value="2,3"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Large}"/>
            <Setter Property="Padding" Value="{DynamicResource BtnPadding.Small}"/>
        </Style>

        <Style x:Key="FunctionBtnStyle" TargetType="Button" BasedOn="{StaticResource CycleBtnStyle}"/>

        <!-- [2026-03-10] StartBtnStyle/StopBtnStyle/HoldBtnStyle 已移除，改為按鈕行內 DataTrigger 動態變色 -->
    </UserControl.Resources>

    <Border Background="{DynamicResource Brush.Panel.Secondary}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="0" Padding="5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>

            <UniformGrid Grid.Row="0" Columns="2" Rows="5">
                <!-- [2026-03-04] 關鍵操作色彩分層：綠=啟動、紅=停止、橙=暫停 -->
                <!-- KEEP: status — CYCLE START 綠色(RUNNING) -->
                <Button Content="{DynamicResource Str.Btn.CycleStart}" Command="{Binding CycleStartCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource CycleBtnStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status.InterpState}" Value="RUNNING">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#4CAF50" Offset="0"/>
                                                <GradientStop Color="#2E7D32" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="BorderBrush" Value="#1B5E20"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <!-- KEEP: status — STOP IsPressed 紅色 -->
                <Button Content="{DynamicResource Str.Btn.Stop}" Command="{Binding StopCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource CycleBtnStyle}">
                            <Style.Triggers>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#EF5350" Offset="0"/>
                                                <GradientStop Color="#C62828" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="{DynamicResource Str.Btn.ReloadPgm}" Command="{Binding ReloadCommand}" Style="{StaticResource CycleBtnStyle}"/>
                <!-- KEEP: status — FEED HOLD 橘色(PAUSED) -->
                <Button Content="{DynamicResource Str.Btn.FeedHold}" Command="{Binding FeedHoldCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource CycleBtnStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status.InterpState}" Value="PAUSED">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#FFA726" Offset="0"/>
                                                <GradientStop Color="#E65100" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="BorderBrush" Value="#BF360C"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <!-- [2026-03-05] GO TO HOME → CLEAR PGM，對齊 PB 版 D_1 -->
                <Button Content="{DynamicResource Str.Btn.ClearPgm}" Command="{Binding ClearProgramCommand}" Style="{StaticResource CycleBtnStyle}"/>
                <!-- [2026-02-24] SINGLE BLOCK 綁定 ToggleSingleBlockCommand，IsSingleBlock=true 時背景變藍 -->
                <Button Content="{DynamicResource Str.Btn.SingleBlock}" Command="{Binding ToggleSingleBlockCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource CycleBtnStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSingleBlock}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Checked}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.StatusOn.Border}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="{DynamicResource Str.Btn.Flood}" Command="{Binding ToggleFloodCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource CycleBtnStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFloodOn}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Checked}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.StatusOn.Border}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <!-- [2026-03-04] BLOCK DELETE 綁定 ToggleBlockDeleteCommand，IsBlockDelete=true 時背景變藍 -->
                <Button Content="{DynamicResource Str.Btn.BlockDelete}" Command="{Binding ToggleBlockDeleteCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource CycleBtnStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBlockDelete}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Checked}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.StatusOn.Border}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <!-- [2026-02-23] 新增 MIST 按鈕連結 ToggleMistCommand，IsMistOn=true 時背景變藍 -->
                <Button Content="{DynamicResource Str.Btn.Mist}" Command="{Binding ToggleMistCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource CycleBtnStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMistOn}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Checked}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.StatusOn.Border}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <!-- [2026-03-04] M01 BREAK 綁定 ToggleOptionalStopCommand，IsOptionalStop=true 時背景變藍 -->
                <Button Content="{DynamicResource Str.Btn.M01Break}" Command="{Binding ToggleOptionalStopCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource CycleBtnStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOptionalStop}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Checked}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.StatusOn.Border}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </UniformGrid>

            <Separator Grid.Row="1" Background="{DynamicResource Brush.Separator}" Margin="0,3"/>

            <!-- [2026-03-12] 加工統計資訊列（累計/循環次數/預估剩餘） -->
            <Grid Grid.Row="2" Margin="2,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock Text="{DynamicResource Str.Label.TotalTime}" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="{DynamicResource FontSize.Small}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalMachiningTimeDisplay}" Foreground="{DynamicResource Brush.Text.Primary}" FontSize="{DynamicResource FontSize.Body}" FontFamily="{DynamicResource FontFamily.Mono}" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock Text="{DynamicResource Str.Label.CycleCount}" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="{DynamicResource FontSize.Small}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalCycleCount}" Foreground="{DynamicResource Brush.Text.Primary}" FontSize="{DynamicResource FontSize.Body}" FontFamily="{DynamicResource FontFamily.Mono}" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock Text="{DynamicResource Str.Label.Remaining}" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="{DynamicResource FontSize.Small}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding EstimatedRemainingDisplay}" Foreground="#FFA726" FontSize="{DynamicResource FontSize.Body}" FontFamily="{DynamicResource FontFamily.Mono}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- KEEP: status — POWER 綠色(IsPower=True) -->
                <!-- [2026-03-11] 還原字體層級 Large→Body（base 已全域加大） -->
                <Button Grid.Column="0" Command="{Binding TogglePowerCommand}" Margin="2" Content="{DynamicResource Str.Btn.Power}" Cursor="Hand"
                        Height="45" FontSize="{DynamicResource FontSize.Large}" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Primary}"> <!-- [2026-03-12] Foreground → DynamicResource -->
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="1" CornerRadius="4">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#111"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <!-- [2026-03-12] Background gradient → DynamicResource -->
                            <Setter Property="Background" Value="{DynamicResource Brush.Btn.Gradient}"/>
                            <!-- [2026-03-12] BorderBrush → DynamicResource -->
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Btn.Border}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEstop}" Value="True">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsPower}" Value="True">
                                    <Setter Property="Background" Value="#32CD32"/>
                                    <Setter Property="BorderBrush" Value="#006400"/>
                                    <Setter Property="Foreground" Value="Black"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Border Grid.Column="1" Background="{DynamicResource Brush.Input.Background}" CornerRadius="3" Margin="2" Height="45" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CycleTimeDisplay}" Foreground="{DynamicResource Brush.Input.Foreground}" FontWeight="Bold" FontFamily="{DynamicResource FontFamily.Mono}" FontSize="{DynamicResource FontSize.Large}"
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>

                <!-- KEEP: status — E-STOP 紅色(IsEstop=False) -->
                <Button Grid.Column="2" Command="{Binding ToggleEstopCommand}" Margin="2" Content="{DynamicResource Str.Btn.Estop}" Cursor="Hand"
                        Height="45" FontSize="{DynamicResource FontSize.Large}" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Primary}"> <!-- [2026-03-12] Foreground → DynamicResource -->
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="1" CornerRadius="4">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#111"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <!-- [2026-03-12] Background gradient → DynamicResource -->
                            <Setter Property="Background" Value="{DynamicResource Brush.Btn.Gradient}"/>
                            <!-- [2026-03-12] BorderBrush → DynamicResource -->
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Btn.Border}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEstop}" Value="False">
                                    <Setter Property="Background" Value="#FF0000"/>
                                    <Setter Property="BorderBrush" Value="#8B0000"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="ExtraBold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Grid>
    </Border>
</UserControl>