<UserControl x:Class="CncController.Views.Components.CycleControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CncController.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             d:DesignHeight="350" d:DesignWidth="220">

    <UserControl.Resources>
        <Style x:Key="CycleBtnStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="2,3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#4E4E4E" Offset="0.0"/>
                        <GradientStop Color="#2D2D2D" Offset="1.0"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#111"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FunctionBtnStyle" TargetType="Button" BasedOn="{StaticResource CycleBtnStyle}">
            <Setter Property="Background" Value="#4455AA"/>
        </Style>

    </UserControl.Resources>

    <Border Background="#252526" BorderBrush="#444" BorderThickness="1" CornerRadius="0" Padding="5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>

            <UniformGrid Grid.Row="0" Columns="2" Rows="5">
                <Button Content="CYCLE START" Command="{Binding CycleStartCommand}" Style="{StaticResource CycleBtnStyle}"/>
                <Button Content="STOP" Command="{Binding StopCommand}" Style="{StaticResource CycleBtnStyle}"/>

                <Button Content="RELOAD PGM" Command="{Binding ReloadCommand}" Style="{StaticResource CycleBtnStyle}"/>
                <Button Content="FEED HOLD" Command="{Binding FeedHoldCommand}" Style="{StaticResource CycleBtnStyle}"/>

                <Button Content="CLEAR PGM" Style="{StaticResource CycleBtnStyle}"/>
                <Button Content="SINGLE BLOCK" Style="{StaticResource CycleBtnStyle}"/>

                <Button Content="FLOOD" Style="{StaticResource CycleBtnStyle}"/>
                <Button Content="BLOCK DELETE" Style="{StaticResource FunctionBtnStyle}"/>

                <Button Content="MIST" Style="{StaticResource CycleBtnStyle}"/>
                <Button Content="M01 BREAK" Style="{StaticResource FunctionBtnStyle}"/>
            </UniformGrid>

            <Separator Grid.Row="1" Background="#444" Margin="0,5"/>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Command="{Binding TogglePowerCommand}" Margin="2">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" CornerRadius="3" Background="#333" BorderBrush="#222" BorderThickness="1">
                                            <TextBlock Text="POWER" Foreground="White" FontWeight="Bold" 
                                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsPower}" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#32CD32"/>
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#006400"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <Border Grid.Column="1" Background="White" CornerRadius="3" Margin="2" Height="30" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CycleTimeDisplay}" Foreground="Black" FontWeight="Bold" FontFamily="Consolas" FontSize="16"
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>

                <Button Grid.Column="2" Command="{Binding ToggleEstopCommand}" Margin="2">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" CornerRadius="3" Background="#333" BorderBrush="#222" BorderThickness="1">
                                            <TextBlock Text="E-STOP" Foreground="White" FontWeight="Bold" 
                                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsEstop}" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#FF0000"/>
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#8B0000"/>
                                                <Setter TargetName="bd" Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="Red" BlurRadius="10" ShadowDepth="0"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Grid>
    </Border>
</UserControl>