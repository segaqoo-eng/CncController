<UserControl x:Class="CncController.Views.Components.CycleControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CncController.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             d:DesignHeight="350" d:DesignWidth="220">

    <UserControl.Resources>
        <Style x:Key="CycleBtnStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="2,3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#4E4E4E" Offset="0.0"/>
                        <GradientStop Color="#2D2D2D" Offset="1.0"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#111"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                                <Setter TargetName="border" Property="Background" Value="#222"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FunctionBtnStyle" TargetType="Button" BasedOn="{StaticResource CycleBtnStyle}">
            <Setter Property="Background" Value="#4455AA"/>
        </Style>
    </UserControl.Resources>

    <Border Background="#252526" BorderBrush="#444" BorderThickness="1" CornerRadius="0" Padding="5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>

            <UniformGrid Grid.Row="0" Columns="2" Rows="5">
                <Button Content="CYCLE START" Command="{Binding CycleStartCommand}" Style="{StaticResource CycleBtnStyle}"/>
                <Button Content="STOP" Command="{Binding StopCommand}" Style="{StaticResource CycleBtnStyle}"/>
                <Button Content="RELOAD PGM" Command="{Binding ReloadCommand}" Style="{StaticResource CycleBtnStyle}"/>
                <Button Content="FEED HOLD" Command="{Binding FeedHoldCommand}" Style="{StaticResource CycleBtnStyle}"/>
                <!-- [2026-02-23] CLEAR PGM 改為 GO TO HOME，連結 HomeAllCommand（全軸回原點） -->
                <Button Content="GO TO HOME" Command="{Binding HomeAllCommand}" Style="{StaticResource CycleBtnStyle}"/>
                <Button Content="SINGLE BLOCK" Style="{StaticResource CycleBtnStyle}"/>
                <Button Content="FLOOD" Command="{Binding ToggleFloodCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource CycleBtnStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFloodOn}" Value="True">
                                    <Setter Property="Background" Value="#007ACC"/>
                                    <Setter Property="BorderBrush" Value="#005A9E"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="BLOCK DELETE" Style="{StaticResource FunctionBtnStyle}"/>
                <!-- [2026-02-23] 新增 MIST 按鈕連結 ToggleMistCommand，IsMistOn=true 時背景變藍 -->
                <Button Content="MIST" Command="{Binding ToggleMistCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource CycleBtnStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMistOn}" Value="True">
                                    <Setter Property="Background" Value="#007ACC"/>
                                    <Setter Property="BorderBrush" Value="#005A9E"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="M01 BREAK" Style="{StaticResource FunctionBtnStyle}"/>
            </UniformGrid>

            <Separator Grid.Row="1" Background="#444" Margin="0,5"/>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Command="{Binding TogglePowerCommand}" Margin="2" Content="POWER">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource CycleBtnStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEstop}" Value="True">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>

                                <DataTrigger Binding="{Binding IsPower}" Value="True">
                                    <Setter Property="Background" Value="#32CD32"/>
                                    <Setter Property="BorderBrush" Value="#006400"/>
                                    <Setter Property="Foreground" Value="Black"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Border Grid.Column="1" Background="#DDDDDD" CornerRadius="3" Margin="2" Height="38" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CycleTimeDisplay}" Foreground="Black" FontWeight="Bold" FontFamily="Consolas" FontSize="16"
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>

                <Button Grid.Column="2" Command="{Binding ToggleEstopCommand}" Margin="2" Content="E-STOP">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource CycleBtnStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEstop}" Value="False">
                                    <Setter Property="Background" Value="#FF0000"/>
                                    <Setter Property="BorderBrush" Value="#8B0000"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="ExtraBold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Grid>
    </Border>
</UserControl>