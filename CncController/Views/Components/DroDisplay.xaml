<!-- [2026-02-24] 重寫 DroDisplay：對齊 PB 版 5 欄佈局（ZERO | G5X WORK | MACHINE | DTG | REF） -->
<UserControl x:Class="CncController.Views.Components.DroDisplay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="500"
             FontFamily="{DynamicResource FontFamily.Default}">

    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="4" Padding="5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="25"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <!-- [2026-02-24] A/B/C 軸行：Auto 高度，未啟用時 Collapsed 不佔空間 -->
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="60"/>
            </Grid.ColumnDefinitions>

            <!-- ========== 標題列 (Row 0) ========== -->
            <TextBlock Grid.Row="0" Grid.Column="0" Text="AXIS" Foreground="{DynamicResource Brush.Text.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="{DynamicResource FontSize.Body}"/>
            <!-- [2026-02-24] Work 欄標題動態顯示 G5X（如 "G54 WORK"） -->
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding DataContext.Status.ActiveCoordSystem, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="#007ACC" FontWeight="Bold" FontSize="{DynamicResource FontSize.Body}"/>
                <TextBlock Text=" WORK" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="{DynamicResource FontSize.Body}"/>
            </StackPanel>
            <TextBlock Grid.Row="0" Grid.Column="2" Text="MACHINE" Foreground="{DynamicResource Brush.Text.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="{DynamicResource FontSize.Body}"/>
            <TextBlock Grid.Row="0" Grid.Column="3" Text="DTG" Foreground="{DynamicResource Brush.Text.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="{DynamicResource FontSize.Body}"/>
            <TextBlock Grid.Row="0" Grid.Column="4" Text="REF" Foreground="{DynamicResource Brush.Text.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="{DynamicResource FontSize.Body}"/>

            <!-- ========== X 軸 (Row 1) ========== -->
            <!-- ZERO X -->
            <Button Grid.Row="1" Grid.Column="0" Content="ZERO X" Margin="2" FontSize="{DynamicResource FontSize.Small}" FontWeight="Bold"
                    Foreground="White" Background="#555" BorderBrush="#666" BorderThickness="1"
                    Command="{Binding DataContext.DroZeroAxisCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="X"/>
            <!-- Work X -->
            <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource Brush.DRO.Background}" Margin="2" CornerRadius="2">
                <TextBlock Text="{Binding DataContext.Status.WorkX, RelativeSource={RelativeSource AncestorType=Window}, StringFormat=F3}"
                           Foreground="{DynamicResource Brush.DRO.Foreground}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5" FontSize="{DynamicResource FontSize.DRO}" FontWeight="Bold" FontFamily="{DynamicResource FontFamily.Mono}"/>
            </Border>
            <!-- Machine X -->
            <Border Grid.Row="1" Grid.Column="2" Background="{DynamicResource Brush.DRO.Background}" Margin="2" CornerRadius="2">
                <TextBlock Text="{Binding DataContext.Status.X, RelativeSource={RelativeSource AncestorType=Window}, StringFormat=F3}"
                           Foreground="{DynamicResource Brush.DRO.Foreground}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5" FontSize="{DynamicResource FontSize.DRO}" FontWeight="Bold" FontFamily="{DynamicResource FontFamily.Mono}"/>
            </Border>
            <!-- DTG X -->
            <Border Grid.Row="1" Grid.Column="3" Background="{DynamicResource Brush.DRO.Background}" Margin="2" CornerRadius="2">
                <TextBlock Text="{Binding DataContext.Status.DtgX, RelativeSource={RelativeSource AncestorType=Window}, StringFormat=F3}"
                           Foreground="{DynamicResource Brush.DRO.Foreground}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5" FontSize="{DynamicResource FontSize.DRO}" FontWeight="Bold" FontFamily="{DynamicResource FontFamily.Mono}"/>
            </Border>
            <!-- REF X -->
            <Button Grid.Row="1" Grid.Column="4" Content="REF X" Margin="2" FontSize="{DynamicResource FontSize.Small}" FontWeight="Bold"
                    Foreground="White" BorderThickness="1"
                    Command="{Binding DataContext.RefAxisCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="X">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#D32F2F"/>
                        <Setter Property="BorderBrush" Value="#B71C1C"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.Status.IsXHomed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter Property="Background" Value="#4CAF50"/>
                                <Setter Property="BorderBrush" Value="#388E3C"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- ========== Y 軸 (Row 2) ========== -->
            <Button Grid.Row="2" Grid.Column="0" Content="ZERO Y" Margin="2" FontSize="{DynamicResource FontSize.Small}" FontWeight="Bold"
                    Foreground="White" Background="#555" BorderBrush="#666" BorderThickness="1"
                    Command="{Binding DataContext.DroZeroAxisCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="Y"/>
            <Border Grid.Row="2" Grid.Column="1" Background="{DynamicResource Brush.DRO.Background}" Margin="2" CornerRadius="2">
                <TextBlock Text="{Binding DataContext.Status.WorkY, RelativeSource={RelativeSource AncestorType=Window}, StringFormat=F3}"
                           Foreground="{DynamicResource Brush.DRO.Foreground}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5" FontSize="{DynamicResource FontSize.DRO}" FontWeight="Bold" FontFamily="{DynamicResource FontFamily.Mono}"/>
            </Border>
            <Border Grid.Row="2" Grid.Column="2" Background="{DynamicResource Brush.DRO.Background}" Margin="2" CornerRadius="2">
                <TextBlock Text="{Binding DataContext.Status.Y, RelativeSource={RelativeSource AncestorType=Window}, StringFormat=F3}"
                           Foreground="{DynamicResource Brush.DRO.Foreground}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5" FontSize="{DynamicResource FontSize.DRO}" FontWeight="Bold" FontFamily="{DynamicResource FontFamily.Mono}"/>
            </Border>
            <Border Grid.Row="2" Grid.Column="3" Background="{DynamicResource Brush.DRO.Background}" Margin="2" CornerRadius="2">
                <TextBlock Text="{Binding DataContext.Status.DtgY, RelativeSource={RelativeSource AncestorType=Window}, StringFormat=F3}"
                           Foreground="{DynamicResource Brush.DRO.Foreground}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5" FontSize="{DynamicResource FontSize.DRO}" FontWeight="Bold" FontFamily="{DynamicResource FontFamily.Mono}"/>
            </Border>
            <Button Grid.Row="2" Grid.Column="4" Content="REF Y" Margin="2" FontSize="{DynamicResource FontSize.Small}" FontWeight="Bold"
                    Foreground="White" BorderThickness="1"
                    Command="{Binding DataContext.RefAxisCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="Y">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#D32F2F"/>
                        <Setter Property="BorderBrush" Value="#B71C1C"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.Status.IsYHomed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter Property="Background" Value="#4CAF50"/>
                                <Setter Property="BorderBrush" Value="#388E3C"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- ========== Z 軸 (Row 3) ========== -->
            <Button Grid.Row="3" Grid.Column="0" Content="ZERO Z" Margin="2" FontSize="{DynamicResource FontSize.Small}" FontWeight="Bold"
                    Foreground="White" Background="#555" BorderBrush="#666" BorderThickness="1"
                    Command="{Binding DataContext.DroZeroAxisCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="Z"/>
            <Border Grid.Row="3" Grid.Column="1" Background="{DynamicResource Brush.DRO.Background}" Margin="2" CornerRadius="2">
                <TextBlock Text="{Binding DataContext.Status.WorkZ, RelativeSource={RelativeSource AncestorType=Window}, StringFormat=F3}"
                           Foreground="{DynamicResource Brush.DRO.Foreground}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5" FontSize="{DynamicResource FontSize.DRO}" FontWeight="Bold" FontFamily="{DynamicResource FontFamily.Mono}"/>
            </Border>
            <Border Grid.Row="3" Grid.Column="2" Background="{DynamicResource Brush.DRO.Background}" Margin="2" CornerRadius="2">
                <TextBlock Text="{Binding DataContext.Status.Z, RelativeSource={RelativeSource AncestorType=Window}, StringFormat=F3}"
                           Foreground="{DynamicResource Brush.DRO.Foreground}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5" FontSize="{DynamicResource FontSize.DRO}" FontWeight="Bold" FontFamily="{DynamicResource FontFamily.Mono}"/>
            </Border>
            <Border Grid.Row="3" Grid.Column="3" Background="{DynamicResource Brush.DRO.Background}" Margin="2" CornerRadius="2">
                <TextBlock Text="{Binding DataContext.Status.DtgZ, RelativeSource={RelativeSource AncestorType=Window}, StringFormat=F3}"
                           Foreground="{DynamicResource Brush.DRO.Foreground}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5" FontSize="{DynamicResource FontSize.DRO}" FontWeight="Bold" FontFamily="{DynamicResource FontFamily.Mono}"/>
            </Border>
            <Button Grid.Row="3" Grid.Column="4" Content="REF Z" Margin="2" FontSize="{DynamicResource FontSize.Small}" FontWeight="Bold"
                    Foreground="White" BorderThickness="1"
                    Command="{Binding DataContext.RefAxisCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="Z">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#D32F2F"/>
                        <Setter Property="BorderBrush" Value="#B71C1C"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.Status.IsZHomed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter Property="Background" Value="#4CAF50"/>
                                <Setter Property="BorderBrush" Value="#388E3C"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- ========== A 軸 (Row 4) — 動態顯示 ========== -->
            <Button Grid.Row="4" Grid.Column="0" Content="ZERO A" Margin="2" FontSize="{DynamicResource FontSize.Small}" FontWeight="Bold" Height="36"
                    Foreground="White" Background="#555" BorderBrush="#666" BorderThickness="1"
                    Visibility="{Binding DataContext.IsAxisAEnabled, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                    Command="{Binding DataContext.DroZeroAxisCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="A"/>
            <Border Grid.Row="4" Grid.Column="1" Background="{DynamicResource Brush.DRO.Background}" Margin="2" CornerRadius="2" Height="36"
                    Visibility="{Binding DataContext.IsAxisAEnabled, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding DataContext.Status.WorkA, RelativeSource={RelativeSource AncestorType=Window}, StringFormat=F3}"
                           Foreground="{DynamicResource Brush.DRO.Foreground}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5" FontSize="{DynamicResource FontSize.DRO}" FontWeight="Bold" FontFamily="{DynamicResource FontFamily.Mono}"/>
            </Border>
            <Border Grid.Row="4" Grid.Column="2" Background="{DynamicResource Brush.DRO.Background}" Margin="2" CornerRadius="2" Height="36"
                    Visibility="{Binding DataContext.IsAxisAEnabled, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding DataContext.Status.A, RelativeSource={RelativeSource AncestorType=Window}, StringFormat=F3}"
                           Foreground="{DynamicResource Brush.DRO.Foreground}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5" FontSize="{DynamicResource FontSize.DRO}" FontWeight="Bold" FontFamily="{DynamicResource FontFamily.Mono}"/>
            </Border>
            <Border Grid.Row="4" Grid.Column="3" Background="{DynamicResource Brush.DRO.Background}" Margin="2" CornerRadius="2" Height="36"
                    Visibility="{Binding DataContext.IsAxisAEnabled, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding DataContext.Status.DtgA, RelativeSource={RelativeSource AncestorType=Window}, StringFormat=F3}"
                           Foreground="{DynamicResource Brush.DRO.Foreground}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5" FontSize="{DynamicResource FontSize.DRO}" FontWeight="Bold" FontFamily="{DynamicResource FontFamily.Mono}"/>
            </Border>
            <Button Grid.Row="4" Grid.Column="4" Content="REF A" Margin="2" FontSize="{DynamicResource FontSize.Small}" FontWeight="Bold" Height="36"
                    Foreground="White" BorderThickness="1"
                    Visibility="{Binding DataContext.IsAxisAEnabled, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                    Command="{Binding DataContext.RefAxisCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="A">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#D32F2F"/>
                        <Setter Property="BorderBrush" Value="#B71C1C"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.Status.IsAHomed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter Property="Background" Value="#4CAF50"/>
                                <Setter Property="BorderBrush" Value="#388E3C"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- ========== B 軸 (Row 5) — 動態顯示 ========== -->
            <Button Grid.Row="5" Grid.Column="0" Content="ZERO B" Margin="2" FontSize="{DynamicResource FontSize.Small}" FontWeight="Bold" Height="36"
                    Foreground="White" Background="#555" BorderBrush="#666" BorderThickness="1"
                    Visibility="{Binding DataContext.IsAxisBEnabled, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                    Command="{Binding DataContext.DroZeroAxisCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="B"/>
            <Border Grid.Row="5" Grid.Column="1" Background="{DynamicResource Brush.DRO.Background}" Margin="2" CornerRadius="2" Height="36"
                    Visibility="{Binding DataContext.IsAxisBEnabled, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding DataContext.Status.WorkB, RelativeSource={RelativeSource AncestorType=Window}, StringFormat=F3}"
                           Foreground="{DynamicResource Brush.DRO.Foreground}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5" FontSize="{DynamicResource FontSize.DRO}" FontWeight="Bold" FontFamily="{DynamicResource FontFamily.Mono}"/>
            </Border>
            <Border Grid.Row="5" Grid.Column="2" Background="{DynamicResource Brush.DRO.Background}" Margin="2" CornerRadius="2" Height="36"
                    Visibility="{Binding DataContext.IsAxisBEnabled, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding DataContext.Status.B, RelativeSource={RelativeSource AncestorType=Window}, StringFormat=F3}"
                           Foreground="{DynamicResource Brush.DRO.Foreground}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5" FontSize="{DynamicResource FontSize.DRO}" FontWeight="Bold" FontFamily="{DynamicResource FontFamily.Mono}"/>
            </Border>
            <Border Grid.Row="5" Grid.Column="3" Background="{DynamicResource Brush.DRO.Background}" Margin="2" CornerRadius="2" Height="36"
                    Visibility="{Binding DataContext.IsAxisBEnabled, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding DataContext.Status.DtgB, RelativeSource={RelativeSource AncestorType=Window}, StringFormat=F3}"
                           Foreground="{DynamicResource Brush.DRO.Foreground}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5" FontSize="{DynamicResource FontSize.DRO}" FontWeight="Bold" FontFamily="{DynamicResource FontFamily.Mono}"/>
            </Border>
            <Button Grid.Row="5" Grid.Column="4" Content="REF B" Margin="2" FontSize="{DynamicResource FontSize.Small}" FontWeight="Bold" Height="36"
                    Foreground="White" BorderThickness="1"
                    Visibility="{Binding DataContext.IsAxisBEnabled, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                    Command="{Binding DataContext.RefAxisCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="B">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#D32F2F"/>
                        <Setter Property="BorderBrush" Value="#B71C1C"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.Status.IsBHomed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter Property="Background" Value="#4CAF50"/>
                                <Setter Property="BorderBrush" Value="#388E3C"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- ========== C 軸 (Row 6) — 動態顯示 ========== -->
            <Button Grid.Row="6" Grid.Column="0" Content="ZERO C" Margin="2" FontSize="{DynamicResource FontSize.Small}" FontWeight="Bold" Height="36"
                    Foreground="White" Background="#555" BorderBrush="#666" BorderThickness="1"
                    Visibility="{Binding DataContext.IsAxisCEnabled, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                    Command="{Binding DataContext.DroZeroAxisCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="C"/>
            <Border Grid.Row="6" Grid.Column="1" Background="{DynamicResource Brush.DRO.Background}" Margin="2" CornerRadius="2" Height="36"
                    Visibility="{Binding DataContext.IsAxisCEnabled, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding DataContext.Status.WorkC, RelativeSource={RelativeSource AncestorType=Window}, StringFormat=F3}"
                           Foreground="{DynamicResource Brush.DRO.Foreground}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5" FontSize="{DynamicResource FontSize.DRO}" FontWeight="Bold" FontFamily="{DynamicResource FontFamily.Mono}"/>
            </Border>
            <Border Grid.Row="6" Grid.Column="2" Background="{DynamicResource Brush.DRO.Background}" Margin="2" CornerRadius="2" Height="36"
                    Visibility="{Binding DataContext.IsAxisCEnabled, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding DataContext.Status.C, RelativeSource={RelativeSource AncestorType=Window}, StringFormat=F3}"
                           Foreground="{DynamicResource Brush.DRO.Foreground}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5" FontSize="{DynamicResource FontSize.DRO}" FontWeight="Bold" FontFamily="{DynamicResource FontFamily.Mono}"/>
            </Border>
            <Border Grid.Row="6" Grid.Column="3" Background="{DynamicResource Brush.DRO.Background}" Margin="2" CornerRadius="2" Height="36"
                    Visibility="{Binding DataContext.IsAxisCEnabled, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding DataContext.Status.DtgC, RelativeSource={RelativeSource AncestorType=Window}, StringFormat=F3}"
                           Foreground="{DynamicResource Brush.DRO.Foreground}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5" FontSize="{DynamicResource FontSize.DRO}" FontWeight="Bold" FontFamily="{DynamicResource FontFamily.Mono}"/>
            </Border>
            <Button Grid.Row="6" Grid.Column="4" Content="REF C" Margin="2" FontSize="{DynamicResource FontSize.Small}" FontWeight="Bold" Height="36"
                    Foreground="White" BorderThickness="1"
                    Visibility="{Binding DataContext.IsAxisCEnabled, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                    Command="{Binding DataContext.RefAxisCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="C">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#D32F2F"/>
                        <Setter Property="BorderBrush" Value="#B71C1C"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.Status.IsCHomed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter Property="Background" Value="#4CAF50"/>
                                <Setter Property="BorderBrush" Value="#388E3C"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- ========== 底部按鈕列 (Row 7) ========== -->
            <Button Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Margin="2,5"
                    Content="{DynamicResource Str.Btn.ZeroAll}" FontSize="{DynamicResource FontSize.Body}" FontWeight="Bold"
                    Foreground="White" Background="#555" BorderBrush="#666" BorderThickness="1"
                    Command="{Binding DataContext.DroZeroAllCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>

            <!-- [2026-02-24] 原點復歸 ALL：未復歸→紅色（原點復歸 ALL）/ 已復歸→綠色（已復歸），仍可再次點擊 -->
            <Button Grid.Row="7" Grid.Column="2" Grid.ColumnSpan="3" Margin="2,5"
                    FontSize="{DynamicResource FontSize.Body}" FontWeight="Bold" Foreground="White" BorderThickness="1"
                    Command="{Binding DataContext.HomeAllCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#D32F2F"/>
                        <Setter Property="BorderBrush" Value="#B71C1C"/>
                        <Setter Property="Content" Value="{DynamicResource Str.Btn.RefAll}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.Status.IsAllHomed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter Property="Background" Value="#4CAF50"/>
                                <Setter Property="BorderBrush" Value="#388E3C"/>
                                <Setter Property="Content" Value="{DynamicResource Str.Btn.Homed}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Border>
</UserControl>
