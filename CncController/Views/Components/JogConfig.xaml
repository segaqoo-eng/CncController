<!-- [2026-03-05] 重寫 JogConfig：對齊 PB 版 D_5（JOG 標籤 + JOG 速度 Slider + FEEDRATE/SPINDLE 排版） -->
<UserControl x:Class="CncController.Views.Components.JogConfig"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             FontFamily="{DynamicResource FontFamily.Default}"
             d:DesignHeight="200" d:DesignWidth="300">

    <!-- [2026-03-11] StackPanel→Grid 平均分配欄高（Dashboard 對齊） -->
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Row 0: JOG 模式選擇（JOG + 0.1 / 0.01 / 0.001） -->
        <!-- [2026-03-16] 按鈕防呆 -->
        <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,10">
            <!-- [2026-03-05] Cont. → JOG（藍色標籤），增量值改為 0.1/0.01/0.001 -->
            <RadioButton Content="JOG" GroupName="JogMode" Style="{StaticResource NavBtnStyle}" IsChecked="True"
                         IsEnabled="{Binding CanJog}"
                         Command="{Binding SetJogModeCommand}" CommandParameter="0"/>

            <RadioButton Content="0.1" GroupName="JogMode" Style="{StaticResource NavBtnStyle}"
                         IsEnabled="{Binding CanJog}"
                         Command="{Binding SetJogModeCommand}" CommandParameter="0.1"/>

            <RadioButton Content="0.01" GroupName="JogMode" Style="{StaticResource NavBtnStyle}"
                         IsEnabled="{Binding CanJog}"
                         Command="{Binding SetJogModeCommand}" CommandParameter="0.01"/>

            <RadioButton Content="0.001" GroupName="JogMode" Style="{StaticResource NavBtnStyle}"
                         IsEnabled="{Binding CanJog}"
                         Command="{Binding SetJogModeCommand}" CommandParameter="0.001"/>
        </UniformGrid>

        <!-- [2026-03-11] Row 1~3：還原字體層級（base 已全域加大） -->
        <!-- Row 1: JOG 速度 Slider + 百分比顯示 -->
        <Grid Grid.Row="1" Margin="0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="90"/>
            </Grid.ColumnDefinitions>
            <!-- [2026-03-16] 按鈕防呆 -->
            <Slider Grid.Column="0" Minimum="0" Maximum="100" Value="{Binding JogSpeedPercent, Mode=TwoWay}"
                    IsEnabled="{Binding CanJog}"
                    TickFrequency="10" Height="25" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Accent}"/>
            <Border Grid.Column="1" Background="{DynamicResource Brush.Input.Background}" Margin="3,0,0,0" CornerRadius="2">
                <TextBlock Text="{Binding JogSpeedPercent, StringFormat={}{0:F0}%}"
                           Foreground="White" FontWeight="Bold" FontSize="{DynamicResource FontSize.Large}"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
        </Grid>

        <!-- Row 2: FEEDRATE MM/M -->
        <Grid Grid.Row="2" Margin="0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="90"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding Status.Feedrate, StringFormat=F1}" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{DynamicResource FontSize.Large}" FontWeight="Bold" Margin="0,0,5,0"/>
                <TextBlock Text="FEEDRATE MM/M" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="{DynamicResource FontSize.Large}" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBox Grid.Column="1" Text="{Binding JogFeedrate}"
                     Background="White" Padding="3" FontWeight="Bold" BorderThickness="0"
                     FontSize="{DynamicResource FontSize.Large}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
        </Grid>

        <!-- Row 3: SPINDLE RPM -->
        <Grid Grid.Row="3" Margin="0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="90"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding Status.SpindleSpeed, StringFormat=F0}" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{DynamicResource FontSize.Large}" FontWeight="Bold" Margin="0,0,5,0"/>
                <TextBlock Text="SPINDLE RPM" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="{DynamicResource FontSize.Large}" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBox Grid.Column="1" Text="{Binding JogSpindleRpm}"
                     Background="White" Padding="3" FontWeight="Bold" BorderThickness="0"
                     FontSize="{DynamicResource FontSize.Large}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
        </Grid>

        <!-- Row 4: REV / STOP / FWD 按鈕 -->
        <UniformGrid Grid.Row="4" Columns="3" Margin="0,4,0,0">
            <!-- [2026-03-05] 改用 BaseBtnStyle 對齊 PB 版 -->
            <!-- [2026-03-10] REV 按鈕：主軸反轉中(SpindleDirection=-1)時藍色高亮 -->
            <!-- [2026-03-16] 按鈕防呆 -->
            <Button Content="{DynamicResource Str.Btn.Rev}" Height="40" FontSize="{DynamicResource FontSize.Body}" Margin="2"
                    IsEnabled="{Binding CanSpindle}"
                    Command="{Binding SpindleRevCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource BaseBtnStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status.SpindleDirection}" Value="-1">
                                <Setter Property="Background" Value="{DynamicResource Brush.StatusOn}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <!-- [2026-03-10] 主軸 STOP：MouseDown 紅色，放開灰色 -->
            <!-- [2026-03-16] 按鈕防呆 -->
            <Button Content="{DynamicResource Str.Btn.Stop}" Height="40" FontSize="{DynamicResource FontSize.Body}" Margin="2"
                    IsEnabled="{Binding CanSpindle}"
                    Command="{Binding SpindleStopCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource BaseBtnStyle}">
                        <Style.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#D80000"/>
                                <Setter Property="BorderBrush" Value="#B71C1C"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <!-- [2026-03-10] FWD 按鈕：主軸正轉中(SpindleDirection=1)時藍色高亮 -->
            <!-- [2026-03-16] 按鈕防呆 -->
            <Button Content="{DynamicResource Str.Btn.Fwd}" Height="40" FontSize="{DynamicResource FontSize.Body}" Margin="2"
                    IsEnabled="{Binding CanSpindle}"
                    Command="{Binding SpindleFwdCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource BaseBtnStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status.SpindleDirection}" Value="1">
                                <Setter Property="Background" Value="{DynamicResource Brush.StatusOn}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </UniformGrid>
    </Grid>
</UserControl>
