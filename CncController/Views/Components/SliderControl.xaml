<!-- [2026-03-05] 完全重寫 SliderControl：對齊 PB 版 D_4（4 條 Slider + Spindle Load + V/F/S/R 重置按鈕） -->
<UserControl x:Class="CncController.Views.Components.SliderControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource FontFamily.Default}">

    <UserControl.Resources>
        <!-- [2026-03-11] 重置按鈕加大（工控觸控） -->
        <Style x:Key="ResetBtnStyle" TargetType="Button" BasedOn="{StaticResource BaseBtnStyle}">
            <Setter Property="Width" Value="80"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Large}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Margin" Value="3,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>

        <!-- [2026-03-05] Override Slider 樣式（藍色前景） -->
        <Style x:Key="OverrideSliderStyle" TargetType="Slider">
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="200"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#007ACC"/>
        </Style>
    </UserControl.Resources>

    <!-- [2026-03-11] Auto→* 平均分配欄高（Dashboard 對齊） -->
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Spindle Load -->
        <Grid Grid.Row="0" Margin="0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- [2026-03-11] 主軸負載字體加大 -->
            <Border Grid.Column="0" Background="#333" CornerRadius="2" Padding="5,3">
                <TextBlock Text="{Binding Status.SpindleLoad, StringFormat={}{0:F0} %}"
                           Foreground="White" FontWeight="Bold" FontSize="{DynamicResource FontSize.Large}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Border Grid.Column="1" Background="#555" CornerRadius="2" Margin="3,0,0,0" Padding="5,3">
                <TextBlock Text="{DynamicResource Str.Slider.SpindleLoad}" Foreground="White" FontWeight="Bold" FontSize="{DynamicResource FontSize.Large}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>

        <!-- Row 1: Velocity Override -->
        <Grid Grid.Row="1" Margin="0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Slider Grid.Column="0" Style="{StaticResource OverrideSliderStyle}"
                    Value="{Binding VelocityOverride, Mode=TwoWay}" TickFrequency="10"/>
            <Border Grid.Column="1" Background="#333" Margin="3,0" CornerRadius="2">
                <TextBlock Text="{Binding VelocityOverride, StringFormat={}{0:F0}%}"
                           Foreground="White" FontWeight="Bold" FontSize="{DynamicResource FontSize.Large}"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
            <Button Grid.Column="2" Content="V 100%" Style="{StaticResource ResetBtnStyle}"
                    Command="{Binding ResetVelocityOverrideCommand}"/>
        </Grid>

        <!-- Row 2: Feed Override -->
        <Grid Grid.Row="2" Margin="0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Slider Grid.Column="0" Style="{StaticResource OverrideSliderStyle}"
                    Value="{Binding Status.FeedOverride, Mode=TwoWay}" TickFrequency="10"/>
            <Border Grid.Column="1" Background="#333" Margin="3,0" CornerRadius="2">
                <TextBlock Text="{Binding Status.FeedOverride, StringFormat={}{0:F0}%}"
                           Foreground="White" FontWeight="Bold" FontSize="{DynamicResource FontSize.Large}"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
            <Button Grid.Column="2" Content="F 100%" Style="{StaticResource ResetBtnStyle}"
                    Command="{Binding ResetFeedOverrideCommand}"/>
        </Grid>

        <!-- Row 3: Spindle Override -->
        <Grid Grid.Row="3" Margin="0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Slider Grid.Column="0" Style="{StaticResource OverrideSliderStyle}"
                    Value="{Binding Status.SpindleOverride, Mode=TwoWay}" TickFrequency="10"/>
            <Border Grid.Column="1" Background="#333" Margin="3,0" CornerRadius="2">
                <TextBlock Text="{Binding Status.SpindleOverride, StringFormat={}{0:F0}%}"
                           Foreground="White" FontWeight="Bold" FontSize="{DynamicResource FontSize.Large}"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
            <Button Grid.Column="2" Content="S 100%" Style="{StaticResource ResetBtnStyle}"
                    Command="{Binding ResetSpindleOverrideCommand}"/>
        </Grid>

        <!-- Row 4: Rapid Override -->
        <Grid Grid.Row="4" Margin="0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Slider Grid.Column="0" Style="{StaticResource OverrideSliderStyle}"
                    Value="{Binding RapidOverride, Mode=TwoWay}" TickFrequency="10"/>
            <Border Grid.Column="1" Background="#333" Margin="3,0" CornerRadius="2">
                <TextBlock Text="{Binding RapidOverride, StringFormat={}{0:F0}%}"
                           Foreground="White" FontWeight="Bold" FontSize="{DynamicResource FontSize.Large}"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
            <Button Grid.Column="2" Content="R 100%" Style="{StaticResource ResetBtnStyle}"
                    Command="{Binding ResetRapidOverrideCommand}"/>
        </Grid>
    </Grid>
</UserControl>
