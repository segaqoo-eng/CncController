<UserControl x:Class="CncController.Views.Components.SliderControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="5" VerticalAlignment="Center">
        <Grid Margin="0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="60"/>
            </Grid.ColumnDefinitions>
            <Grid>
                <ProgressBar Value="120" Maximum="150" Height="25" Foreground="{DynamicResource Brush.Button.Active}" Background="{DynamicResource Brush.Button.Static}"/>
                <TextBlock Text="FEED OVERRIDE" Foreground="White" VerticalAlignment="Center" Margin="10,0"/>
            </Grid>
            <Border Grid.Column="1" Background="#333" Margin="5,0,0,0">
                <TextBlock Text="120%" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
        </Grid>
        <Grid Margin="0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="60"/>
            </Grid.ColumnDefinitions>
            <Grid>
                <ProgressBar Value="100" Maximum="150" Height="25" Foreground="{DynamicResource Brush.Button.Active}" Background="{DynamicResource Brush.Button.Static}"/>
                <TextBlock Text="SPINDLE SPEED" Foreground="White" VerticalAlignment="Center" Margin="10,0"/>
            </Grid>
            <Border Grid.Column="1" Background="#333" Margin="5,0,0,0">
                <TextBlock Text="100%" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
        </Grid>
        <Grid Margin="0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="60"/>
            </Grid.ColumnDefinitions>
            <Grid>
                <ProgressBar Value="50" Maximum="100" Height="25" Foreground="{DynamicResource Brush.Button.Active}" Background="{DynamicResource Brush.Button.Static}"/>
                <TextBlock Text="RAPID MOVE" Foreground="White" VerticalAlignment="Center" Margin="10,0"/>
            </Grid>
            <Border Grid.Column="1" Background="#333" Margin="5,0,0,0">
                <TextBlock Text="50%" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>