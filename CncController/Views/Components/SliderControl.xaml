<!-- [2026-02-24] 重寫 SliderControl：Feed/Spindle Override 綁定後端即時值，加 +/- 按鈕調整 -->
<UserControl x:Class="CncController.Views.Components.SliderControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- [2026-03-04] OverrideBtnStyle 改繼承 BaseBtnStyle，移除本地 Template -->
        <Style x:Key="OverrideBtnStyle" TargetType="Button" BasedOn="{StaticResource BaseBtnStyle}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="FontSize" Value="{DynamicResource BtnFontSize.Medium}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
    </UserControl.Resources>

    <StackPanel Margin="5" VerticalAlignment="Center">
        <!-- FEED OVERRIDE -->
        <Grid Margin="0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="-" Style="{StaticResource OverrideBtnStyle}" Margin="0,0,3,0"
                    Command="{Binding AdjustFeedOverrideCommand}" CommandParameter="-10"/>
            <Grid Grid.Column="1">
                <ProgressBar Value="{Binding Status.FeedOverride, Mode=OneWay}" Maximum="200" Height="25"
                             Foreground="{DynamicResource Brush.Button.Active}" Background="{DynamicResource Brush.Button.Static}"/>
                <TextBlock Text="FEED OVERRIDE" Foreground="White" VerticalAlignment="Center" Margin="10,0" FontSize="11"/>
            </Grid>
            <Border Grid.Column="2" Background="#333" Margin="3,0,3,0">
                <TextBlock Text="{Binding Status.FeedOverride, StringFormat={}{0:F0}%}" Foreground="White"
                           VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold"/>
            </Border>
            <Button Grid.Column="3" Content="+" Style="{StaticResource OverrideBtnStyle}"
                    Command="{Binding AdjustFeedOverrideCommand}" CommandParameter="10"/>
        </Grid>

        <!-- SPINDLE OVERRIDE -->
        <Grid Margin="0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="-" Style="{StaticResource OverrideBtnStyle}" Margin="0,0,3,0"
                    Command="{Binding AdjustSpindleOverrideCommand}" CommandParameter="-10"/>
            <Grid Grid.Column="1">
                <ProgressBar Value="{Binding Status.SpindleOverride, Mode=OneWay}" Maximum="200" Height="25"
                             Foreground="{DynamicResource Brush.Button.Active}" Background="{DynamicResource Brush.Button.Static}"/>
                <TextBlock Text="SPINDLE OVERRIDE" Foreground="White" VerticalAlignment="Center" Margin="10,0" FontSize="11"/>
            </Grid>
            <Border Grid.Column="2" Background="#333" Margin="3,0,3,0">
                <TextBlock Text="{Binding Status.SpindleOverride, StringFormat={}{0:F0}%}" Foreground="White"
                           VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold"/>
            </Border>
            <Button Grid.Column="3" Content="+" Style="{StaticResource OverrideBtnStyle}"
                    Command="{Binding AdjustSpindleOverrideCommand}" CommandParameter="10"/>
        </Grid>

        <!-- RAPID MOVE (暫保持靜態，後續可連動) -->
        <Grid Margin="0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="32"/>
            <Grid Grid.Column="1">
                <ProgressBar Value="100" Maximum="100" Height="25"
                             Foreground="{DynamicResource Brush.Button.Active}" Background="{DynamicResource Brush.Button.Static}"/>
                <TextBlock Text="RAPID MOVE" Foreground="White" VerticalAlignment="Center" Margin="10,0" FontSize="11"/>
            </Grid>
            <Border Grid.Column="2" Background="#333" Margin="3,0,3,0">
                <TextBlock Text="100%" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold"/>
            </Border>
            <Border Grid.Column="3" Width="32"/>
        </Grid>
    </StackPanel>
</UserControl>
