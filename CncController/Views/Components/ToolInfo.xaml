<!-- [2026-02-24] 重設版面對齊 PB 版：綁定即時刀具資料 + GO TO ZERO / GO TO G30 按鈕 -->
<UserControl x:Class="CncController.Views.Components.ToolInfo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- 按鈕共用樣式（與 CycleControl 一致） -->
        <Style x:Key="ToolBtnStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="1,2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#4E4E4E" Offset="0.0"/>
                        <GradientStop Color="#2D2D2D" Offset="1.0"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#111"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                                <Setter TargetName="border" Property="Background" Value="#222"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 資訊格樣式 -->
        <Style x:Key="InfoCellStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Button.Static}"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="CornerRadius" Value="2"/>
        </Style>
    </UserControl.Resources>

    <Border Background="#252526" BorderBrush="#444" BorderThickness="1" CornerRadius="0" Padding="4">
        <StackPanel>
            <!-- Row 1: T [ToolNumber] | M6 G43 -->
            <Grid Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource InfoCellStyle}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="T" Foreground="Gray" FontSize="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="{Binding Status.ToolNumber}" Foreground="{DynamicResource Brush.Text.Primary}"
                                   FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource InfoCellStyle}">
                    <TextBlock Text="M6 G43" Foreground="{DynamicResource Brush.Text.Primary}"
                               VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="13"/>
                </Border>
            </Grid>

            <!-- Row 2: G43 | G49（依 ToolNumber 高亮：0=G49 亮藍，>0=G43 亮藍） -->
            <Grid Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- G43：ToolNumber > 0 時亮藍（有刀具補正） -->
                <Border Grid.Column="0" Height="35" Margin="1" CornerRadius="2">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource Brush.Button.Static}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status.ToolNumber}" Value="0">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Button.Static}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="G43" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#00BFFF"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status.ToolNumber}" Value="0">
                                        <Setter Property="Foreground" Value="Gray"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
                <!-- G49：ToolNumber == 0 時亮藍（無刀具補正） -->
                <Border Grid.Column="1" Height="35" Margin="1" CornerRadius="2">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource Brush.Button.Static}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status.ToolNumber}" Value="0">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Button.Active}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="G49" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="Gray"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status.ToolNumber}" Value="0">
                                        <Setter Property="Foreground" Value="#00BFFF"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </Grid>

            <!-- Row 3: LENGTH -->
            <Border Background="#1E1E1E" CornerRadius="2" Margin="1,2" Padding="6,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="LENGTH" Foreground="Gray" VerticalAlignment="Center" FontSize="11"/>
                    <TextBlock Grid.Column="1" Text="{Binding Status.ToolLength, StringFormat=F4}"
                               Foreground="White" FontWeight="Bold" FontFamily="Consolas" FontSize="14"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Grid.Column="2" Text="MM" Foreground="Gray" VerticalAlignment="Center" FontSize="10"/>
                </Grid>
            </Border>

            <!-- Row 4: DIAM -->
            <Border Background="#1E1E1E" CornerRadius="2" Margin="1,2" Padding="6,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="DIAM" Foreground="Gray" VerticalAlignment="Center" FontSize="11"/>
                    <TextBlock Grid.Column="1" Text="{Binding Status.ToolDiameter, StringFormat=F4}"
                               Foreground="White" FontWeight="Bold" FontFamily="Consolas" FontSize="14"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Grid.Column="2" Text="MM" Foreground="Gray" VerticalAlignment="Center" FontSize="10"/>
                </Grid>
            </Border>

            <!-- Row 5: GO TO ZERO | GO TO G30 -->
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="GO TO ZERO"
                        Command="{Binding GoToZeroCommand}"
                        Style="{StaticResource ToolBtnStyle}"/>
                <Button Grid.Column="1" Content="GO TO G30"
                        Command="{Binding GoToG30Command}"
                        Style="{StaticResource ToolBtnStyle}"/>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
