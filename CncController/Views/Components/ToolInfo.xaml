<UserControl x:Class="CncController.Views.Components.ToolInfo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="2">
        <Grid Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource Brush.Button.Static}" Height="35" Margin="1" CornerRadius="2">
                <DockPanel>
                    <TextBlock Text="T" Foreground="Gray" VerticalAlignment="Center" Margin="5,0,0,0"/>
                    <TextBlock Text="1" Foreground="{DynamicResource Brush.Text.Primary}" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" FontSize="16"/>
                </DockPanel>
            </Border>
            <Border Grid.Column="1" Background="{DynamicResource Brush.Button.Static}" Height="35" Margin="1" CornerRadius="2">
                <TextBlock Text="M6" Foreground="{DynamicResource Brush.Text.Primary}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
        </Grid>
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource Brush.Button.Static}" Height="35" Margin="1" CornerRadius="2">
                <TextBlock Text="G43" Foreground="{DynamicResource Brush.Text.Primary}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
            <Border Grid.Column="1" Background="{DynamicResource Brush.Button.Active}" Height="35" Margin="1" CornerRadius="2">
                <TextBlock Text="G49" Foreground="{DynamicResource Brush.Text.Primary}" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold"/>
            </Border>
        </Grid>
        <DockPanel Margin="0,5">
            <TextBlock Text="LEN" Foreground="{DynamicResource Brush.Text.Primary}" VerticalAlignment="Center" Width="40" FontSize="12"/>
            <TextBox Text="120.500" Background="White" Foreground="Black" FontWeight="Bold" Padding="3" BorderThickness="0"/>
        </DockPanel>
        <DockPanel Margin="0,5">
            <TextBlock Text="DIA" Foreground="{DynamicResource Brush.Text.Primary}" VerticalAlignment="Center" Width="40" FontSize="12"/>
            <TextBox Text="6.000" Background="White" Foreground="Black" FontWeight="Bold" Padding="3" BorderThickness="0"/>
        </DockPanel>
        <Button Content="{DynamicResource Str.Btn.HomeAll}" Height="40" Background="{DynamicResource Brush.Border}" Margin="0,20,0,0"/>
    </StackPanel>
</UserControl>