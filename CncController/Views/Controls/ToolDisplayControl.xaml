<!-- [2026-03-11] 刀具表頁面用：自繪刀具圖示（主軸+刀具+刀號/刀長/刀徑標註） -->
<UserControl x:Class="CncController.Views.Controls.ToolDisplayControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CncController.Views.Controls"
             Background="Transparent"
             FontFamily="{DynamicResource FontFamily.Default}">

    <UserControl.Resources>
        <!-- ===== 金屬漸層筆刷（與 SpindleToolControl 一致） ===== -->
        <LinearGradientBrush x:Key="SpindleBodyBrush" StartPoint="0,0.5" EndPoint="1,0.5">
            <GradientStop Color="#2A2A2A" Offset="0.0"/>
            <GradientStop Color="#4A4A4A" Offset="0.15"/>
            <GradientStop Color="#707070" Offset="0.4"/>
            <GradientStop Color="#888888" Offset="0.5"/>
            <GradientStop Color="#707070" Offset="0.6"/>
            <GradientStop Color="#4A4A4A" Offset="0.85"/>
            <GradientStop Color="#2A2A2A" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="FlangeBrush" StartPoint="0,0.5" EndPoint="1,0.5">
            <GradientStop Color="#222222" Offset="0.0"/>
            <GradientStop Color="#3C3C3C" Offset="0.15"/>
            <GradientStop Color="#585858" Offset="0.4"/>
            <GradientStop Color="#6A6A6A" Offset="0.5"/>
            <GradientStop Color="#585858" Offset="0.6"/>
            <GradientStop Color="#3C3C3C" Offset="0.85"/>
            <GradientStop Color="#222222" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="TaperBrush" StartPoint="0,0.5" EndPoint="1,0.5">
            <GradientStop Color="#303030" Offset="0.0"/>
            <GradientStop Color="#505050" Offset="0.2"/>
            <GradientStop Color="#787878" Offset="0.45"/>
            <GradientStop Color="#8A8A8A" Offset="0.5"/>
            <GradientStop Color="#787878" Offset="0.55"/>
            <GradientStop Color="#505050" Offset="0.8"/>
            <GradientStop Color="#303030" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PullStudBrush" StartPoint="0,0.5" EndPoint="1,0.5">
            <GradientStop Color="#606060" Offset="0.0"/>
            <GradientStop Color="#A0A0A0" Offset="0.3"/>
            <GradientStop Color="#D0D0D0" Offset="0.5"/>
            <GradientStop Color="#A0A0A0" Offset="0.7"/>
            <GradientStop Color="#606060" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ToolShankBrush" StartPoint="0,0.5" EndPoint="1,0.5">
            <GradientStop Color="#404040" Offset="0.0"/>
            <GradientStop Color="#6E6E6E" Offset="0.2"/>
            <GradientStop Color="#9A9A9A" Offset="0.45"/>
            <GradientStop Color="#AAAAAA" Offset="0.5"/>
            <GradientStop Color="#9A9A9A" Offset="0.55"/>
            <GradientStop Color="#6E6E6E" Offset="0.8"/>
            <GradientStop Color="#404040" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CuttingEdgeBrush" StartPoint="0,0.5" EndPoint="1,0.5">
            <GradientStop Color="#707070" Offset="0.0"/>
            <GradientStop Color="#B8B8B8" Offset="0.25"/>
            <GradientStop Color="#E0E0E0" Offset="0.5"/>
            <GradientStop Color="#B8B8B8" Offset="0.75"/>
            <GradientStop Color="#707070" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="HighlightLineBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#60FFFFFF" Offset="0.0"/>
            <GradientStop Color="#00FFFFFF" Offset="1.0"/>
        </LinearGradientBrush>
    </UserControl.Resources>

    <Viewbox Stretch="Uniform">
        <Canvas Width="360" Height="520">
            <!-- ============================================ -->
            <!-- 主軸殼體 -->
            <!-- ============================================ -->
            <Rectangle Canvas.Left="115" Canvas.Top="20"
                       Width="130" Height="90"
                       RadiusX="4" RadiusY="4"
                       Fill="{StaticResource SpindleBodyBrush}"
                       Stroke="#1A1A1A" StrokeThickness="1"/> <!-- [2026-03-12] Stroke: decorative 3D detail, keep hardcoded -->
            <!-- 殼體高光 -->
            <Rectangle Canvas.Left="116" Canvas.Top="21"
                       Width="128" Height="8"
                       RadiusX="2" RadiusY="2"
                       Fill="{StaticResource HighlightLineBrush}" IsHitTestVisible="False"/>
            <!-- 殼體溝槽 -->
            <!-- [2026-03-12] 殼體溝槽：decorative 3D detail, keep hardcoded -->
            <Line Canvas.Left="120" Canvas.Top="60" X2="120" Y2="0" Stroke="#1E1E1E" StrokeThickness="1.2"/>
            <Line Canvas.Left="120" Canvas.Top="62" X2="120" Y2="0" Stroke="{DynamicResource Brush.Btn.Border}" StrokeThickness="0.5"/>

            <!-- ============================================ -->
            <!-- 法蘭盤 -->
            <!-- ============================================ -->
            <Rectangle Canvas.Left="100" Canvas.Top="110"
                       Width="160" Height="24"
                       RadiusX="3" RadiusY="3"
                       Fill="{StaticResource FlangeBrush}"
                       Stroke="#1A1A1A" StrokeThickness="1"/> <!-- [2026-03-12] Stroke: decorative 3D detail, keep hardcoded -->
            <!-- 螺栓 -->
            <!-- [2026-03-12] 螺栓 Fill/Stroke → DynamicResource -->
            <Ellipse Canvas.Left="110" Canvas.Top="116" Width="10" Height="10" Fill="{DynamicResource Brush.Border}" Stroke="{DynamicResource Brush.Btn.Border}" StrokeThickness="0.5"/>
            <Ellipse Canvas.Left="130" Canvas.Top="116" Width="10" Height="10" Fill="{DynamicResource Brush.Border}" Stroke="{DynamicResource Brush.Btn.Border}" StrokeThickness="0.5"/>
            <Ellipse Canvas.Left="220" Canvas.Top="116" Width="10" Height="10" Fill="{DynamicResource Brush.Border}" Stroke="{DynamicResource Brush.Btn.Border}" StrokeThickness="0.5"/>
            <Ellipse Canvas.Left="240" Canvas.Top="116" Width="10" Height="10" Fill="{DynamicResource Brush.Border}" Stroke="{DynamicResource Brush.Btn.Border}" StrokeThickness="0.5"/>
            <!-- 法蘭高光 -->
            <Rectangle Canvas.Left="101" Canvas.Top="111"
                       Width="158" Height="4"
                       RadiusX="1" RadiusY="1"
                       Fill="{StaticResource HighlightLineBrush}" IsHitTestVisible="False"/>

            <!-- ============================================ -->
            <!-- 錐形刀柄座（梯形） -->
            <!-- ============================================ -->
            <!-- [2026-03-12] Stroke: decorative 3D detail, keep hardcoded -->
            <Path Fill="{StaticResource TaperBrush}" Stroke="#1A1A1A" StrokeThickness="1">
                <Path.Data>
                    <PathGeometry>
                        <PathFigure StartPoint="120,134" IsClosed="True">
                            <LineSegment Point="240,134"/>
                            <LineSegment Point="210,190"/>
                            <LineSegment Point="150,190"/>
                        </PathFigure>
                    </PathGeometry>
                </Path.Data>
            </Path>

            <!-- ============================================ -->
            <!-- 刀號標籤（夾頭旁） -->
            <!-- ============================================ -->
            <!-- [2026-03-12] 刀號標籤 Background/BorderBrush/Foreground → DynamicResource -->
            <Border Canvas.Left="115" Canvas.Top="155" Background="{DynamicResource Brush.Text.Primary}" CornerRadius="4" Padding="12,4"
                    BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="2">
                <TextBlock x:Name="ToolNumberText" Foreground="{DynamicResource Brush.DRO.Label}"
                           FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
            </Border>

            <!-- ============================================ -->
            <!-- 刀柄（Pull Stud） -->
            <!-- ============================================ -->
            <Rectangle Canvas.Left="165" Canvas.Top="190" Width="30" Height="30"
                       RadiusX="2" RadiusY="2"
                       Fill="{StaticResource PullStudBrush}" Stroke="{DynamicResource Brush.Border}" StrokeThickness="0.8"/>
            <Rectangle Canvas.Left="158" Canvas.Top="190" Width="44" Height="8"
                       RadiusX="1" RadiusY="1"
                       Fill="{StaticResource PullStudBrush}" Stroke="{DynamicResource Brush.Border}" StrokeThickness="0.8"/>

            <!-- [2026-03-12] 過渡/刀柄 Stroke → DynamicResource -->
            <Path Fill="{StaticResource ToolShankBrush}" Stroke="{DynamicResource Brush.Border}" StrokeThickness="0.8">
                <Path.Data>
                    <PathGeometry>
                        <PathFigure StartPoint="165,220" IsClosed="True">
                            <LineSegment Point="195,220"/>
                            <LineSegment Point="205,230"/>
                            <LineSegment Point="155,230"/>
                        </PathFigure>
                    </PathGeometry>
                </Path.Data>
            </Path>

            <!-- ============================================ -->
            <!-- 刀身（粗圓柱） -->
            <!-- ============================================ -->
            <Rectangle Canvas.Left="155" Canvas.Top="230" Width="50" Height="80"
                       RadiusX="3" RadiusY="3"
                       Fill="{StaticResource ToolShankBrush}" Stroke="{DynamicResource Brush.Border}" StrokeThickness="0.8"/>
            <!-- 螺旋刃溝 -->
            <!-- [2026-03-12] 螺旋刃溝 Stroke → DynamicResource -->
            <Line Canvas.Left="165" Canvas.Top="238" X2="18" Y2="65"
                  Stroke="{DynamicResource Brush.Border}" StrokeThickness="1.5" StrokeDashArray="4,3"/>
            <Line Canvas.Left="190" Canvas.Top="238" X2="-18" Y2="65"
                  Stroke="{DynamicResource Brush.Btn.Border}" StrokeThickness="1" StrokeDashArray="4,3"/>
            <!-- 刀身高光 -->
            <Rectangle Canvas.Left="176" Canvas.Top="232" Width="6" Height="74" RadiusX="1" RadiusY="1" IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00FFFFFF" Offset="0"/>
                        <GradientStop Color="#30FFFFFF" Offset="0.5"/>
                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- ============================================ -->
            <!-- 刀刃（底部梯形） -->
            <!-- ============================================ -->
            <!-- [2026-03-12] 刀刃 Stroke → DynamicResource -->
            <Path Fill="{StaticResource CuttingEdgeBrush}" Stroke="{DynamicResource Brush.Border}" StrokeThickness="0.8">
                <Path.Data>
                    <PathGeometry>
                        <PathFigure StartPoint="155,310" IsClosed="True">
                            <LineSegment Point="205,310"/>
                            <LineSegment Point="190,340"/>
                            <LineSegment Point="170,340"/>
                        </PathFigure>
                    </PathGeometry>
                </Path.Data>
            </Path>

            <!-- ============================================ -->
            <!-- 刀長標註（左側垂直箭頭） -->
            <!-- ============================================ -->
            <!-- 上箭頭 -->
            <!-- [2026-03-12] 標註線/箭頭 Stroke/Fill → DynamicResource -->
            <Line Canvas.Left="80" Canvas.Top="190" X2="0" Y2="150"
                  Stroke="{DynamicResource Brush.Text.Primary}" StrokeThickness="1.5"/>
            <Polygon Canvas.Left="74" Canvas.Top="185" Points="6,0 0,10 12,10"
                     Fill="{DynamicResource Brush.Text.Primary}"/>
            <Polygon Canvas.Left="74" Canvas.Top="340" Points="0,0 12,0 6,10"
                     Fill="{DynamicResource Brush.Text.Primary}"/>
            <!-- TOOL LENGTH 標籤 -->
            <StackPanel Canvas.Left="10" Canvas.Top="255">
                <TextBlock Text="TOOL" Foreground="{DynamicResource Brush.Text.Primary}" FontSize="16" FontWeight="Bold"
                           TextAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect ShadowDepth="1" Color="Black" Opacity="0.8" BlurRadius="3"/>
                    </TextBlock.Effect>
                </TextBlock>
                <!-- [2026-03-12] TOOL LENGTH 標籤 Foreground → DynamicResource -->
                <TextBlock Text="LENGTH" Foreground="{DynamicResource Brush.Text.Primary}" FontSize="16" FontWeight="Bold"
                           TextAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect ShadowDepth="1" Color="Black" Opacity="0.8" BlurRadius="3"/>
                    </TextBlock.Effect>
                </TextBlock>
                <!-- [2026-03-12] TOOL LENGTH 值框 Background/BorderBrush/Foreground → DynamicResource -->
                <Border Background="{DynamicResource Brush.Text.Primary}" CornerRadius="3" Padding="6,3" Margin="0,4,0,0"
                        BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="1.5">
                    <TextBlock x:Name="ToolLengthText" Foreground="{DynamicResource Brush.DRO.Label}"
                               FontFamily="Consolas" FontSize="18" FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                </Border>
            </StackPanel>

            <!-- ============================================ -->
            <!-- 刀徑標註（下方水平箭頭） -->
            <!-- ============================================ -->
            <!-- 水平線 + 箭頭 -->
            <!-- [2026-03-12] 刀徑標註線/箭頭 Stroke/Fill → DynamicResource -->
            <Line Canvas.Left="145" Canvas.Top="370" X2="70" Y2="0"
                  Stroke="{DynamicResource Brush.Text.Primary}" StrokeThickness="1.5"/>
            <Polygon Canvas.Left="140" Canvas.Top="364" Points="0,6 10,0 10,12"
                     Fill="{DynamicResource Brush.Text.Primary}"/>
            <Polygon Canvas.Left="215" Canvas.Top="364" Points="10,6 0,0 0,12"
                     Fill="{DynamicResource Brush.Text.Primary}"/>
            <!-- DIAM 標籤 -->
            <StackPanel Canvas.Left="230" Canvas.Top="358" Orientation="Horizontal">
                <!-- [2026-03-12] DIAM 標籤 Foreground → DynamicResource -->
                <TextBlock Text="DIAM" Foreground="{DynamicResource Brush.Text.Primary}" FontSize="16" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="0,0,6,0">
                    <TextBlock.Effect>
                        <DropShadowEffect ShadowDepth="1" Color="Black" Opacity="0.8" BlurRadius="3"/>
                    </TextBlock.Effect>
                </TextBlock>
                <!-- [2026-03-12] DIAM 值框 Background/BorderBrush/Foreground → DynamicResource -->
                <Border Background="{DynamicResource Brush.Text.Primary}" CornerRadius="3" Padding="6,3"
                        BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="1.5">
                    <TextBlock x:Name="ToolDiameterText" Foreground="{DynamicResource Brush.DRO.Label}"
                               FontFamily="Consolas" FontSize="18" FontWeight="Bold"/>
                </Border>
            </StackPanel>
        </Canvas>
    </Viewbox>
</UserControl>
