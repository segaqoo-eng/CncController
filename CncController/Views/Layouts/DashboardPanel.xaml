<UserControl x:Class="CncController.Views.Layouts.DashboardPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:comp="clr-namespace:CncController.Views.Components">
    
    <Border Background="{DynamicResource Brush.WindowBackground}" 
            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="2">
        <Grid>
            <Grid.ColumnDefinitions>
                <!-- [2026-03-05] 欄寬對齊 PB 版 D_1~D_5 比例 -->
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="490"/>
                <ColumnDefinition Width="430"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <comp:CycleControl Grid.Column="0" Margin="2"/>
            <comp:ToolInfo     Grid.Column="1" Margin="2"/>
            <comp:DroDisplay   Grid.Column="2" Margin="2" Loaded="DroDisplay_Loaded"/>
            <comp:SliderControl Grid.Column="3" Margin="2"/>
            <comp:JogConfig    Grid.Column="4" Margin="2"/>
        </Grid>
    </Border>
</UserControl>