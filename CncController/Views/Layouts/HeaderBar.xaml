<UserControl x:Class="CncController.Views.Layouts.HeaderBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{DynamicResource Brush.PanelBackground}">
        <DockPanel LastChildFill="False">
            <Menu Background="Transparent" Foreground="{DynamicResource Brush.Text.Muted}" VerticalAlignment="Center">
                <MenuItem Header="{DynamicResource Str.Nav.File}" Foreground="{DynamicResource Brush.Text.Muted}"/>
                <MenuItem Header="{DynamicResource Str.Nav.Settings}" Foreground="{DynamicResource Brush.Text.Muted}"/>
            </Menu>
            <TextBlock Text="{DynamicResource Str.Title}" Foreground="{DynamicResource Brush.Text.Primary}" VerticalAlignment="Center" DockPanel.Dock="Right" Margin="10,0"/>
        </DockPanel>
    </Border>
</UserControl>