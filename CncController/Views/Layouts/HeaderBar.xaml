<UserControl x:Class="CncController.Views.Layouts.HeaderBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:CncController.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             FontFamily="{DynamicResource FontFamily.Default}">

    <Border Background="{DynamicResource Brush.PanelBackground}" Padding="5,0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Menu Grid.Column="0" Background="Transparent" Foreground="{DynamicResource Brush.Text.Muted}" VerticalAlignment="Center">
                <!-- [2026-02-23] File 選單加 EXIT 子項，呼叫 ExitAppCommand 關閉應用程式 -->
                <MenuItem Header="{DynamicResource Str.Nav.File}" Foreground="{DynamicResource Brush.Text.Muted}">
                    <MenuItem Header="{DynamicResource Str.Header.Exit}"
                              Command="{Binding DataContext.ExitAppCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                              Foreground="#333"/>
                </MenuItem>
                <MenuItem Header="{DynamicResource Str.Nav.Settings}" Foreground="{DynamicResource Brush.Text.Muted}"/>
            </Menu>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="18" Height="18" CornerRadius="9" 
                        Background="{Binding SystemStatusBrush}"
                        BorderBrush="#444" BorderThickness="1"
                        Margin="0,0,10,0">
                    <Border.Effect>
                        <DropShadowEffect Color="{Binding SystemStatusColor}" 
                                          BlurRadius="10" ShadowDepth="0" Opacity="1.0"/>
                    </Border.Effect>
                </Border>

                <TextBlock Text="{Binding SystemStatus}"
                           Foreground="{DynamicResource Brush.Text.Primary}"
                           FontWeight="Bold"
                           FontSize="{DynamicResource FontSize.Large}"
                           VerticalAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="{Binding SystemStatusColor}" BlurRadius="5" ShadowDepth="0" Opacity="0.5"/>
                    </TextBlock.Effect>
                </TextBlock>

                <!-- [2026-03-04] RETRY 按鈕：斷線時顯示 -->
                <!-- [2026-03-11] RETRY 改用 BaseBtnStyle，移除 inline Background 和自訂 Template -->
                <Button Content="RETRY" Command="{Binding RetryConnectionCommand}"
                        Visibility="{Binding ShowRetryButton, Converter={StaticResource BoolToVis}}"
                        Style="{StaticResource BaseBtnStyle}" Foreground="White" FontWeight="Bold"
                        Padding="12,4" Margin="10,0,0,0" FontSize="{DynamicResource FontSize.Body}"
                        VerticalAlignment="Center" Cursor="Hand"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                <!-- [2026-03-09] 主軸 / 刀庫 Encoder 即時顯示 -->
                <Border Background="#1A1A2E" CornerRadius="3" Padding="8,2" Margin="0,0,15,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Foreground="#888" FontSize="{DynamicResource FontSize.Body}" VerticalAlignment="Center">
                            <Run Text="SPINDLE" FontWeight="Bold" Foreground="#4EC9B0"/>
                        </TextBlock>
                        <TextBlock Text="{Binding Status.SpindlePosition, StringFormat={}{0:F1}°}"
                                   Foreground="#4EC9B0" FontWeight="Bold" FontFamily="Consolas"
                                   FontSize="{DynamicResource FontSize.Body}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        <TextBlock Text="|" Foreground="#444" Margin="10,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Foreground="#888" FontSize="{DynamicResource FontSize.Body}" VerticalAlignment="Center">
                            <Run Text="CAROUSEL" FontWeight="Bold" Foreground="#DCDCAA"/>
                        </TextBlock>
                        <TextBlock Text="{Binding Status.CarouselPosition, StringFormat={}{0:F1}°}"
                                   Foreground="#DCDCAA" FontWeight="Bold" FontFamily="Consolas"
                                   FontSize="{DynamicResource FontSize.Body}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- [2026-03-06] 快捷鍵提示 -->
                <TextBlock Foreground="#888" FontSize="{DynamicResource FontSize.Body}" VerticalAlignment="Center" Margin="0,0,20,0">
                    <Run Text="ESC" FontWeight="Bold" Foreground="#CCC"/><Run Text="{DynamicResource Str.Header.ShortcutStop}"/>
                    <Run Text="F1" FontWeight="Bold" Foreground="#CCC"/><Run Text="{DynamicResource Str.Header.ShortcutPower}"/>
                    <Run Text="F2" FontWeight="Bold" Foreground="#CCC"/><Run Text="{DynamicResource Str.Header.ShortcutEstop}"/>
                </TextBlock>

                <TextBlock Text="{DynamicResource Str.Title}"
                           Foreground="{DynamicResource Brush.Text.Primary}"
                           Opacity="0.5"
                           VerticalAlignment="Center"
                           Margin="0,0,20,0"/>

                <TextBlock Text="{Binding ServerVersionDisplay, StringFormat='Ver: {0}'}" 
                           Foreground="{DynamicResource Brush.Text.Muted}" 
                           FontSize="{DynamicResource FontSize.Body}"
                           VerticalAlignment="Center"
                           Margin="0,0,20,0"/>

                <Button Click="BtnUser_Click"
                        Background="Transparent" 
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="Click to Login / Logout">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </ControlTemplate>
                    </Button.Template>

                    <StackPanel Orientation="Horizontal">
                        <Border Width="32" Height="32" CornerRadius="16" Background="#5E70FF" Margin="0,0,10,0">
                            <TextBlock Text="{Binding CurrentUser.Username[0]}" 
                                       Foreground="White" FontWeight="Bold" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center" 
                                       FontSize="{DynamicResource FontSize.Large}"/>
                        </Border>

                        <TextBlock Text="{Binding CurrentUser.Username}" 
                                   Foreground="{DynamicResource Brush.Text.Primary}" 
                                   VerticalAlignment="Center" 
                                   FontSize="{DynamicResource FontSize.Medium}"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>