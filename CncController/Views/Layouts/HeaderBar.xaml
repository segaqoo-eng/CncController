<UserControl x:Class="CncController.Views.Layouts.HeaderBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:CncController.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">

    <Border Background="{DynamicResource Brush.PanelBackground}" Padding="5,0">
        <DockPanel LastChildFill="False">

            <Menu DockPanel.Dock="Left" Background="Transparent" Foreground="{DynamicResource Brush.Text.Muted}" VerticalAlignment="Center">
                <MenuItem Header="{DynamicResource Str.Nav.File}" Foreground="{DynamicResource Brush.Text.Muted}"/>
                <MenuItem Header="{DynamicResource Str.Nav.Settings}" Foreground="{DynamicResource Brush.Text.Muted}"/>
            </Menu>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">

                <Button Click="BtnUser_Click"
                        Background="Transparent" 
                        BorderThickness="0"
                        Margin="0,0,15,0"
                        Cursor="Hand"
                        ToolTip="Click to Login / Logout">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </ControlTemplate>
                    </Button.Template>

                    <StackPanel Orientation="Horizontal">
                        <Border Width="20" Height="20" CornerRadius="10" Background="#5E70FF" Margin="0,0,8,0">
                            <TextBlock Text="{Binding CurrentUser.Username[0]}" 
                                       Foreground="White" FontWeight="Bold" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center" 
                                       FontSize="10"/>
                        </Border>

                        <TextBlock Text="{Binding CurrentUser.Username}" 
                                   Foreground="{DynamicResource Brush.Text.Primary}" 
                                   VerticalAlignment="Center" 
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>

                <TextBlock Text="{Binding ServerVersionDisplay, StringFormat='Ver: {0}'}" 
                           Foreground="{DynamicResource Brush.Text.Muted}" 
                           FontSize="11" 
                           VerticalAlignment="Center" 
                           Margin="0,0,15,0"/>

                <TextBlock Text="{Binding SystemStatus}" 
                           Foreground="{DynamicResource Brush.Text.Primary}" 
                           FontWeight="Bold" 
                           VerticalAlignment="Center" 
                           Margin="0,0,10,0"/>

                <Border Width="16" Height="16" CornerRadius="8" 
                        Background="{Binding SystemStatusBrush}"
                        BorderBrush="#444" BorderThickness="1"
                        Margin="0,0,5,0">
                    <Border.Effect>
                        <DropShadowEffect Color="{Binding SystemStatusColor}" 
                                          BlurRadius="8" ShadowDepth="0" Opacity="0.9"/>
                    </Border.Effect>
                </Border>

            </StackPanel>

            <TextBlock Text="{DynamicResource Str.Title}" 
                       Foreground="{DynamicResource Brush.Text.Primary}" 
                       Opacity="0.5"
                       VerticalAlignment="Center" 
                       DockPanel.Dock="Right" 
                       Margin="0,0,20,0"/>

        </DockPanel>
    </Border>
</UserControl>