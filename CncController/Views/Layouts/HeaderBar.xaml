<UserControl x:Class="CncController.Views.Layouts.HeaderBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:CncController.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">

    <Border Background="{DynamicResource Brush.PanelBackground}" Padding="5,0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Menu Grid.Column="0" Background="Transparent" Foreground="{DynamicResource Brush.Text.Muted}" VerticalAlignment="Center">
                <!-- [2026-02-23] File 選單加 EXIT 子項，呼叫 ExitAppCommand 關閉應用程式 -->
                <MenuItem Header="{DynamicResource Str.Nav.File}" Foreground="{DynamicResource Brush.Text.Muted}">
                    <MenuItem Header="EXIT（關閉程式）"
                              Command="{Binding DataContext.ExitAppCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                              Foreground="#333"/>
                </MenuItem>
                <MenuItem Header="{DynamicResource Str.Nav.Settings}" Foreground="{DynamicResource Brush.Text.Muted}"/>
            </Menu>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="18" Height="18" CornerRadius="9" 
                        Background="{Binding SystemStatusBrush}"
                        BorderBrush="#444" BorderThickness="1"
                        Margin="0,0,10,0">
                    <Border.Effect>
                        <DropShadowEffect Color="{Binding SystemStatusColor}" 
                                          BlurRadius="10" ShadowDepth="0" Opacity="1.0"/>
                    </Border.Effect>
                </Border>

                <TextBlock Text="{Binding SystemStatus}"
                           Foreground="{DynamicResource Brush.Text.Primary}"
                           FontWeight="Bold"
                           FontSize="16"
                           VerticalAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="{Binding SystemStatusColor}" BlurRadius="5" ShadowDepth="0" Opacity="0.5"/>
                    </TextBlock.Effect>
                </TextBlock>

                <!-- [2026-03-04] RETRY 按鈕：斷線時顯示 -->
                <Button Content="RETRY" Command="{Binding RetryConnectionCommand}"
                        Visibility="{Binding ShowRetryButton, Converter={StaticResource BoolToVis}}"
                        Background="#007ACC" Foreground="White" FontWeight="Bold"
                        Padding="12,4" Margin="10,0,0,0" FontSize="12"
                        VerticalAlignment="Center" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                <TextBlock Text="{DynamicResource Str.Title}" 
                           Foreground="{DynamicResource Brush.Text.Primary}" 
                           Opacity="0.5"
                           VerticalAlignment="Center" 
                           Margin="0,0,20,0"/>

                <TextBlock Text="{Binding ServerVersionDisplay, StringFormat='Ver: {0}'}" 
                           Foreground="{DynamicResource Brush.Text.Muted}" 
                           FontSize="12" 
                           VerticalAlignment="Center" 
                           Margin="0,0,20,0"/>

                <Button Click="BtnUser_Click"
                        Background="Transparent" 
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="Click to Login / Logout">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </ControlTemplate>
                    </Button.Template>

                    <StackPanel Orientation="Horizontal">
                        <Border Width="32" Height="32" CornerRadius="16" Background="#5E70FF" Margin="0,0,10,0">
                            <TextBlock Text="{Binding CurrentUser.Username[0]}" 
                                       Foreground="White" FontWeight="Bold" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center" 
                                       FontSize="16"/>
                        </Border>

                        <TextBlock Text="{Binding CurrentUser.Username}" 
                                   Foreground="{DynamicResource Brush.Text.Primary}" 
                                   VerticalAlignment="Center" 
                                   FontSize="14"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>