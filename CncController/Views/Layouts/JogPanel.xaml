<UserControl x:Class="CncController.Views.Layouts.JogPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{DynamicResource Brush.PanelBackground}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1,0,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="5,10">
                <TextBlock Text="STATUS" Foreground="#AAA" HorizontalAlignment="Center" FontSize="10" Margin="0,0,0,2"/>
                <Border Background="#444" Height="30" CornerRadius="2">
                    <TextBlock Text="{DynamicResource Str.Status.Idle}" Foreground="#00FF00" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold"/>
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="2" VerticalAlignment="Bottom" Margin="5,0,5,10">
                <Button Content="Z+" Height="50" Margin="0,0,0,3" FontSize="18"/>
                <Button Content="Z-" Height="50" Margin="0,0,0,15" FontSize="18"/>
                <Button Content="Y+" Height="50" Margin="0,0,0,3" FontSize="18"/>
                <Grid Height="50" Margin="0,0,0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="X-" FontSize="18" Margin="0,0,2,0"/>
                    <Button Grid.Column="1" Content="X+" FontSize="18" Margin="2,0,0,0"/>
                </Grid>
                <Button Content="Y-" Height="50" Margin="0,0,0,3" FontSize="18"/>
            </StackPanel>

            <UniformGrid Grid.Row="3" Columns="3" Margin="2">
                <Button Content="MAN" Background="{DynamicResource Brush.Button.Active}" Margin="1" FontSize="11"/>
                <Button Content="AUTO" Margin="1" FontSize="11"/>
                <Button Content="MDI" Margin="1" FontSize="11"/>
            </UniformGrid>
        </Grid>
    </Border>
</UserControl>