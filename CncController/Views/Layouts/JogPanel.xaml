<!-- [2026-02-24] 更新 JogPanel：新增 A/B/C 旋轉軸 JOG 按鈕，依 IsAxisA/B/CEnabled 動態顯示 -->
<UserControl x:Class="CncController.Views.Layouts.JogPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:vm="clr-namespace:CncController.ViewModels"
             mc:Ignorable="d"
             FontFamily="{DynamicResource FontFamily.Default}"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             d:DesignHeight="400" d:DesignWidth="300">

    <UserControl.Resources>
        <!-- [2026-03-12] JOG 方向按鈕：漸層引用主題資源，主題切換時自動生效 -->
        <Style x:Key="JogArrowBtn" TargetType="Button">
            <Setter Property="Width" Value="70"/>
            <Setter Property="Height" Value="70"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize.DRO}"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" BorderBrush="{DynamicResource Brush.Btn.Border}" BorderThickness="2" CornerRadius="6"
                                Background="{DynamicResource Brush.Btn.Gradient}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.Hover.Border}"/>
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Btn.HoverGradient}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Checked}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="White"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- [2026-02-24] 旋轉軸 JOG 按鈕樣式（較小） -->
        <Style x:Key="JogRotaryBtn" TargetType="Button" BasedOn="{StaticResource JogArrowBtn}">
            <Setter Property="Width" Value="55"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Medium}"/>
            <Setter Property="Margin" Value="3"/>
        </Style>
    </UserControl.Resources>

    <!-- [2026-03-11] JOG 內容置中，MAN/AUTO/MDI 靠底部 + 10px 留白 -->
    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <!-- [2026-02-24] 旋轉軸區域 -->
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <!-- [2026-03-11] 彈性空間：將 MAN/AUTO/MDI 推到底部 -->
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">

            <Button Content="Z+" Style="{StaticResource JogArrowBtn}" Margin="0,0,10,0">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewMouseDown">
                        <i:InvokeCommandAction Command="{Binding JogStartCommand}" CommandParameter="2,1.0"/>
                    </i:EventTrigger>
                    <i:EventTrigger EventName="PreviewMouseUp">
                        <i:InvokeCommandAction Command="{Binding JogStopCommand}" CommandParameter="2"/>
                    </i:EventTrigger>
                    <i:EventTrigger EventName="MouseLeave">
                        <i:InvokeCommandAction Command="{Binding JogStopCommand}" CommandParameter="2"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </Button>

            <Button Content="Z-" Style="{StaticResource JogArrowBtn}">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewMouseDown">
                        <i:InvokeCommandAction Command="{Binding JogStartCommand}" CommandParameter="2,-1.0"/>
                    </i:EventTrigger>
                    <i:EventTrigger EventName="PreviewMouseUp">
                        <i:InvokeCommandAction Command="{Binding JogStopCommand}" CommandParameter="2"/>
                    </i:EventTrigger>
                    <i:EventTrigger EventName="MouseLeave">
                        <i:InvokeCommandAction Command="{Binding JogStopCommand}" CommandParameter="2"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </Button>
        </StackPanel>

        <Grid Grid.Row="2" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Row="0" Grid.Column="1" Content="Y+" Style="{StaticResource JogArrowBtn}">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewMouseDown">
                        <i:InvokeCommandAction Command="{Binding JogStartCommand}" CommandParameter="1,1.0"/>
                    </i:EventTrigger>
                    <i:EventTrigger EventName="PreviewMouseUp">
                        <i:InvokeCommandAction Command="{Binding JogStopCommand}" CommandParameter="1"/>
                    </i:EventTrigger>
                    <i:EventTrigger EventName="MouseLeave">
                        <i:InvokeCommandAction Command="{Binding JogStopCommand}" CommandParameter="1"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </Button>

            <Button Grid.Row="1" Grid.Column="0" Content="X-" Style="{StaticResource JogArrowBtn}">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewMouseDown">
                        <i:InvokeCommandAction Command="{Binding JogStartCommand}" CommandParameter="0,-1.0"/>
                    </i:EventTrigger>
                    <i:EventTrigger EventName="PreviewMouseUp">
                        <i:InvokeCommandAction Command="{Binding JogStopCommand}" CommandParameter="0"/>
                    </i:EventTrigger>
                    <i:EventTrigger EventName="MouseLeave">
                        <i:InvokeCommandAction Command="{Binding JogStopCommand}" CommandParameter="0"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </Button>

            <!-- [2026-03-12] 十字圓盤中心指示 -->
            <Border Grid.Row="1" Grid.Column="1" Width="70" Height="70" Margin="4"
                    Background="{DynamicResource Brush.WindowBackground}" CornerRadius="35" Opacity="0.6">
                <TextBlock Text="+" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="32"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <Button Grid.Row="1" Grid.Column="2" Content="X+" Style="{StaticResource JogArrowBtn}">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewMouseDown">
                        <i:InvokeCommandAction Command="{Binding JogStartCommand}" CommandParameter="0,1.0"/>
                    </i:EventTrigger>
                    <i:EventTrigger EventName="PreviewMouseUp">
                        <i:InvokeCommandAction Command="{Binding JogStopCommand}" CommandParameter="0"/>
                    </i:EventTrigger>
                    <i:EventTrigger EventName="MouseLeave">
                        <i:InvokeCommandAction Command="{Binding JogStopCommand}" CommandParameter="0"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </Button>

            <Button Grid.Row="2" Grid.Column="1" Content="Y-" Style="{StaticResource JogArrowBtn}">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewMouseDown">
                        <i:InvokeCommandAction Command="{Binding JogStartCommand}" CommandParameter="1,-1.0"/>
                    </i:EventTrigger>
                    <i:EventTrigger EventName="PreviewMouseUp">
                        <i:InvokeCommandAction Command="{Binding JogStopCommand}" CommandParameter="1"/>
                    </i:EventTrigger>
                    <i:EventTrigger EventName="MouseLeave">
                        <i:InvokeCommandAction Command="{Binding JogStopCommand}" CommandParameter="1"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </Button>
        </Grid>

        <!-- [2026-02-24] 新增旋轉軸 JOG 區域（A/B/C），依 MachineConfig 啟用狀態顯示 -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center">
            <!-- A 軸 JOG (axis=3) -->
            <StackPanel Orientation="Horizontal" Margin="0,0,8,0"
                        Visibility="{Binding IsAxisAEnabled, Converter={StaticResource BoolToVis}}">
                <Button Content="A-" Style="{StaticResource JogRotaryBtn}">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="PreviewMouseDown">
                            <i:InvokeCommandAction Command="{Binding JogStartCommand}" CommandParameter="3,-1.0"/>
                        </i:EventTrigger>
                        <i:EventTrigger EventName="PreviewMouseUp">
                            <i:InvokeCommandAction Command="{Binding JogStopCommand}" CommandParameter="3"/>
                        </i:EventTrigger>
                        <i:EventTrigger EventName="MouseLeave">
                            <i:InvokeCommandAction Command="{Binding JogStopCommand}" CommandParameter="3"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </Button>
                <Button Content="A+" Style="{StaticResource JogRotaryBtn}">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="PreviewMouseDown">
                            <i:InvokeCommandAction Command="{Binding JogStartCommand}" CommandParameter="3,1.0"/>
                        </i:EventTrigger>
                        <i:EventTrigger EventName="PreviewMouseUp">
                            <i:InvokeCommandAction Command="{Binding JogStopCommand}" CommandParameter="3"/>
                        </i:EventTrigger>
                        <i:EventTrigger EventName="MouseLeave">
                            <i:InvokeCommandAction Command="{Binding JogStopCommand}" CommandParameter="3"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </Button>
            </StackPanel>

            <!-- B 軸 JOG (axis=4) -->
            <StackPanel Orientation="Horizontal" Margin="0,0,8,0"
                        Visibility="{Binding IsAxisBEnabled, Converter={StaticResource BoolToVis}}">
                <Button Content="B-" Style="{StaticResource JogRotaryBtn}">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="PreviewMouseDown">
                            <i:InvokeCommandAction Command="{Binding JogStartCommand}" CommandParameter="4,-1.0"/>
                        </i:EventTrigger>
                        <i:EventTrigger EventName="PreviewMouseUp">
                            <i:InvokeCommandAction Command="{Binding JogStopCommand}" CommandParameter="4"/>
                        </i:EventTrigger>
                        <i:EventTrigger EventName="MouseLeave">
                            <i:InvokeCommandAction Command="{Binding JogStopCommand}" CommandParameter="4"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </Button>
                <Button Content="B+" Style="{StaticResource JogRotaryBtn}">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="PreviewMouseDown">
                            <i:InvokeCommandAction Command="{Binding JogStartCommand}" CommandParameter="4,1.0"/>
                        </i:EventTrigger>
                        <i:EventTrigger EventName="PreviewMouseUp">
                            <i:InvokeCommandAction Command="{Binding JogStopCommand}" CommandParameter="4"/>
                        </i:EventTrigger>
                        <i:EventTrigger EventName="MouseLeave">
                            <i:InvokeCommandAction Command="{Binding JogStopCommand}" CommandParameter="4"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </Button>
            </StackPanel>

            <!-- C 軸 JOG (axis=5) -->
            <StackPanel Orientation="Horizontal"
                        Visibility="{Binding IsAxisCEnabled, Converter={StaticResource BoolToVis}}">
                <Button Content="C-" Style="{StaticResource JogRotaryBtn}">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="PreviewMouseDown">
                            <i:InvokeCommandAction Command="{Binding JogStartCommand}" CommandParameter="5,-1.0"/>
                        </i:EventTrigger>
                        <i:EventTrigger EventName="PreviewMouseUp">
                            <i:InvokeCommandAction Command="{Binding JogStopCommand}" CommandParameter="5"/>
                        </i:EventTrigger>
                        <i:EventTrigger EventName="MouseLeave">
                            <i:InvokeCommandAction Command="{Binding JogStopCommand}" CommandParameter="5"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </Button>
                <Button Content="C+" Style="{StaticResource JogRotaryBtn}">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="PreviewMouseDown">
                            <i:InvokeCommandAction Command="{Binding JogStartCommand}" CommandParameter="5,1.0"/>
                        </i:EventTrigger>
                        <i:EventTrigger EventName="PreviewMouseUp">
                            <i:InvokeCommandAction Command="{Binding JogStopCommand}" CommandParameter="5"/>
                        </i:EventTrigger>
                        <i:EventTrigger EventName="MouseLeave">
                            <i:InvokeCommandAction Command="{Binding JogStopCommand}" CommandParameter="5"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </Button>
            </StackPanel>
        </StackPanel>

        <!-- [2026-03-11] MAN/AUTO/MDI 模式切換按鈕：靠底部 + 10px 留白 + 平均欄寬 -->
        <UniformGrid Grid.Row="6" Rows="1" Columns="3" HorizontalAlignment="Stretch" Margin="5,0,5,10">
            <Button Content="MAN" Command="{Binding SetModeCommand}" CommandParameter="MANUAL">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource JogRotaryBtn}">
                        <Setter Property="Height" Value="36"/>
                        <Setter Property="FontSize" Value="{DynamicResource FontSize.Large}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status.TaskMode}" Value="MANUAL">
                                <Setter Property="Background" Value="{DynamicResource Brush.Checked}"/>
                                <Setter Property="BorderBrush" Value="#005A9E"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="AUTO" Command="{Binding SetModeCommand}" CommandParameter="AUTO">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource JogRotaryBtn}">
                        <Setter Property="Height" Value="36"/>
                        <Setter Property="FontSize" Value="{DynamicResource FontSize.Large}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status.TaskMode}" Value="AUTO">
                                <Setter Property="Background" Value="{DynamicResource Brush.Checked}"/>
                                <Setter Property="BorderBrush" Value="#005A9E"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="MDI" Command="{Binding SetModeCommand}" CommandParameter="MDI">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource JogRotaryBtn}">
                        <Setter Property="Height" Value="36"/>
                        <Setter Property="FontSize" Value="{DynamicResource FontSize.Large}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status.TaskMode}" Value="MDI">
                                <Setter Property="Background" Value="{DynamicResource Brush.Checked}"/>
                                <Setter Property="BorderBrush" Value="#005A9E"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </UniformGrid>
    </Grid>
</UserControl>
