<UserControl x:Class="CncController.Views.Pages.AtcBasicSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="600"
             FontFamily="{DynamicResource FontFamily.Default}">

    <!-- [2026-03-06] ATC Basic Settings tab - AtcBasicSettingsViewModel -->

    <UserControl.Resources>
        <!-- [2026-03-06] Shared styles for dark-theme settings layout -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#5E70FF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Medium}"/>
        </Style>
        <Style x:Key="ParamLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Medium}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="ParamTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Medium}"/>
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#555"/>
        </Style>
        <Style x:Key="UnitLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
        <Style x:Key="SettingsGroupBox" TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="15,10"/>
        </Style>
        <!-- [2026-03-06] Dark ComboBox style -->
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#1E1E1E">
        <StackPanel Margin="20">

            <!-- [2026-03-06] ATC TYPE section -->
            <GroupBox Style="{StaticResource SettingsGroupBox}">
                <GroupBox.Header>
                    <TextBlock Text="ATC TYPE" Style="{StaticResource SectionHeader}"/>
                </GroupBox.Header>
                <StackPanel>
                    <!-- [2026-03-06] ATC Type ComboBox -->
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="ATC Type:" Style="{StaticResource ParamLabel}"/>
                        <ComboBox Grid.Column="1" FontSize="{DynamicResource FontSize.Medium}" Height="30" Foreground="Black"
                                  ItemsSource="{Binding AvailableAtcTypes}"
                                  SelectedItem="{Binding SelectedAtcType}"/>
                    </Grid>
                    <!-- [2026-03-06] Tool Count -->
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Tool Count:" Style="{StaticResource ParamLabel}"/>
                        <TextBox Grid.Column="1" Style="{StaticResource ParamTextBox}"
                                 Text="{Binding ToolCount, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                </StackPanel>
            </GroupBox>

            <!-- [2026-03-06] SAFETY POSITIONS section (visible when not None) -->
            <GroupBox Style="{StaticResource SettingsGroupBox}"
                      Visibility="{Binding ShowTimingParams, Converter={StaticResource BoolToVis}}">
                <GroupBox.Header>
                    <TextBlock Text="SAFETY POSITIONS" Style="{StaticResource SectionHeader}"/>
                </GroupBox.Header>
                <StackPanel>
                    <!-- [2026-03-06] Z Tool Change Height -->
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Z Tool Change Height:" Style="{StaticResource ParamLabel}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBox Style="{StaticResource ParamTextBox}"
                                     Text="{Binding ZToolChangeHeight, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="mm" Style="{StaticResource UnitLabel}"/>
                        </StackPanel>
                    </Grid>
                    <!-- [2026-03-06] Z Clearance Height -->
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Z Clearance Height:" Style="{StaticResource ParamLabel}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBox Style="{StaticResource ParamTextBox}"
                                     Text="{Binding ZClearanceHeight, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="mm" Style="{StaticResource UnitLabel}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </GroupBox>

            <!-- [2026-03-06] TIMING section (visible when ShowTimingParams=true) -->
            <GroupBox Style="{StaticResource SettingsGroupBox}"
                      Visibility="{Binding ShowTimingParams, Converter={StaticResource BoolToVis}}">
                <GroupBox.Header>
                    <TextBlock Text="TIMING" Style="{StaticResource SectionHeader}"/>
                </GroupBox.Header>
                <StackPanel>
                    <!-- [2026-03-06] Clamp Dwell -->
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Clamp Dwell:" Style="{StaticResource ParamLabel}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBox Style="{StaticResource ParamTextBox}"
                                     Text="{Binding ClampDwell, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="ms" Style="{StaticResource UnitLabel}"/>
                        </StackPanel>
                    </Grid>
                    <!-- [2026-03-06] Unclamp Dwell -->
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Unclamp Dwell:" Style="{StaticResource ParamLabel}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBox Style="{StaticResource ParamTextBox}"
                                     Text="{Binding UnclampDwell, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="ms" Style="{StaticResource UnitLabel}"/>
                        </StackPanel>
                    </Grid>
                    <!-- [2026-03-06] Air Blow Dwell -->
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Air Blow Dwell:" Style="{StaticResource ParamLabel}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBox Style="{StaticResource ParamTextBox}"
                                     Text="{Binding AirBlowDwell, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="ms" Style="{StaticResource UnitLabel}"/>
                        </StackPanel>
                    </Grid>
                    <!-- [2026-03-06] Sensor Timeout -->
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Sensor Timeout:" Style="{StaticResource ParamLabel}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBox Style="{StaticResource ParamTextBox}"
                                     Text="{Binding SensorTimeout, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="ms" Style="{StaticResource UnitLabel}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </GroupBox>

            <!-- [2026-03-06] RACK PARAMETERS section (visible when ShowRackParams=true) -->
            <GroupBox Style="{StaticResource SettingsGroupBox}"
                      Visibility="{Binding ShowRackParams, Converter={StaticResource BoolToVis}}">
                <GroupBox.Header>
                    <TextBlock Text="RACK PARAMETERS" Style="{StaticResource SectionHeader}"/>
                </GroupBox.Header>
                <StackPanel>
                    <!-- [2026-03-06] Traverse Speed -->
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Traverse Speed:" Style="{StaticResource ParamLabel}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBox Style="{StaticResource ParamTextBox}"
                                     Text="{Binding RackTraverseSpeed, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="mm/min" Style="{StaticResource UnitLabel}"/>
                        </StackPanel>
                    </Grid>
                    <!-- [2026-03-06] Pocket 1 X/Y -->
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Pocket 1 X / Y:" Style="{StaticResource ParamLabel}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBox Style="{StaticResource ParamTextBox}"
                                     Text="{Binding RackPocket1X, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Style="{StaticResource ParamTextBox}" Margin="10,0,0,0"
                                     Text="{Binding RackPocket1Y, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>
                    <!-- [2026-03-06] Pocket 2 X/Y -->
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Pocket 2 X / Y:" Style="{StaticResource ParamLabel}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBox Style="{StaticResource ParamTextBox}"
                                     Text="{Binding RackPocket2X, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Style="{StaticResource ParamTextBox}" Margin="10,0,0,0"
                                     Text="{Binding RackPocket2Y, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>
                    <!-- [2026-03-06] Clearance X/Y -->
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Clearance X / Y:" Style="{StaticResource ParamLabel}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBox Style="{StaticResource ParamTextBox}"
                                     Text="{Binding RackClearanceX, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Style="{StaticResource ParamTextBox}" Margin="10,0,0,0"
                                     Text="{Binding RackClearanceY, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </GroupBox>

        </StackPanel>
    </ScrollViewer>
</UserControl>
