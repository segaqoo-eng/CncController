<UserControl x:Class="CncController.Views.Pages.AtcBasicSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="600"
             FontFamily="{DynamicResource FontFamily.Default}">

    <!-- [2026-03-06] ATC Basic Settings tab - AtcBasicSettingsViewModel -->
    <!-- [2026-03-10] TextBox 靠左對齊 + 全部標籤改繁體中文 -->

    <UserControl.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#5E70FF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Medium}"/>
        </Style>
        <Style x:Key="ParamLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Medium}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <!-- [2026-03-10] TextAlignment Left + HorizontalAlignment Left 緊貼標籤 -->
        <Style x:Key="ParamTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Medium}"/>
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#555"/>
        </Style>
        <Style x:Key="UnitLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
        <Style x:Key="SettingsGroupBox" TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="15,10"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#1E1E1E">
        <StackPanel Margin="20">

            <!-- [2026-03-06] ATC TYPE section -->
            <GroupBox Style="{StaticResource SettingsGroupBox}">
                <GroupBox.Header>
                    <TextBlock Text="刀庫類型" Style="{StaticResource SectionHeader}"/>
                </GroupBox.Header>
                <StackPanel>
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="刀庫類型：" Style="{StaticResource ParamLabel}"/>
                        <ComboBox Grid.Column="1" FontSize="{DynamicResource FontSize.Medium}" Height="30" Foreground="Black" HorizontalAlignment="Left" Width="200"
                                  ItemsSource="{Binding AvailableAtcTypes}"
                                  SelectedItem="{Binding SelectedAtcType}"/>
                    </Grid>
                    <!-- [2026-03-09] Carousel Control Mode（僅斗笠式顯示） -->
                    <Grid Margin="0,5"
                          Visibility="{Binding ShowControlMode, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="控制模式：" Style="{StaticResource ParamLabel}"/>
                        <ComboBox Grid.Column="1" FontSize="{DynamicResource FontSize.Medium}" Height="30" Foreground="Black" HorizontalAlignment="Left" Width="200"
                                  ItemsSource="{Binding AvailableControlModes}"
                                  SelectedItem="{Binding ControlMode}"/>
                    </Grid>
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="刀具數量：" Style="{StaticResource ParamLabel}"/>
                        <TextBox Grid.Column="1" Style="{StaticResource ParamTextBox}"
                                 Text="{Binding ToolCount, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                </StackPanel>
            </GroupBox>

            <!-- [2026-03-06] SAFETY POSITIONS section -->
            <GroupBox Style="{StaticResource SettingsGroupBox}"
                      Visibility="{Binding ShowTimingParams, Converter={StaticResource BoolToVis}}">
                <GroupBox.Header>
                    <TextBlock Text="安全位置" Style="{StaticResource SectionHeader}"/>
                </GroupBox.Header>
                <StackPanel>
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Z 換刀高度：" Style="{StaticResource ParamLabel}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBox Style="{StaticResource ParamTextBox}"
                                     Text="{Binding ZToolChangeHeight, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="mm" Style="{StaticResource UnitLabel}"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Z 安全高度：" Style="{StaticResource ParamLabel}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBox Style="{StaticResource ParamTextBox}"
                                     Text="{Binding ZClearanceHeight, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="mm" Style="{StaticResource UnitLabel}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </GroupBox>

            <!-- [2026-03-06] TIMING section -->
            <GroupBox Style="{StaticResource SettingsGroupBox}"
                      Visibility="{Binding ShowTimingParams, Converter={StaticResource BoolToVis}}">
                <GroupBox.Header>
                    <TextBlock Text="時序設定" Style="{StaticResource SectionHeader}"/>
                </GroupBox.Header>
                <StackPanel>
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="夾刀延遲：" Style="{StaticResource ParamLabel}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBox Style="{StaticResource ParamTextBox}"
                                     Text="{Binding ClampDwell, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="ms" Style="{StaticResource UnitLabel}"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="鬆刀延遲：" Style="{StaticResource ParamLabel}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBox Style="{StaticResource ParamTextBox}"
                                     Text="{Binding UnclampDwell, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="ms" Style="{StaticResource UnitLabel}"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="吹氣延遲：" Style="{StaticResource ParamLabel}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBox Style="{StaticResource ParamTextBox}"
                                     Text="{Binding AirBlowDwell, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="ms" Style="{StaticResource UnitLabel}"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="感測器逾時：" Style="{StaticResource ParamLabel}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBox Style="{StaticResource ParamTextBox}"
                                     Text="{Binding SensorTimeout, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="ms" Style="{StaticResource UnitLabel}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </GroupBox>

            <!-- [2026-03-06] RACK PARAMETERS section -->
            <GroupBox Style="{StaticResource SettingsGroupBox}"
                      Visibility="{Binding ShowRackParams, Converter={StaticResource BoolToVis}}">
                <GroupBox.Header>
                    <TextBlock Text="排刀架參數" Style="{StaticResource SectionHeader}"/>
                </GroupBox.Header>
                <StackPanel>
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="移動速度：" Style="{StaticResource ParamLabel}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBox Style="{StaticResource ParamTextBox}"
                                     Text="{Binding RackTraverseSpeed, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="mm/min" Style="{StaticResource UnitLabel}"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="刀位 1 X / Y：" Style="{StaticResource ParamLabel}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBox Style="{StaticResource ParamTextBox}"
                                     Text="{Binding RackPocket1X, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Style="{StaticResource ParamTextBox}" Margin="10,0,0,0"
                                     Text="{Binding RackPocket1Y, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="刀位 2 X / Y：" Style="{StaticResource ParamLabel}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBox Style="{StaticResource ParamTextBox}"
                                     Text="{Binding RackPocket2X, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Style="{StaticResource ParamTextBox}" Margin="10,0,0,0"
                                     Text="{Binding RackPocket2Y, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="安全間距 X / Y：" Style="{StaticResource ParamLabel}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBox Style="{StaticResource ParamTextBox}"
                                     Text="{Binding RackClearanceX, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Style="{StaticResource ParamTextBox}" Margin="10,0,0,0"
                                     Text="{Binding RackClearanceY, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </GroupBox>

        </StackPanel>
    </ScrollViewer>
</UserControl>
