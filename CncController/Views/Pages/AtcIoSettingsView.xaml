<!-- [2026-03-06] ATC IO Settings View - DO/DI pin configuration for ATC -->
<UserControl x:Class="CncController.Views.Pages.AtcIoSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="500"
             FontFamily="{DynamicResource FontFamily.Default}">

    <!-- [2026-03-06] DataContext is set by parent (AtcIoSettingsViewModel) -->

    <UserControl.Resources>
        <!-- [2026-03-06] Dark theme GroupBox style -->
        <Style x:Key="DarkGroupBox" TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="10,5"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="{DynamicResource FontSize.Medium}" FontWeight="Bold" Foreground="#5E70FF"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- [2026-03-06] Label style -->
        <Style x:Key="IoLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Medium}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>

        <!-- [2026-03-06] Pin ComboBox style -->
        <!-- [2026-03-06] Pin ComboBox style (dark theme) -->
        <Style x:Key="PinCombo" TargetType="ComboBox">
            <Setter Property="Width" Value="80"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Medium}"/>
            <Setter Property="FontFamily" Value="{DynamicResource FontFamily.Default}"/>
            <Setter Property="Height" Value="30"/>
        </Style>

        <!-- [2026-03-06] Section header style -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AAA"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#1E1E1E">
        <StackPanel Margin="5">

            <!-- [2026-03-06] IO MODULE section -->
            <GroupBox Header="IO MODULE" Style="{StaticResource DarkGroupBox}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="EtherCAT IO Slave:" Style="{StaticResource IoLabel}" Margin="0,4,10,4"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding AvailableIoSlaves}"
                              SelectedItem="{Binding SelectedIoSlave}"
                              DisplayMemberPath="Name"
                              Margin="0,4"
                              VerticalAlignment="Center"
                              FontSize="{DynamicResource FontSize.Medium}" Height="30" Foreground="Black"/>
                </Grid>
            </GroupBox>

            <!-- [2026-03-06] DIGITAL OUTPUTS (DO) section -->
            <GroupBox Header="DIGITAL OUTPUTS (DO)" Style="{StaticResource DarkGroupBox}">
                <StackPanel>

                    <!-- [2026-03-06] Carousel DO pins (visible when ShowCarouselIo) -->
                    <StackPanel Visibility="{Binding ShowCarouselIo, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="-- Carousel --" Style="{StaticResource SectionHeader}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="DO Carousel Out:" Style="{StaticResource IoLabel}" Margin="0,4,10,4"/>
                            <ComboBox  Grid.Row="0" Grid.Column="1" Style="{StaticResource PinCombo}"
                                       ItemsSource="{Binding AvailablePins}" SelectedItem="{Binding DoCarouselOut}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="DO Carousel Home:" Style="{StaticResource IoLabel}" Margin="0,4,10,4"/>
                            <ComboBox  Grid.Row="1" Grid.Column="1" Style="{StaticResource PinCombo}"
                                       ItemsSource="{Binding AvailablePins}" SelectedItem="{Binding DoCarouselHome}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="DO Motor FWD:" Style="{StaticResource IoLabel}" Margin="0,4,10,4"/>
                            <ComboBox  Grid.Row="2" Grid.Column="1" Style="{StaticResource PinCombo}"
                                       ItemsSource="{Binding AvailablePins}" SelectedItem="{Binding DoMotorFwd}"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="DO Motor REV:" Style="{StaticResource IoLabel}" Margin="0,4,10,4"/>
                            <ComboBox  Grid.Row="3" Grid.Column="1" Style="{StaticResource PinCombo}"
                                       ItemsSource="{Binding AvailablePins}" SelectedItem="{Binding DoMotorRev}"/>
                        </Grid>
                    </StackPanel>

                    <!-- [2026-03-06] Drawbar DO pins (visible when ShowDrawbarIo) -->
                    <StackPanel Visibility="{Binding ShowDrawbarIo, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="-- Drawbar --" Style="{StaticResource SectionHeader}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="DO Drawbar:" Style="{StaticResource IoLabel}" Margin="0,4,10,4"/>
                            <ComboBox  Grid.Row="0" Grid.Column="1" Style="{StaticResource PinCombo}"
                                       ItemsSource="{Binding AvailablePins}" SelectedItem="{Binding DoDrawbar}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="DO Air Blow:" Style="{StaticResource IoLabel}" Margin="0,4,10,4"/>
                            <ComboBox  Grid.Row="1" Grid.Column="1" Style="{StaticResource PinCombo}"
                                       ItemsSource="{Binding AvailablePins}" SelectedItem="{Binding DoAirBlow}"/>
                        </Grid>
                    </StackPanel>

                </StackPanel>
            </GroupBox>

            <!-- [2026-03-06] DIGITAL INPUTS (DI) section -->
            <GroupBox Header="DIGITAL INPUTS (DI)" Style="{StaticResource DarkGroupBox}">
                <StackPanel>

                    <!-- [2026-03-06] Carousel DI pins (visible when ShowCarouselIo) -->
                    <StackPanel Visibility="{Binding ShowCarouselIo, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="-- Carousel --" Style="{StaticResource SectionHeader}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="DI Carousel Home:" Style="{StaticResource IoLabel}" Margin="0,4,10,4"/>
                            <ComboBox  Grid.Row="0" Grid.Column="1" Style="{StaticResource PinCombo}"
                                       ItemsSource="{Binding AvailablePins}" SelectedItem="{Binding DiCarouselHome}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="DI Carousel Out:" Style="{StaticResource IoLabel}" Margin="0,4,10,4"/>
                            <ComboBox  Grid.Row="1" Grid.Column="1" Style="{StaticResource PinCombo}"
                                       ItemsSource="{Binding AvailablePins}" SelectedItem="{Binding DiCarouselOut}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="DI Rotation Index:" Style="{StaticResource IoLabel}" Margin="0,4,10,4"/>
                            <ComboBox  Grid.Row="2" Grid.Column="1" Style="{StaticResource PinCombo}"
                                       ItemsSource="{Binding AvailablePins}" SelectedItem="{Binding DiRotationIndex}"/>
                        </Grid>
                    </StackPanel>

                    <!-- [2026-03-06] Drawbar DI pins (visible when ShowDrawbarIo) -->
                    <StackPanel Visibility="{Binding ShowDrawbarIo, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="-- Drawbar --" Style="{StaticResource SectionHeader}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="DI Drawbar Clamp:" Style="{StaticResource IoLabel}" Margin="0,4,10,4"/>
                            <ComboBox  Grid.Row="0" Grid.Column="1" Style="{StaticResource PinCombo}"
                                       ItemsSource="{Binding AvailablePins}" SelectedItem="{Binding DiDrawbarClamp}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="DI Drawbar Unclamp:" Style="{StaticResource IoLabel}" Margin="0,4,10,4"/>
                            <ComboBox  Grid.Row="1" Grid.Column="1" Style="{StaticResource PinCombo}"
                                       ItemsSource="{Binding AvailablePins}" SelectedItem="{Binding DiDrawbarUnclamp}"/>
                        </Grid>
                    </StackPanel>

                </StackPanel>
            </GroupBox>

        </StackPanel>
    </ScrollViewer>
</UserControl>
