<!-- [2026-03-06] ATC IO Settings View - DO/DI pin configuration for ATC -->
<!-- [2026-03-10] 全部標籤改繁體中文 -->
<UserControl x:Class="CncController.Views.Pages.AtcIoSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="500"
             FontFamily="{DynamicResource FontFamily.Default}">

    <UserControl.Resources>
        <Style x:Key="DarkGroupBox" TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="10,5"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="{DynamicResource FontSize.Medium}" FontWeight="Bold" Foreground="#5E70FF"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IoLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Medium}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>

        <!-- [2026-03-10] HorizontalAlignment=Left 讓 ComboBox 緊貼標籤旁邊 -->
        <Style x:Key="PinCombo" TargetType="ComboBox">
            <Setter Property="Width" Value="80"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Medium}"/>
            <Setter Property="FontFamily" Value="{DynamicResource FontFamily.Default}"/>
            <Setter Property="Height" Value="30"/>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AAA"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#1E1E1E">
        <StackPanel Margin="5">

            <!-- IO 模組 -->
            <GroupBox Header="IO 模組" Style="{StaticResource DarkGroupBox}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="EtherCAT IO 站號：" Style="{StaticResource IoLabel}" Margin="0,4,10,4"/>
                    <!-- [2026-03-10] HorizontalAlignment=Left 緊貼標籤 -->
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding AvailableIoSlaves}"
                              SelectedItem="{Binding SelectedIoSlave}"
                              DisplayMemberPath="DisplayName"
                              Margin="0,4"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Left"
                              FontSize="{DynamicResource FontSize.Medium}" Height="30" Foreground="Black"/>
                </Grid>
            </GroupBox>

            <!-- 數位輸出 (DO) -->
            <GroupBox Header="數位輸出 (DO)" Style="{StaticResource DarkGroupBox}">
                <StackPanel>

                    <!-- 刀盤 DO -->
                    <StackPanel Visibility="{Binding ShowCarouselIo, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="── 刀盤 ──" Style="{StaticResource SectionHeader}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="DO 刀盤伸出：" Style="{StaticResource IoLabel}" Margin="0,4,10,4"/>
                            <ComboBox  Grid.Row="0" Grid.Column="1" Style="{StaticResource PinCombo}"
                                       ItemsSource="{Binding AvailablePins}" SelectedItem="{Binding DoCarouselOut}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="DO 刀盤歸位：" Style="{StaticResource IoLabel}" Margin="0,4,10,4"/>
                            <ComboBox  Grid.Row="1" Grid.Column="1" Style="{StaticResource PinCombo}"
                                       ItemsSource="{Binding AvailablePins}" SelectedItem="{Binding DoCarouselHome}"/>
                        </Grid>
                    </StackPanel>

                    <!-- 馬達 DO（IO 模式） -->
                    <StackPanel Visibility="{Binding ShowMotorIo, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="── 馬達（IO 模式）──" Style="{StaticResource SectionHeader}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="DO 馬達正轉：" Style="{StaticResource IoLabel}" Margin="0,4,10,4"/>
                            <ComboBox  Grid.Row="0" Grid.Column="1" Style="{StaticResource PinCombo}"
                                       ItemsSource="{Binding AvailablePins}" SelectedItem="{Binding DoMotorFwd}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="DO 馬達反轉：" Style="{StaticResource IoLabel}" Margin="0,4,10,4"/>
                            <ComboBox  Grid.Row="1" Grid.Column="1" Style="{StaticResource PinCombo}"
                                       ItemsSource="{Binding AvailablePins}" SelectedItem="{Binding DoMotorRev}"/>
                        </Grid>
                    </StackPanel>

                    <!-- 拉刀桿 DO -->
                    <StackPanel Visibility="{Binding ShowDrawbarIo, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="── 拉刀桿 ──" Style="{StaticResource SectionHeader}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="DO 拉刀桿：" Style="{StaticResource IoLabel}" Margin="0,4,10,4"/>
                            <ComboBox  Grid.Row="0" Grid.Column="1" Style="{StaticResource PinCombo}"
                                       ItemsSource="{Binding AvailablePins}" SelectedItem="{Binding DoDrawbar}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="DO 吹氣：" Style="{StaticResource IoLabel}" Margin="0,4,10,4"/>
                            <ComboBox  Grid.Row="1" Grid.Column="1" Style="{StaticResource PinCombo}"
                                       ItemsSource="{Binding AvailablePins}" SelectedItem="{Binding DoAirBlow}"/>
                        </Grid>
                    </StackPanel>

                </StackPanel>
            </GroupBox>

            <!-- 數位輸入 (DI) -->
            <GroupBox Header="數位輸入 (DI)" Style="{StaticResource DarkGroupBox}">
                <StackPanel>

                    <!-- 刀盤 DI -->
                    <StackPanel Visibility="{Binding ShowCarouselIo, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="── 刀盤 ──" Style="{StaticResource SectionHeader}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="DI 刀盤原點：" Style="{StaticResource IoLabel}" Margin="0,4,10,4"/>
                            <ComboBox  Grid.Row="0" Grid.Column="1" Style="{StaticResource PinCombo}"
                                       ItemsSource="{Binding AvailablePins}" SelectedItem="{Binding DiCarouselHome}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="DI 刀盤伸出：" Style="{StaticResource IoLabel}" Margin="0,4,10,4"/>
                            <ComboBox  Grid.Row="1" Grid.Column="1" Style="{StaticResource PinCombo}"
                                       ItemsSource="{Binding AvailablePins}" SelectedItem="{Binding DiCarouselOut}"/>
                        </Grid>
                    </StackPanel>

                    <!-- 旋轉定位 DI（IO 模式） -->
                    <StackPanel Visibility="{Binding ShowMotorIo, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="── 旋轉定位（IO 模式）──" Style="{StaticResource SectionHeader}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="DI 旋轉定位：" Style="{StaticResource IoLabel}" Margin="0,4,10,4"/>
                            <ComboBox  Grid.Column="1" Style="{StaticResource PinCombo}"
                                       ItemsSource="{Binding AvailablePins}" SelectedItem="{Binding DiRotationIndex}"/>
                        </Grid>
                    </StackPanel>

                    <!-- 拉刀桿 DI -->
                    <StackPanel Visibility="{Binding ShowDrawbarIo, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="── 拉刀桿 ──" Style="{StaticResource SectionHeader}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="DI 夾刀確認：" Style="{StaticResource IoLabel}" Margin="0,4,10,4"/>
                            <ComboBox  Grid.Row="0" Grid.Column="1" Style="{StaticResource PinCombo}"
                                       ItemsSource="{Binding AvailablePins}" SelectedItem="{Binding DiDrawbarClamp}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="DI 鬆刀確認：" Style="{StaticResource IoLabel}" Margin="0,4,10,4"/>
                            <ComboBox  Grid.Row="1" Grid.Column="1" Style="{StaticResource PinCombo}"
                                       ItemsSource="{Binding AvailablePins}" SelectedItem="{Binding DiDrawbarUnclamp}"/>
                        </Grid>
                    </StackPanel>

                </StackPanel>
            </GroupBox>

        </StackPanel>
    </ScrollViewer>
</UserControl>
