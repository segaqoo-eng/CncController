<!-- [2026-03-06] 完全重寫 AtcView：斗笠式（Umbrella/Carousel）ATC 畫面
     四欄佈局（280/Auto/*/230）：按鈕 | 轉盤 | 主軸刀具 | 自動控制面板
     底部 MDI -->
<UserControl x:Class="CncController.Views.Pages.AtcView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:CncController.ViewModels"
             xmlns:controls="clr-namespace:CncController.Views.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AtcViewModel}"
             FontFamily="{DynamicResource FontFamily.Default}"
             d:DesignHeight="700" d:DesignWidth="1700">

    <UserControl.Resources>
        <!-- [2026-03-06] AtcBtnStyle：繼承全域 BaseBtnStyle，覆寫尺寸為 Small -->
        <Style x:Key="AtcBtnStyle" TargetType="Button" BasedOn="{StaticResource BaseBtnStyle}">
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}"/>
            <Setter Property="Padding" Value="{DynamicResource BtnPadding.Small}"/>
            <Setter Property="Margin" Value="3"/>
        </Style>

        <!-- [2026-03-06] PanelBtnStyle：繼承 AtcBtnStyle，右側面板大按鈕 -->
        <Style x:Key="PanelBtnStyle" TargetType="Button" BasedOn="{StaticResource AtcBtnStyle}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}"/>
            <Setter Property="Margin" Value="4,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <!-- [2026-03-06] ModeToggleStyle：繼承全域 BaseRadioBtnStyle，覆寫尺寸為 Small -->
        <Style x:Key="ModeToggleStyle" TargetType="RadioButton" BasedOn="{StaticResource BaseRadioBtnStyle}">
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}"/>
            <Setter Property="Padding" Value="{DynamicResource BtnPadding.Small}"/>
            <Setter Property="Margin" Value="2"/>
        </Style>
    </UserControl.Resources>

    <!-- [2026-03-06] 最外層：純色深色背景（不使用 ATC_Back.png） -->
    <Grid Background="#252526" ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ====== 主體三欄 ====== -->
        <Grid Grid.Row="0" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="230"/>
            </Grid.ColumnDefinitions>

            <!-- ======================================================================
                 左欄（Col 0）：垂直標籤 + 模式切換 Tab + MANUAL ATC / PROGRAM TOOLS
                 ====================================================================== -->
            <!-- [2026-03-06] Col 0: MANUAL/PROGRAM panel (match PB UN_BIG3/UN_BIG4) -->
            <DockPanel Grid.Column="0">

                <!-- Left vertical label -->
                <Border DockPanel.Dock="Left" Background="#DD333333" Width="22" CornerRadius="3,0,0,3"
                        BorderBrush="#555" BorderThickness="1,1,0,1">
                    <TextBlock Text="CAROUSEL ATC" Foreground="#AAA" FontSize="{DynamicResource FontSize.Small}" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.LayoutTransform>
                            <RotateTransform Angle="-90"/>
                        </TextBlock.LayoutTransform>
                    </TextBlock>
                </Border>

                <!-- [2026-03-06] Grid fills full height -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Mode toggle tabs (match PB style) -->
                    <UniformGrid Grid.Row="0" Rows="1" Columns="2" Margin="0,0,0,4">
                        <RadioButton Content="PROGRAM TOOLS" Style="{StaticResource ModeToggleStyle}"
                                     GroupName="AtcMode" FontSize="{DynamicResource FontSize.Body}" Padding="8,8"
                                     IsChecked="{Binding IsProgramMode, Mode=OneWay}"
                                     Command="{Binding SwitchModeCommand}" CommandParameter="ProgramTools"/>
                        <RadioButton Content="MANUAL ATC" Style="{StaticResource ModeToggleStyle}"
                                     GroupName="AtcMode" FontSize="{DynamicResource FontSize.Body}" Padding="8,8"
                                     IsChecked="{Binding IsManualMode, Mode=OneWay}"
                                     Command="{Binding SwitchModeCommand}" CommandParameter="ManualAtc"/>
                    </UniformGrid>

                    <!-- ===== MANUAL ATC (UN_BIG4: top 8 btns 2-col + bottom 3 full-width) ===== -->
                    <Border Grid.Row="1" Background="#DD2D2D2D" BorderBrush="#444" BorderThickness="1"
                            CornerRadius="4" Padding="10"
                            Visibility="{Binding IsManualMode, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- [2026-03-06] 8 buttons, 2 columns, uniformly distributed -->
                            <UniformGrid Grid.Row="0" Rows="4" Columns="2" Margin="0,0,0,8">
                                <Button Content="&#x21B6; ATC REV" Style="{StaticResource AtcBtnStyle}"
                                        Command="{Binding AtcRevCommand}" FontSize="{DynamicResource FontSize.Body}" Padding="6,10" Margin="3,4"/>
                                <Button Content="ATC FWD &#x21B7;" Style="{StaticResource AtcBtnStyle}"
                                        Command="{Binding AtcFwdCommand}" FontSize="{DynamicResource FontSize.Body}" Padding="6,10" Margin="3,4"/>
                                <Button Content="&#x25C0; ATC RETRACT" Style="{StaticResource AtcBtnStyle}"
                                        Command="{Binding RetractAtcCommand}" FontSize="{DynamicResource FontSize.Body}" Padding="6,10" Margin="3,4"/>
                                <Button Content="ATC EXTEND &#x25B6;" Style="{StaticResource AtcBtnStyle}"
                                        Command="{Binding ExtendAtcCommand}" FontSize="{DynamicResource FontSize.Body}" Padding="6,10" Margin="3,4"/>
                                <Button Content="CLAMP TOOL" Style="{StaticResource AtcBtnStyle}"
                                        Command="{Binding ClampToolCommand}" FontSize="{DynamicResource FontSize.Body}" Padding="6,10" Margin="3,4"/>
                                <Button Content="RELEASE TOOL" Style="{StaticResource AtcBtnStyle}"
                                        Command="{Binding ReleaseToolCommand}" FontSize="{DynamicResource FontSize.Body}" Padding="6,10" Margin="3,4"/>
                                <Button Content="ORIENT SPINDLE" Style="{StaticResource AtcBtnStyle}"
                                        Command="{Binding OrientSpindleCommand}" FontSize="{DynamicResource FontSize.Body}" Padding="6,10" Margin="3,4"/>
                                <Button Content="UNLOCK SPINDLE" Style="{StaticResource AtcBtnStyle}"
                                        Command="{Binding UnlockSpindleCommand}" FontSize="{DynamicResource FontSize.Body}" Padding="6,10" Margin="3,4"/>
                            </UniformGrid>

                            <!-- [2026-03-06] 3 full-width buttons at bottom (match UN_BIG4) -->
                            <StackPanel Grid.Row="1">
                                <Button Content="MOVE HEAD ABOVE CAROUSEL" Style="{StaticResource AtcBtnStyle}"
                                        Command="{Binding MoveHeadAboveCarouselCommand}"
                                        HorizontalAlignment="Stretch" FontSize="{DynamicResource FontSize.Body}" Padding="8,12" Margin="3,4"/>
                                <Button Content="MOVE TOOL TO CAROUSEL HEIGHT" Style="{StaticResource AtcBtnStyle}"
                                        Command="{Binding MoveToolToCarouselHeightCommand}"
                                        HorizontalAlignment="Stretch" FontSize="{DynamicResource FontSize.Body}" Padding="8,12" Margin="3,4"/>
                                <Button Content="REF CAROUSEL" Style="{StaticResource AtcBtnStyle}"
                                        Command="{Binding RefCarouselCommand}"
                                        HorizontalAlignment="Stretch" Background="#445588"
                                        FontSize="{DynamicResource FontSize.Medium}" Padding="8,14" Margin="3,8,3,3"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ===== PROGRAM TOOLS (UN_BIG3: title + list fills height + REF at bottom) ===== -->
                    <Border Grid.Row="1" Background="#DD2D2D2D" BorderBrush="#444" BorderThickness="1"
                            CornerRadius="4" Padding="10"
                            Visibility="{Binding IsProgramMode, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- [2026-03-06] Title bar -->
                            <Border Grid.Row="0" Background="#444" CornerRadius="3" Padding="8,8" Margin="0,0,0,8">
                                <TextBlock Text="CURRENT PROGRAM TOOLS" Foreground="White"
                                           FontSize="{DynamicResource FontSize.Medium}" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </Border>

                            <!-- [2026-03-06] Tool list (fills remaining space) -->
                            <ListBox Grid.Row="1" ItemsSource="{Binding ProgramTools}"
                                     Background="#2D2D2D" Foreground="White"
                                     BorderBrush="#555" BorderThickness="1"
                                     FontSize="{DynamicResource FontSize.Large}" FontWeight="Bold" FontFamily="Consolas"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"/>

                            <!-- [2026-03-06] REF CAROUSEL at bottom -->
                            <Button Grid.Row="2" Content="REF CAROUSEL" Style="{StaticResource AtcBtnStyle}"
                                    Command="{Binding RefCarouselCommand}"
                                    HorizontalAlignment="Stretch" Background="#445588"
                                    FontSize="{DynamicResource FontSize.Medium}" Padding="8,14" Margin="0,8,0,0"/>
                        </Grid>
                    </Border>
                </Grid>
            </DockPanel>

            <!-- ======================================================================
                 Col 1：CarouselControl 齒輪轉盤（500x500，緊鄰按鈕面板）
                 ====================================================================== -->
            <controls:CarouselControl Grid.Column="1"
                ToolCount="12"
                CurrentAngle="{Binding CarouselAngle}"
                CurrentPocket="{Binding CurrentPocket}"
                IsReferenced="{Binding IsReferenced}"
                Slots="{Binding SlotInfos}"
                Width="560" Height="560"
                VerticalAlignment="Center" Margin="6,0"/>

            <!-- ======================================================================
                 Col 2：SpindleToolControl 主軸刀具顯示（Viewbox 自適應放大）
                 ====================================================================== -->
            <Viewbox Grid.Column="2" MaxHeight="550" MaxWidth="300"
                     VerticalAlignment="Center" HorizontalAlignment="Center"
                     Stretch="Uniform" Margin="10,0">
                <controls:SpindleToolControl
                    ToolNumber="{Binding MachineStatus.ToolNumber, Mode=OneWay}"/>
            </Viewbox>

            <!-- ======================================================================
                 Col 3：ATC AUTOMATIC CONTROL PANEL
                 ====================================================================== -->
            <StackPanel Grid.Column="3" VerticalAlignment="Top">

                <!-- [2026-03-06] ATC AUTOMATIC CONTROL PANEL 標題（深藍底） -->
                <Border Background="#1A5276" CornerRadius="3" Padding="8,5" Margin="0,0,0,6"
                        BorderBrush="#2980B9" BorderThickness="1">
                    <TextBlock Text="ATC AUTOMATIC&#x0a;CONTROL PANEL" Foreground="White"
                               FontSize="{DynamicResource FontSize.Body}" FontWeight="Bold" HorizontalAlignment="Center"
                               TextAlignment="Center"/>
                </Border>

                <!-- [2026-03-06] [n] LOAD SPINDLE -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="White" CornerRadius="2" Margin="0,0,4,0"
                            BorderBrush="#666" BorderThickness="1">
                        <TextBox Text="{Binding ChangeToolNumber, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" Foreground="Black" FontSize="{DynamicResource FontSize.Medium}" FontWeight="Bold"
                                 TextAlignment="Center" BorderThickness="0" VerticalContentAlignment="Center"
                                 Padding="2"/>
                    </Border>
                    <Button Grid.Column="1" Content="LOAD SPINDLE" Style="{StaticResource PanelBtnStyle}"
                            Command="{Binding LoadSpindleCommand}" Background="#444" BorderBrush="#666"/>
                </Grid>

                <!-- [2026-03-06] UNLOAD SPINDLE -->
                <Button Content="UNLOAD SPINDLE" Style="{StaticResource PanelBtnStyle}"
                        Command="{Binding UnloadSpindleCommand}" Background="#444" BorderBrush="#666"/>

                <Separator Background="#444" Margin="0,6"/>

                <!-- [2026-03-06] 方向鍵面板（上下左右） -->
                <Grid Margin="4,4" HorizontalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>

                    <!-- UP -->
                    <Button Grid.Row="0" Grid.Column="1" Content="&#x25B2;" Style="{StaticResource PanelBtnStyle}"
                            Command="{Binding HeadUpCommand}" FontSize="{DynamicResource FontSize.Large}" Height="40" Width="50"/>
                    <!-- LEFT -->
                    <Button Grid.Row="1" Grid.Column="0" Content="&#x25C0;" Style="{StaticResource PanelBtnStyle}"
                            Command="{Binding AtcRevCommand}" FontSize="{DynamicResource FontSize.Large}" Height="40" Width="50"/>
                    <!-- RIGHT -->
                    <Button Grid.Row="1" Grid.Column="2" Content="&#x25B6;" Style="{StaticResource PanelBtnStyle}"
                            Command="{Binding AtcFwdCommand}" FontSize="{DynamicResource FontSize.Large}" Height="40" Width="50"/>
                    <!-- DOWN -->
                    <Button Grid.Row="2" Grid.Column="1" Content="&#x25BC;" Style="{StaticResource PanelBtnStyle}"
                            Command="{Binding HeadDownCommand}" FontSize="{DynamicResource FontSize.Large}" Height="40" Width="50"/>
                </Grid>

                <Separator Background="#444" Margin="0,6"/>

                <!-- [2026-03-06] ELECTRONIC TOOL SETTER -->
                <Button Content="ELECTRONIC TOOL SETTER" Style="{StaticResource PanelBtnStyle}"
                        Command="{Binding ElectronicToolSetterCommand}" Background="#444" BorderBrush="#666"/>

                <!-- [2026-03-06] TOUCH OFF CURRENT TOOL -->
                <Button Content="TOUCH OFF CURRENT TOOL" Style="{StaticResource PanelBtnStyle}"
                        Command="{Binding TouchOffCurrentToolCommand}" Background="#444" BorderBrush="#666"/>

                <!-- [2026-03-06] [n] M6 G43 -->
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="White" CornerRadius="2" Margin="0,0,4,0"
                            BorderBrush="#666" BorderThickness="1">
                        <TextBox Text="{Binding ChangeToolNumber, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" Foreground="Black" FontSize="{DynamicResource FontSize.Medium}" FontWeight="Bold"
                                 TextAlignment="Center" BorderThickness="0" VerticalContentAlignment="Center"
                                 Padding="2"/>
                    </Border>
                    <Button Grid.Column="1" Content="M6 G43" Style="{StaticResource PanelBtnStyle}"
                            Command="{Binding M6G43Command}" Background="#444" BorderBrush="#666"/>
                </Grid>
            </StackPanel>
        </Grid>

        <!-- ======================================================================
             底部 MDI 欄
             ====================================================================== -->
        <Border Grid.Row="1" Background="#DD333333" CornerRadius="3" Padding="6,4"
                Margin="10,0,10,10" BorderBrush="#666" BorderThickness="1">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="MDI" Foreground="#CCC"
                           FontSize="{DynamicResource FontSize.Body}" FontWeight="Bold" VerticalAlignment="Center"
                           Margin="0,0,6,0"/>
                <Button DockPanel.Dock="Right" Content="SEND" Style="{StaticResource AtcBtnStyle}"
                        Command="{Binding SendMdiCommand}" Width="60" Margin="4,0,0,0"/>
                <TextBox Text="{Binding MdiInput, UpdateSourceTrigger=PropertyChanged}"
                         Background="White" Foreground="Black" FontSize="{DynamicResource FontSize.Body}" Padding="6,3"
                         BorderBrush="#888" BorderThickness="1">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding SendMdiCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
