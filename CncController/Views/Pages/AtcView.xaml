<!-- [2026-03-06] 完全重寫 AtcView：斗笠式（Umbrella/Carousel）ATC 畫面
     四欄佈局（280/Auto/*/230）：按鈕 | 轉盤 | 主軸刀具 | 自動控制面板
     底部 MDI -->
<UserControl x:Class="CncController.Views.Pages.AtcView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:CncController.ViewModels"
             xmlns:controls="clr-namespace:CncController.Views.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AtcViewModel}"
             FontFamily="{DynamicResource FontFamily.Default}"
             d:DesignHeight="700" d:DesignWidth="1700">

    <UserControl.Resources>
        <!-- [2026-03-06] AtcBtnStyle：繼承全域 BaseBtnStyle，覆寫尺寸為 Small -->
        <Style x:Key="AtcBtnStyle" TargetType="Button" BasedOn="{StaticResource BaseBtnStyle}">
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}"/>
            <Setter Property="Padding" Value="{DynamicResource BtnPadding.Small}"/>
            <Setter Property="Margin" Value="3"/>
        </Style>

        <!-- [2026-03-06] PanelBtnStyle：繼承 AtcBtnStyle，右側面板大按鈕 -->
        <Style x:Key="PanelBtnStyle" TargetType="Button" BasedOn="{StaticResource AtcBtnStyle}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}"/>
            <Setter Property="Margin" Value="4,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <!-- [2026-03-06] ModeToggleStyle：繼承全域 BaseRadioBtnStyle，覆寫尺寸為 Small -->
        <Style x:Key="ModeToggleStyle" TargetType="RadioButton" BasedOn="{StaticResource BaseRadioBtnStyle}">
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}"/>
            <Setter Property="Padding" Value="{DynamicResource BtnPadding.Small}"/>
            <Setter Property="Margin" Value="2"/>
        </Style>
    </UserControl.Resources>

    <!-- [2026-03-06] 最外層：純色深色背景（不使用 ATC_Back.png） -->
    <Grid Background="{DynamicResource Brush.Panel.Secondary}" ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ====== 主體三欄 ====== -->
        <Grid Grid.Row="0" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="230"/>
            </Grid.ColumnDefinitions>

            <!-- ======================================================================
                 左欄（Col 0）：垂直標籤 + 模式切換 Tab + MANUAL ATC / PROGRAM TOOLS
                 ====================================================================== -->
            <!-- [2026-03-06] Col 0: MANUAL/PROGRAM panel (match PB UN_BIG3/UN_BIG4) -->
            <DockPanel Grid.Column="0">

                <!-- Left vertical label -->
                <Border DockPanel.Dock="Left" Background="{DynamicResource Brush.Panel.Overlay}" Width="22" CornerRadius="3,0,0,3"
                        BorderBrush="{DynamicResource Brush.Btn.Border}" BorderThickness="1,1,0,1">
                    <TextBlock Text="{DynamicResource Str.Atc.UmbrellaAtc}" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="{DynamicResource FontSize.Small}" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.LayoutTransform>
                            <RotateTransform Angle="-90"/>
                        </TextBlock.LayoutTransform>
                    </TextBlock>
                </Border>

                <!-- [2026-03-06] Grid fills full height -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Mode toggle tabs (match PB style) -->
                    <UniformGrid Grid.Row="0" Rows="1" Columns="2" Margin="0,0,0,4">
                        <RadioButton Content="{DynamicResource Str.Atc.ProgramTools}" Style="{StaticResource ModeToggleStyle}"
                                     GroupName="AtcMode" FontSize="{DynamicResource FontSize.Body}" Padding="8,8"
                                     IsChecked="{Binding IsProgramMode, Mode=OneWay}"
                                     Command="{Binding SwitchModeCommand}" CommandParameter="ProgramTools"/>
                        <RadioButton Content="{DynamicResource Str.Atc.ManualAtc}" Style="{StaticResource ModeToggleStyle}"
                                     GroupName="AtcMode" FontSize="{DynamicResource FontSize.Body}" Padding="8,8"
                                     IsChecked="{Binding IsManualMode, Mode=OneWay}"
                                     Command="{Binding SwitchModeCommand}" CommandParameter="ManualAtc"/>
                    </UniformGrid>

                    <!-- ===== MANUAL ATC (UN_BIG4: top 8 btns 2-col + bottom 3 full-width) ===== -->
                    <Border Grid.Row="1" Background="{DynamicResource Brush.Panel.Overlay}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                            CornerRadius="4" Padding="10"
                            Visibility="{Binding IsManualMode, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- [2026-03-10] 8 buttons, 2 columns — DO 開啟時按鈕反白（藍色高亮） -->
                            <UniformGrid Grid.Row="0" Rows="4" Columns="2" Margin="0,0,0,8">
                                <!-- [2026-03-16] 按鈕防呆 -->
                                <!-- 刀盤反轉（馬達反轉 DO） -->
                                <Button Content="{DynamicResource Str.Atc.CarouselRev}"
                                        Command="{Binding AtcRevCommand}" FontSize="{DynamicResource FontSize.Body}" Padding="6,10" Margin="3,4">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource AtcBtnStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMotorRev}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.StatusOn}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding DataContext.CanAtc, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <!-- 刀盤正轉（馬達正轉 DO） -->
                                <Button Content="{DynamicResource Str.Atc.CarouselFwd}"
                                        Command="{Binding AtcFwdCommand}" FontSize="{DynamicResource FontSize.Body}" Padding="6,10" Margin="3,4">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource AtcBtnStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMotorFwd}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.StatusOn}"/>
                                                </DataTrigger>
                                                <!-- [2026-03-16] 按鈕防呆 -->
                                                <DataTrigger Binding="{Binding DataContext.CanAtc, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <!-- 刀盤收回（CarouselHome DO） -->
                                <Button Content="{DynamicResource Str.Atc.RetractAtc}"
                                        Command="{Binding RetractAtcCommand}" FontSize="{DynamicResource FontSize.Body}" Padding="6,10" Margin="3,4">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource AtcBtnStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCarouselHome}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.StatusOn}"/>
                                                </DataTrigger>
                                                <!-- [2026-03-16] 按鈕防呆 -->
                                                <DataTrigger Binding="{Binding DataContext.CanAtc, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <!-- 刀盤伸出（CarouselOut DO） -->
                                <Button Content="{DynamicResource Str.Atc.ExtendAtc}"
                                        Command="{Binding ExtendAtcCommand}" FontSize="{DynamicResource FontSize.Body}" Padding="6,10" Margin="3,4">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource AtcBtnStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCarouselOut}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.StatusOn}"/>
                                                </DataTrigger>
                                                <!-- [2026-03-16] 按鈕防呆 -->
                                                <DataTrigger Binding="{Binding DataContext.CanAtc, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <!-- [2026-03-10] 夾刀（Drawbar DO OFF = 彈簧夾緊 = IsDrawbarOn=False） -->
                                <Button Content="{DynamicResource Str.Atc.ClampTool}"
                                        Command="{Binding ClampToolCommand}" FontSize="{DynamicResource FontSize.Body}" Padding="6,10" Margin="3,4">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource AtcBtnStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDrawbarOn}" Value="False">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.StatusOn}"/>
                                                </DataTrigger>
                                                <!-- [2026-03-16] 按鈕防呆 -->
                                                <DataTrigger Binding="{Binding DataContext.CanAtc, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <!-- [2026-03-10] 鬆刀（Drawbar DO ON = 氣壓鬆開 = IsDrawbarOn=True） -->
                                <Button Content="{DynamicResource Str.Atc.ReleaseTool}"
                                        Command="{Binding ReleaseToolCommand}" FontSize="{DynamicResource FontSize.Body}" Padding="6,10" Margin="3,4">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource AtcBtnStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDrawbarOn}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.StatusOn}"/>
                                                </DataTrigger>
                                                <!-- [2026-03-16] 按鈕防呆 -->
                                                <DataTrigger Binding="{Binding DataContext.CanAtc, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <!-- [2026-03-16] 按鈕防呆 -->
                                <!-- 主軸定位 -->
                                <Button Content="{DynamicResource Str.Atc.OrientSpindle}" Style="{StaticResource AtcBtnStyle}"
                                        Command="{Binding OrientSpindleCommand}" FontSize="{DynamicResource FontSize.Body}" Padding="6,10" Margin="3,4"
                                        IsEnabled="{Binding DataContext.CanAtc, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                <!-- 主軸解鎖 -->
                                <Button Content="{DynamicResource Str.Atc.UnlockSpindle}" Style="{StaticResource AtcBtnStyle}"
                                        Command="{Binding UnlockSpindleCommand}" FontSize="{DynamicResource FontSize.Body}" Padding="6,10" Margin="3,4"
                                        IsEnabled="{Binding DataContext.CanAtc, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </UniformGrid>

                            <!-- [2026-03-06] 3 full-width buttons at bottom (match UN_BIG4) -->
                            <!-- [2026-03-16] 按鈕防呆 -->
                            <StackPanel Grid.Row="1">
                                <Button Content="{DynamicResource Str.Atc.MoveAboveCarousel}" Style="{StaticResource AtcBtnStyle}"
                                        Command="{Binding MoveHeadAboveCarouselCommand}"
                                        IsEnabled="{Binding DataContext.CanAtc, RelativeSource={RelativeSource AncestorType=Window}}"
                                        HorizontalAlignment="Stretch" FontSize="{DynamicResource FontSize.Body}" Padding="8,12" Margin="3,4"/>
                                <Button Content="{DynamicResource Str.Atc.MoveToToolChangeHeight}" Style="{StaticResource AtcBtnStyle}"
                                        Command="{Binding MoveToolToCarouselHeightCommand}"
                                        IsEnabled="{Binding DataContext.CanAtc, RelativeSource={RelativeSource AncestorType=Window}}"
                                        HorizontalAlignment="Stretch" FontSize="{DynamicResource FontSize.Body}" Padding="8,12" Margin="3,4"/>
                                <Button Content="{DynamicResource Str.Atc.RefCarousel}" Style="{StaticResource AtcBtnStyle}"
                                        Command="{Binding RefCarouselCommand}"
                                        IsEnabled="{Binding DataContext.CanAtc, RelativeSource={RelativeSource AncestorType=Window}}"
                                        HorizontalAlignment="Stretch"                                         FontSize="{DynamicResource FontSize.Medium}" Padding="8,14" Margin="3,8,3,3"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ===== PROGRAM TOOLS (UN_BIG3: title + list fills height + REF at bottom) ===== -->
                    <Border Grid.Row="1" Background="{DynamicResource Brush.Panel.Overlay}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                            CornerRadius="4" Padding="10"
                            Visibility="{Binding IsProgramMode, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- [2026-03-11] Title bar（統一 PanelTitle） -->
                            <Border Grid.Row="0" Style="{StaticResource PanelTitleBorder}" Margin="0,0,0,8">
                                <TextBlock Text="{DynamicResource Str.Atc.ProgramToolsTitle}" Style="{StaticResource PanelTitleText}"/>
                            </Border>

                            <!-- [2026-03-06] Tool list (fills remaining space) -->
                            <ListBox Grid.Row="1" ItemsSource="{Binding ProgramTools}"
                                     Background="{DynamicResource Brush.PanelBackground}" Foreground="White"
                                     BorderBrush="{DynamicResource Brush.Btn.Border}" BorderThickness="1"
                                     FontSize="{DynamicResource FontSize.Large}" FontWeight="Bold" FontFamily="Consolas"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"/>

                            <!-- [2026-03-06] REF CAROUSEL at bottom -->
                            <!-- [2026-03-16] 按鈕防呆 -->
                            <Button Grid.Row="2" Content="{DynamicResource Str.Atc.RefCarousel}" Style="{StaticResource AtcBtnStyle}"
                                    Command="{Binding RefCarouselCommand}"
                                    IsEnabled="{Binding DataContext.CanAtc, RelativeSource={RelativeSource AncestorType=Window}}"
                                    HorizontalAlignment="Stretch"                                     FontSize="{DynamicResource FontSize.Medium}" Padding="8,14" Margin="0,8,0,0"/>
                        </Grid>
                    </Border>
                </Grid>
            </DockPanel>

            <!-- ======================================================================
                 Col 1：CarouselControl 齒輪轉盤（500x500，緊鄰按鈕面板）
                 ====================================================================== -->
            <controls:CarouselControl Grid.Column="1"
                ToolCount="12"
                CurrentAngle="{Binding CarouselAngle}"
                CurrentPocket="{Binding CurrentPocket}"
                IsReferenced="{Binding IsReferenced}"
                Slots="{Binding SlotInfos}"
                Width="560" Height="560"
                VerticalAlignment="Center" Margin="6,0"/>

            <!-- ======================================================================
                 Col 2：SpindleToolControl 主軸刀具顯示（Viewbox 自適應放大）
                 ====================================================================== -->
            <Viewbox Grid.Column="2" MaxHeight="550" MaxWidth="300"
                     VerticalAlignment="Center" HorizontalAlignment="Center"
                     Stretch="Uniform" Margin="10,0">
                <controls:SpindleToolControl
                    ToolNumber="{Binding MachineStatus.ToolNumber, Mode=OneWay}"/>
            </Viewbox>

            <!-- ======================================================================
                 Col 3：ATC AUTOMATIC CONTROL PANEL
                 ====================================================================== -->
            <!-- [2026-03-12] Col 3 改用 Grid（上半捲動區 + 下半固定感測器），避免感測器被擠出畫面 -->
            <Grid Grid.Column="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- [2026-03-12] 上半：原有按鈕區 -->
                <StackPanel Grid.Row="0">

                <!-- [2026-03-11] ATC AUTOMATIC CONTROL PANEL 標題（統一 PanelTitle） -->
                <Border Style="{StaticResource PanelTitleBorder}" Margin="0,0,0,6">
                    <TextBlock Text="{DynamicResource Str.Atc.AutoControlPanel}" Style="{StaticResource PanelTitleText}"
                               TextAlignment="Center"/>
                </Border>

                <!-- [2026-03-06] [n] LOAD SPINDLE -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="White" CornerRadius="2" Margin="0,0,4,0"
                            BorderBrush="{DynamicResource Brush.Btn.Border}" BorderThickness="1">
                        <TextBox Text="{Binding ChangeToolNumber, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" Foreground="Black" FontSize="{DynamicResource FontSize.Medium}" FontWeight="Bold"
                                 TextAlignment="Center" BorderThickness="0" VerticalContentAlignment="Center"
                                 Padding="2"/>
                    </Border>
                    <!-- [2026-03-11] 移除 inline Background，統一由 PanelBtnStyle 繼承 BaseBtnStyle 深灰漸層 -->
                    <!-- [2026-03-16] 按鈕防呆 -->
                    <Button Grid.Column="1" Content="{DynamicResource Str.Atc.LoadSpindle}" Style="{StaticResource PanelBtnStyle}"
                            Command="{Binding LoadSpindleCommand}"
                            IsEnabled="{Binding DataContext.CanAtc, RelativeSource={RelativeSource AncestorType=Window}}"/>
                </Grid>

                <!-- [2026-03-06] UNLOAD SPINDLE -->
                <!-- [2026-03-11] 移除 inline Background -->
                <!-- [2026-03-16] 按鈕防呆 -->
                <Button Content="{DynamicResource Str.Atc.UnloadSpindle}" Style="{StaticResource PanelBtnStyle}"
                        Command="{Binding UnloadSpindleCommand}"
                        IsEnabled="{Binding DataContext.CanAtc, RelativeSource={RelativeSource AncestorType=Window}}"/>

                <Separator Background="{DynamicResource Brush.Separator}" Margin="0,6"/>

                <!-- [2026-03-06] 方向鍵面板（上下左右） -->
                <Grid Margin="4,4" HorizontalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>

                    <!-- [2026-03-16] 按鈕防呆 -->
                    <!-- UP -->
                    <Button Grid.Row="0" Grid.Column="1" Content="&#x25B2;" Style="{StaticResource PanelBtnStyle}"
                            Command="{Binding HeadUpCommand}" FontSize="{DynamicResource FontSize.Large}" Height="40" Width="50"
                            IsEnabled="{Binding DataContext.CanAtc, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    <!-- LEFT -->
                    <Button Grid.Row="1" Grid.Column="0" Content="&#x25C0;" Style="{StaticResource PanelBtnStyle}"
                            Command="{Binding AtcRevCommand}" FontSize="{DynamicResource FontSize.Large}" Height="40" Width="50"
                            IsEnabled="{Binding DataContext.CanAtc, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    <!-- RIGHT -->
                    <Button Grid.Row="1" Grid.Column="2" Content="&#x25B6;" Style="{StaticResource PanelBtnStyle}"
                            Command="{Binding AtcFwdCommand}" FontSize="{DynamicResource FontSize.Large}" Height="40" Width="50"
                            IsEnabled="{Binding DataContext.CanAtc, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    <!-- DOWN -->
                    <Button Grid.Row="2" Grid.Column="1" Content="&#x25BC;" Style="{StaticResource PanelBtnStyle}"
                            Command="{Binding HeadDownCommand}" FontSize="{DynamicResource FontSize.Large}" Height="40" Width="50"
                            IsEnabled="{Binding DataContext.CanAtc, RelativeSource={RelativeSource AncestorType=Window}}"/>
                </Grid>

                <Separator Background="{DynamicResource Brush.Separator}" Margin="0,6"/>

                <!-- [2026-03-06] ELECTRONIC TOOL SETTER -->
                <!-- [2026-03-11] 移除 inline Background -->
                <!-- [2026-03-16] 按鈕防呆 -->
                <Button Content="{DynamicResource Str.Atc.ElectronicToolSetter}" Style="{StaticResource PanelBtnStyle}"
                        Command="{Binding ElectronicToolSetterCommand}"
                        IsEnabled="{Binding DataContext.CanAtc, RelativeSource={RelativeSource AncestorType=Window}}"/>

                <!-- [2026-03-06] TOUCH OFF CURRENT TOOL -->
                <!-- [2026-03-11] 移除 inline Background -->
                <!-- [2026-03-16] 按鈕防呆 -->
                <Button Content="{DynamicResource Str.Atc.TouchOffCurrentTool}" Style="{StaticResource PanelBtnStyle}"
                        Command="{Binding TouchOffCurrentToolCommand}"
                        IsEnabled="{Binding DataContext.CanAtc, RelativeSource={RelativeSource AncestorType=Window}}"/>

                <Separator Background="{DynamicResource Brush.Separator}" Margin="0,6"/>

                <!-- [2026-03-11] 刀位設定區塊（統一 PanelTitle） -->
                <Border Style="{StaticResource PanelTitleBorder}" Margin="0,0,0,4">
                    <TextBlock Text="{DynamicResource Str.Atc.SlotConfig}" Style="{StaticResource PanelTitleText}"/>
                </Border>

                <!-- 刀位號 + 刀號 -->
                <Grid Margin="0,2,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{DynamicResource Str.Atc.SlotNumber}" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{DynamicResource FontSize.Small}"
                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <Border Grid.Column="1" Background="White" CornerRadius="2" BorderBrush="{DynamicResource Brush.Btn.Border}" BorderThickness="1" Margin="0,0,6,0">
                        <TextBox Text="{Binding SelectedSlotNumber, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" Foreground="Black" FontSize="{DynamicResource FontSize.Medium}" FontWeight="Bold"
                                 TextAlignment="Center" BorderThickness="0" VerticalContentAlignment="Center" Padding="2"/>
                    </Border>
                    <TextBlock Grid.Column="2" Text="{DynamicResource Str.Atc.ToolNumber}" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{DynamicResource FontSize.Small}"
                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <Border Grid.Column="3" Background="White" CornerRadius="2" BorderBrush="{DynamicResource Brush.Btn.Border}" BorderThickness="1">
                        <TextBox Text="{Binding SetSlotToolNumber, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" Foreground="Black" FontSize="{DynamicResource FontSize.Medium}" FontWeight="Bold"
                                 TextAlignment="Center" BorderThickness="0" VerticalContentAlignment="Center" Padding="2"/>
                    </Border>
                </Grid>

                <!-- [2026-03-11] 設定 / 清除 / 全部清除（移除 inline 色彩，統一深灰） -->
                <!-- [2026-03-16] 按鈕防呆 -->
                <UniformGrid Rows="1" Columns="3" Margin="0,2,0,4">
                    <Button Content="{DynamicResource Str.Btn.Set}" Style="{StaticResource PanelBtnStyle}" Height="32"
                            Command="{Binding SetSlotToolCommand}" Margin="0,0,2,0"
                            IsEnabled="{Binding DataContext.CanAtc, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    <Button Content="{DynamicResource Str.Btn.Clear}" Style="{StaticResource PanelBtnStyle}" Height="32"
                            Command="{Binding ClearSlotToolCommand}" Margin="2,0,2,0"
                            IsEnabled="{Binding DataContext.CanAtc, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    <Button Content="{DynamicResource Str.Btn.ClearAll}" Style="{StaticResource PanelBtnStyle}" Height="32" FontSize="{DynamicResource FontSize.Small}"
                            Command="{Binding ClearAllSlotsCommand}" Margin="2,0,0,0"
                            IsEnabled="{Binding DataContext.CanAtc, RelativeSource={RelativeSource AncestorType=Window}}"/>
                </UniformGrid>

                <Separator Background="{DynamicResource Brush.Separator}" Margin="0,2"/>

                <!-- [2026-03-06] [n] M6 G43 -->
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="White" CornerRadius="2" Margin="0,0,4,0"
                            BorderBrush="{DynamicResource Brush.Btn.Border}" BorderThickness="1">
                        <TextBox Text="{Binding ChangeToolNumber, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" Foreground="Black" FontSize="{DynamicResource FontSize.Medium}" FontWeight="Bold"
                                 TextAlignment="Center" BorderThickness="0" VerticalContentAlignment="Center"
                                 Padding="2"/>
                    </Border>
                    <!-- [2026-03-11] 移除 inline Background -->
                    <!-- [2026-03-16] 按鈕防呆 -->
                    <Button Grid.Column="1" Content="M6 G43" Style="{StaticResource PanelBtnStyle}"
                            Command="{Binding M6G43Command}"
                            IsEnabled="{Binding DataContext.CanAtc, RelativeSource={RelativeSource AncestorType=Window}}"/>
                </Grid>

                </StackPanel>

                <!-- [2026-03-12] 下半：DI 感測器即時狀態（僅模擬模式顯示，非模擬時隱藏） -->
                <StackPanel Grid.Row="1" Margin="0,6,0,0"
                            Visibility="{Binding IsAtcSimulation, Converter={StaticResource BoolToVis}}">

                <Border Style="{StaticResource PanelTitleBorder}" Margin="0,0,0,4">
                    <TextBlock Text="{DynamicResource Str.Atc.SensorStatus}" Style="{StaticResource PanelTitleText}"/>
                </Border>

                <!-- 刀盤歸位 -->
                <Grid Margin="2,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Grid.Column="0" Width="12" Height="12" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="Gray"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DiCarouselHome}" Value="True">
                                        <Setter Property="Fill" Value="Lime"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Grid.Column="1" Text="{DynamicResource Str.Atc.Sensor.CarouselHome}" Foreground="{DynamicResource Brush.Text.Secondary}"
                               FontSize="{DynamicResource FontSize.Small}" VerticalAlignment="Center" Margin="6,0"/>
                    <Button Grid.Column="2" Content="SIM" Style="{StaticResource AtcBtnStyle}" FontSize="10" Padding="6,2" Margin="0"
                            Command="{Binding SimToggleCarouselHomeCommand}"
                            Visibility="{Binding IsAtcSimulation, Converter={StaticResource BoolToVis}}"/>
                </Grid>

                <!-- 刀盤到位 -->
                <Grid Margin="2,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Grid.Column="0" Width="12" Height="12" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="Gray"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DiCarouselOut}" Value="True">
                                        <Setter Property="Fill" Value="Lime"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Grid.Column="1" Text="{DynamicResource Str.Atc.Sensor.CarouselOut}" Foreground="{DynamicResource Brush.Text.Secondary}"
                               FontSize="{DynamicResource FontSize.Small}" VerticalAlignment="Center" Margin="6,0"/>
                    <Button Grid.Column="2" Content="SIM" Style="{StaticResource AtcBtnStyle}" FontSize="10" Padding="6,2" Margin="0"
                            Command="{Binding SimToggleCarouselOutCommand}"
                            Visibility="{Binding IsAtcSimulation, Converter={StaticResource BoolToVis}}"/>
                </Grid>

                <!-- 夾刀確認 -->
                <Grid Margin="2,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Grid.Column="0" Width="12" Height="12" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="Gray"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DiDrawbarClamp}" Value="True">
                                        <Setter Property="Fill" Value="Lime"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Grid.Column="1" Text="{DynamicResource Str.Atc.Sensor.DrawbarClamp}" Foreground="{DynamicResource Brush.Text.Secondary}"
                               FontSize="{DynamicResource FontSize.Small}" VerticalAlignment="Center" Margin="6,0"/>
                    <Button Grid.Column="2" Content="SIM" Style="{StaticResource AtcBtnStyle}" FontSize="10" Padding="6,2" Margin="0"
                            Command="{Binding SimToggleDrawbarClampCommand}"
                            Visibility="{Binding IsAtcSimulation, Converter={StaticResource BoolToVis}}"/>
                </Grid>

                <!-- 鬆刀確認 -->
                <Grid Margin="2,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Grid.Column="0" Width="12" Height="12" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="Gray"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DiDrawbarUnclamp}" Value="True">
                                        <Setter Property="Fill" Value="Lime"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Grid.Column="1" Text="{DynamicResource Str.Atc.Sensor.DrawbarUnclamp}" Foreground="{DynamicResource Brush.Text.Secondary}"
                               FontSize="{DynamicResource FontSize.Small}" VerticalAlignment="Center" Margin="6,0"/>
                    <Button Grid.Column="2" Content="SIM" Style="{StaticResource AtcBtnStyle}" FontSize="10" Padding="6,2" Margin="0"
                            Command="{Binding SimToggleDrawbarUnclampCommand}"
                            Visibility="{Binding IsAtcSimulation, Converter={StaticResource BoolToVis}}"/>
                </Grid>

                </StackPanel>
            </Grid>
        </Grid>

        <!-- ======================================================================
             底部 MDI 欄
             ====================================================================== -->
        <Border Grid.Row="1" Background="{DynamicResource Brush.Panel.Overlay}" CornerRadius="3" Padding="6,4"
                Margin="10,0,10,10" BorderBrush="{DynamicResource Brush.Btn.Border}" BorderThickness="1">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="MDI" Foreground="{DynamicResource Brush.Text.Secondary}"
                           FontSize="{DynamicResource FontSize.Body}" FontWeight="Bold" VerticalAlignment="Center"
                           Margin="0,0,6,0"/>
                <!-- [2026-03-16] 按鈕防呆 -->
                <Button DockPanel.Dock="Right" Content="{DynamicResource Str.Btn.Send}" Style="{StaticResource AtcBtnStyle}"
                        Command="{Binding SendMdiCommand}" Width="60" Margin="4,0,0,0"
                        IsEnabled="{Binding DataContext.CanMdi, RelativeSource={RelativeSource AncestorType=Window}}"/>
                <TextBox Text="{Binding MdiInput, UpdateSourceTrigger=PropertyChanged}"
                         Background="White" Foreground="Black" FontSize="{DynamicResource FontSize.Body}" Padding="6,3"
                         BorderBrush="{DynamicResource Brush.Btn.Border}" BorderThickness="1">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding SendMdiCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
