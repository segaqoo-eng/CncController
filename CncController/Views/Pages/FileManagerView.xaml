<!-- [2026-03-11] 新增 FileManagerView：FILE 分頁 — 後端檔案管理 -->
<UserControl x:Class="CncController.Views.Pages.FileManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1670" d:DesignHeight="640"
             Background="{DynamicResource Brush.WindowBackground}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="6">
        <Grid.ColumnDefinitions>
            <!-- [2026-03-11] 左側檔案清單 40% -->
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="4"/>
            <!-- [2026-03-11] 右側 G-Code 預覽 60% -->
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- ============================== -->
        <!-- 左側：檔案清單面板             -->
        <!-- ============================== -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- [2026-03-11] 標題列 -->
            <Border Grid.Row="0" Style="{StaticResource PanelTitleBorder}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{DynamicResource Str.File.Refresh}"
                            Style="{StaticResource BaseBtnStyle}"
                            Command="{Binding RefreshFileListCommand}"
                            Padding="12,4" Margin="6,0,0,0"
                            FontSize="{DynamicResource FontSize.Medium}"/>
                    <TextBlock Style="{StaticResource PanelTitleText}"
                               Text="{DynamicResource Str.File.Panel}"/>
                </DockPanel>
            </Border>

            <!-- [2026-03-11] 檔案清單 ListBox -->
            <ListBox Grid.Row="1"
                     ItemsSource="{Binding ProgramFiles}"
                     SelectedItem="{Binding SelectedFile}"
                     Background="{DynamicResource Brush.PanelBackground}"
                     BorderThickness="0"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/> <!-- [2026-03-12] 替換硬編碼色 #DDD → Brush.Text.Secondary -->
                        <Setter Property="FontSize" Value="{DynamicResource FontSize.Large}"/>
                        <Setter Property="FontFamily" Value="{DynamicResource FontFamily.Default}"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="{DynamicResource Brush.PanelBackground}" BorderBrush="{DynamicResource Brush.Border}"
                                            BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Grid.Header}"/> <!-- [2026-03-12] 替換硬編碼色 #3E3E42 → Brush.Grid.Header -->
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Accent}"/> <!-- [2026-03-12] 替換硬編碼色 #007ACC → Brush.Accent -->
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource Brush.Text.Dim}"
                                       FontSize="{DynamicResource FontSize.Medium}"
                                       VerticalAlignment="Center" Margin="8,0,0,0">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0:N0} B">
                                        <Binding Path="Size"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- [2026-03-11] 無檔案提示 -->
            <TextBlock Grid.Row="1" Text="{DynamicResource Str.File.NoFiles}"
                       Foreground="{DynamicResource Brush.Text.Dim}" FontSize="{DynamicResource FontSize.Large}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontWeight="Bold">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ProgramFiles.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- [2026-03-11] 重命名輸入列 -->
            <Border Grid.Row="2" Background="{DynamicResource Brush.Input.Background}" Padding="6"
                    Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{DynamicResource Str.File.Cancel}"
                            Style="{StaticResource BaseBtnStyle}"
                            Command="{Binding CancelRenameCommand}"
                            Width="70" Height="40" Margin="4,0,0,0"
                            FontSize="{DynamicResource FontSize.Medium}"/>
                    <Button DockPanel.Dock="Right" Content="{DynamicResource Str.File.Confirm}"
                            Style="{StaticResource BaseBtnStyle}"
                            Command="{Binding ConfirmRenameCommand}"
                            Width="70" Height="40" Margin="4,0,0,0"
                            FontSize="{DynamicResource FontSize.Medium}"/>
                    <TextBox Text="{Binding RenameInput, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="{DynamicResource FontSize.Large}" Height="40"
                             VerticalContentAlignment="Center" Padding="6,0"/>
                </DockPanel>
            </Border>

            <!-- [2026-03-11] 底部按鈕列 -->
            <UniformGrid Grid.Row="3" Rows="1" Margin="0,4,0,0">
                <Button Content="{DynamicResource Str.File.Run}"
                        Style="{StaticResource BaseBtnStyle}"
                        Command="{Binding LoadProgramCommand}"
                        Height="45" Margin="0,0,2,0"
                        FontSize="{DynamicResource FontSize.Large}"/>
                <Button Content="{DynamicResource Str.File.Delete}"
                        Style="{StaticResource BaseBtnStyle}"
                        Command="{Binding DeleteFileCommand}"
                        Height="45" Margin="2,0,2,0"
                        FontSize="{DynamicResource FontSize.Large}"/>
                <Button Content="{DynamicResource Str.File.Rename}"
                        Style="{StaticResource BaseBtnStyle}"
                        Command="{Binding StartRenameCommand}"
                        Height="45" Margin="2,0,0,0"
                        FontSize="{DynamicResource FontSize.Large}"/>
            </UniformGrid>
        </Grid>

        <!-- [2026-03-11] 分隔線 -->
        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                      Background="{DynamicResource Brush.PanelBackground}"/>

        <!-- ============================== -->
        <!-- 右側：G-Code 預覽面板          -->
        <!-- ============================== -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- [2026-03-11] 預覽標題列 -->
            <Border Grid.Row="0" Style="{StaticResource PanelTitleBorder}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding PreviewFileName}"
                               Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{DynamicResource FontSize.Medium}"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <TextBlock Style="{StaticResource PanelTitleText}"
                               Text="{DynamicResource Str.File.Preview}"/>
                </DockPanel>
            </Border>

            <!-- [2026-03-11] G-Code 逐行預覽（行號+文字） -->
            <ListBox Grid.Row="1" ItemsSource="{Binding PreviewLines}"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     Background="{DynamicResource Brush.Input.Background}" BorderThickness="0"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Focusable" Value="False"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="55"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding LineNumber}"
                                       Foreground="{DynamicResource Brush.Text.Dim}" FontFamily="{DynamicResource FontFamily.Mono}"
                                       FontSize="{DynamicResource FontSize.Large}"
                                       TextAlignment="Right" Padding="0,1,6,1"
                                       Background="{DynamicResource Brush.Grid.RowAlt}"/> <!-- [2026-03-12] 替換硬編碼色 #F0F0F0 → Brush.Grid.RowAlt -->
                            <TextBlock Grid.Column="1" Text="{Binding Text}"
                                       FontFamily="{DynamicResource FontFamily.Mono}"
                                       FontSize="{DynamicResource FontSize.Large}"
                                       Padding="4,1,0,1" Foreground="{DynamicResource Brush.Text.Primary}"/> <!-- [2026-03-12] 替換硬編碼色 Black → Brush.Text.Primary -->
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- [2026-03-11] 空白提示 -->
            <TextBlock Grid.Row="1" Text="{DynamicResource Str.File.NoPreview}"
                       Foreground="{DynamicResource Brush.Text.Dim}" FontSize="{DynamicResource FontSize.XLarge}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontWeight="Bold"
                       Visibility="{Binding IsPreviewEmpty, Converter={StaticResource BoolToVis}}"/>
        </Grid>
    </Grid>
</UserControl>
