<UserControl x:Class="CncController.Views.Pages.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:CncController.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1024"
             FontFamily="{DynamicResource FontFamily.Default}">

    <UserControl.DataContext>
        <vm:HistoryViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <!-- [2026-03-04] TabButtonStyle 改繼承 BaseRadioBtnStyle，移除本地 Template -->
        <Style x:Key="TabButtonStyle" TargetType="RadioButton" BasedOn="{StaticResource BaseRadioBtnStyle}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Large}"/>
            <Setter Property="Padding" Value="{DynamicResource BtnPadding.Large}"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Width" Value="120"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource Brush.PanelBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="#444" BorderThickness="0,0,0,1" Padding="10,10,10,0">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="ALL" Style="{StaticResource TabButtonStyle}" IsChecked="True"
                                 Command="{Binding SetFilterCommand}" CommandParameter="ALL"/>
                    <RadioButton Content="INFO" Style="{StaticResource TabButtonStyle}"
                                 Command="{Binding SetFilterCommand}" CommandParameter="INFO"/>
                    <RadioButton Content="WARN" Style="{StaticResource TabButtonStyle}"
                                 Command="{Binding SetFilterCommand}" CommandParameter="WARN"/>
                    <RadioButton Content="ERROR" Style="{StaticResource TabButtonStyle}"
                                 Command="{Binding SetFilterCommand}" CommandParameter="ERROR"/>
                    <RadioButton Content="DEBUG" Style="{StaticResource TabButtonStyle}" Foreground="Gray"
                                 Command="{Binding SetFilterCommand}" CommandParameter="DEBUG"/>
                </StackPanel>

                <Button DockPanel.Dock="Right" Content="CLEAR ALARMS" Width="160" Height="45" 
                        Background="#333" Foreground="White" BorderBrush="Gray" Margin="0,0,0,5"
                        FontSize="{DynamicResource FontSize.Large}" FontWeight="Bold"
                        Command="{Binding ClearActiveAlarmsCommand}">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </DockPanel>
        </Border>

        <DataGrid Grid.Row="1" ItemsSource="{Binding LogsView}" AutoGenerateColumns="False" 
                  IsReadOnly="True" 
                  FontSize="{DynamicResource FontSize.XLarge}"
                  Background="#1E1E1E" 
                  RowBackground="#1E1E1E"
                  AlternatingRowBackground="#252525"
                  Foreground="#E0E0E0"
                  BorderThickness="0"
                  HeadersVisibility="Column" 
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#444" 
                  ColumnHeaderHeight="40">

            <DataGrid.Resources>
                <Style TargetType="DataGridCell">
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="Padding" Value="5,8"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                    <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#444"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>

                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#333"/>
                    <Setter Property="Foreground" Value="#AAA"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Padding" Value="10,0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                </Style>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <DataGridTextColumn Header="DATE / TIME" Binding="{Binding Time, StringFormat='yyyy/MM/dd HH:mm:ss'}" Width="220" Foreground="#AAA"/>

                <DataGridTextColumn Header="TYPE" Binding="{Binding Type}" Width="120">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{Binding ColorBrush}"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="MESSAGE" Binding="{Binding DisplayMessage}" Width="*" >
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{Binding ColorBrush}"/>
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="5,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>