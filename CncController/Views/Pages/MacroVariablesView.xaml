<!-- [2026-03-12] 巨集變數監控頁面（Settings 子分頁） -->
<UserControl x:Class="CncController.Views.Pages.MacroVariablesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             FontFamily="{DynamicResource FontFamily.Default}">

    <!-- [2026-03-12] 三欄 DataGrid 共用樣式 -->
    <UserControl.Resources>
        <Style x:Key="MacroColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource Brush.Grid.Header}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Large}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: 快速範圍選擇按鈕（加大） -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <ItemsControl ItemsSource="{Binding PresetRanges}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- [2026-03-12] 按鈕加大：FontSize.Large + Padding 16,8 -->
                        <Button Content="{Binding Name}"
                                Command="{Binding DataContext.SelectPresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Style="{StaticResource BaseBtnStyle}"
                                FontSize="{DynamicResource FontSize.Large}"
                                Padding="16,8" Margin="0,0,6,0"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 自訂範圍 -->
            <TextBlock Text="  #" Foreground="{DynamicResource Brush.Text.Muted}" VerticalAlignment="Center"
                       FontSize="{DynamicResource FontSize.Large}" FontWeight="Bold" Margin="10,0,0,0"/>
            <TextBox Text="{Binding RangeStart, UpdateSourceTrigger=PropertyChanged}" Width="70" Height="34"
                     Background="{DynamicResource Brush.Input.Background}" Foreground="{DynamicResource Brush.Input.Foreground}"
                     BorderBrush="{DynamicResource Brush.Input.Border}" BorderThickness="1"
                     FontFamily="{DynamicResource FontFamily.Mono}" FontSize="{DynamicResource FontSize.Large}"
                     VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
            <TextBlock Text=" ~ #" Foreground="{DynamicResource Brush.Text.Muted}" VerticalAlignment="Center"
                       FontSize="{DynamicResource FontSize.Large}" FontWeight="Bold"/>
            <TextBox Text="{Binding RangeEnd, UpdateSourceTrigger=PropertyChanged}" Width="70" Height="34"
                     Background="{DynamicResource Brush.Input.Background}" Foreground="{DynamicResource Brush.Input.Foreground}"
                     BorderBrush="{DynamicResource Brush.Input.Border}" BorderThickness="1"
                     FontFamily="{DynamicResource FontFamily.Mono}" FontSize="{DynamicResource FontSize.Large}"
                     VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
            <Button Content="{DynamicResource Str.Macro.Refresh}" Command="{Binding RefreshVariablesCommand}"
                    Style="{StaticResource BaseBtnStyle}" FontSize="{DynamicResource FontSize.Large}"
                    Padding="16,8" Margin="6,0,0,0"/>
        </StackPanel>

        <!-- Row 1: 目前範圍標題 -->
        <Border Grid.Row="1" Style="{StaticResource PanelTitleBorder}" Margin="0,0,0,6">
            <Grid>
                <TextBlock Style="{StaticResource PanelTitleText}">
                    <Run Text="{Binding SelectedPreset, Mode=OneWay}"/>
                    <Run Text="  (#"/>
                    <Run Text="{Binding RangeStart, Mode=OneWay}"/>
                    <Run Text=" ~ #"/>
                    <Run Text="{Binding RangeEnd, Mode=OneWay}"/>
                    <Run Text=")"/>
                </TextBlock>
                <!-- 載入中指示 -->
                <TextBlock Text="Loading..." Foreground="{DynamicResource Brush.Alert.Warning}"
                           FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                           Margin="0,0,10,0"/>
            </Grid>
        </Border>

        <!-- [2026-03-12] Row 2: 三欄並排 DataGrid -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 第一欄 -->
            <DataGrid Grid.Column="0"
                      ItemsSource="{Binding Column1}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      Background="{DynamicResource Brush.Grid.Background}"
                      RowBackground="{DynamicResource Brush.Grid.Row}"
                      AlternatingRowBackground="{DynamicResource Brush.Grid.RowAlt}"
                      Foreground="{DynamicResource Brush.Text.Primary}"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{DynamicResource Brush.Border}"
                      BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                      RowHeight="36"
                      FontSize="{DynamicResource FontSize.Large}"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      VirtualizingStackPanel.IsVirtualizing="True">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MacroColumnHeader}"/>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="65" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontFamily" Value="{DynamicResource FontFamily.Mono}"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="8,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="{DynamicResource Str.Macro.ColName}" Binding="{Binding Name}" Width="*" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <!-- [2026-03-12] 名稱改白色（原 Brush.Text.Dim 對比不明顯） -->
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="8,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="{DynamicResource Str.Macro.ColValue}" Binding="{Binding Value, StringFormat=F6, UpdateSourceTrigger=LostFocus}" Width="150">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.DRO.Foreground}"/>
                                <Setter Property="FontFamily" Value="{DynamicResource FontFamily.Mono}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="8,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.EditingElementStyle>
                            <Style TargetType="TextBox">
                                <Setter Property="Background" Value="{DynamicResource Brush.Input.Background}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Input.Foreground}"/>
                                <Setter Property="FontFamily" Value="{DynamicResource FontFamily.Mono}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                                <Setter Property="Padding" Value="4,2"/>
                            </Style>
                        </DataGridTextColumn.EditingElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- 第二欄 -->
            <DataGrid Grid.Column="2"
                      ItemsSource="{Binding Column2}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      Background="{DynamicResource Brush.Grid.Background}"
                      RowBackground="{DynamicResource Brush.Grid.Row}"
                      AlternatingRowBackground="{DynamicResource Brush.Grid.RowAlt}"
                      Foreground="{DynamicResource Brush.Text.Primary}"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{DynamicResource Brush.Border}"
                      BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                      RowHeight="36"
                      FontSize="{DynamicResource FontSize.Large}"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      VirtualizingStackPanel.IsVirtualizing="True">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MacroColumnHeader}"/>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="65" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontFamily" Value="{DynamicResource FontFamily.Mono}"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="8,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="{DynamicResource Str.Macro.ColName}" Binding="{Binding Name}" Width="*" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="8,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="{DynamicResource Str.Macro.ColValue}" Binding="{Binding Value, StringFormat=F6, UpdateSourceTrigger=LostFocus}" Width="150">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.DRO.Foreground}"/>
                                <Setter Property="FontFamily" Value="{DynamicResource FontFamily.Mono}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="8,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.EditingElementStyle>
                            <Style TargetType="TextBox">
                                <Setter Property="Background" Value="{DynamicResource Brush.Input.Background}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Input.Foreground}"/>
                                <Setter Property="FontFamily" Value="{DynamicResource FontFamily.Mono}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                                <Setter Property="Padding" Value="4,2"/>
                            </Style>
                        </DataGridTextColumn.EditingElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

        </Grid>

        <!-- Row 3: 底部工具列 — 單筆寫入 + 批次寫入 -->
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 單筆寫入 -->
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="#" Foreground="{DynamicResource Brush.Text.Muted}" VerticalAlignment="Center"
                           FontSize="{DynamicResource FontSize.Large}" FontWeight="Bold"/>
                <TextBox Text="{Binding WriteVarId, UpdateSourceTrigger=PropertyChanged}" Width="70" Height="34"
                         Background="{DynamicResource Brush.Input.Background}" Foreground="{DynamicResource Brush.Input.Foreground}"
                         BorderBrush="{DynamicResource Brush.Input.Border}" BorderThickness="1"
                         FontFamily="{DynamicResource FontFamily.Mono}" FontSize="{DynamicResource FontSize.Large}"
                         VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                <TextBlock Text=" = " Foreground="{DynamicResource Brush.Text.Muted}" VerticalAlignment="Center"
                           FontSize="{DynamicResource FontSize.Large}" FontWeight="Bold"/>
                <TextBox Text="{Binding WriteVarValue, UpdateSourceTrigger=PropertyChanged}" Width="130" Height="34"
                         Background="{DynamicResource Brush.Input.Background}" Foreground="{DynamicResource Brush.Input.Foreground}"
                         BorderBrush="{DynamicResource Brush.Input.Border}" BorderThickness="1"
                         FontFamily="{DynamicResource FontFamily.Mono}" FontSize="{DynamicResource FontSize.Large}"
                         VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                <Button Content="{DynamicResource Str.Macro.Write}" Command="{Binding WriteVariableCommand}"
                        Style="{StaticResource BaseBtnStyle}" FontSize="{DynamicResource FontSize.Large}"
                        Padding="16,8" Margin="6,0,0,0"/>
            </StackPanel>

            <!-- 批次寫入 -->
            <Button Grid.Column="2" Content="{DynamicResource Str.Macro.WriteAll}"
                    Command="{Binding WriteAllModifiedCommand}"
                    Style="{StaticResource BaseBtnStyle}"
                    FontSize="{DynamicResource FontSize.Large}" Padding="16,8"/>
        </Grid>
    </Grid>
</UserControl>
