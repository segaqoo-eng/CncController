<UserControl x:Class="CncController.Views.Pages.MonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:hx="http://helix-toolkit.org/wpf"
             xmlns:vm="clr-namespace:CncController.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000"
             d:DataContext="{d:DesignInstance vm:MonitorViewModel, IsDesignTimeCreatable=True}"
             FontFamily="{DynamicResource FontFamily.Default}">

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- [2026-03-11] G-Code 欄寬 400→600（加大 1.5 倍） -->
            <ColumnDefinition Width="600"/>
            <ColumnDefinition Width="70"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============================================ -->
        <!-- Column 0: G-Code 程式碼區 -->
        <!-- ============================================ -->
        <Grid Grid.Column="0" Margin="0,0,2,0">
            <Grid.RowDefinitions>
                <!-- [2026-03-11] 標題列高度 30→60（工控觸控加大） -->
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>

            <!-- [2026-03-13] 標題列：一般模式 vs 編輯模式 按鈕切換 -->
            <Border Grid.Row="0" Style="{StaticResource PanelTitleBorder}" CornerRadius="2,2,0,0">
                <DockPanel Margin="4,0">
                    <TextBlock DockPanel.Dock="Left" Text="G-CODE" Style="{StaticResource PanelTitleText}"
                               FontSize="{DynamicResource FontSize.XLarge}"
                               VerticalAlignment="Center" HorizontalAlignment="Left"/>

                    <!-- ===== 編輯模式按鈕（IsEditMode=True 時顯示） ===== -->
                    <!-- [2026-03-16] 按鈕防呆 -->
                    <!-- 儲存上傳 -->
                    <Button DockPanel.Dock="Right" Content="{DynamicResource Str.Monitor.Save}" Command="{Binding SaveAndUploadCommand}"
                            IsEnabled="{Binding DataContext.CanUpload, RelativeSource={RelativeSource AncestorType=Window}}"
                            Style="{StaticResource BaseBtnStyle}" Padding="16,6" Margin="4,4"
                            FontSize="{DynamicResource FontSize.Large}" Height="42" MinWidth="80"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}"/>
                    <!-- 放棄 -->
                    <Button DockPanel.Dock="Right" Content="{DynamicResource Str.Monitor.Discard}" Command="{Binding DiscardEditCommand}"
                            Style="{StaticResource BaseBtnStyle}" Padding="16,6" Margin="4,4"
                            FontSize="{DynamicResource FontSize.Large}" Height="42" MinWidth="80"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}"/>

                    <!-- ===== 一般模式按鈕（IsEditMode=False 時顯示） ===== -->
                    <!-- 上傳本機檔案 -->
                    <Button DockPanel.Dock="Right" Content="{DynamicResource Str.File.Upload}" Command="{Binding LoadLocalFileCommand}"
                            Padding="16,6" Margin="4,4"
                            FontSize="{DynamicResource FontSize.Large}" Height="42" MinWidth="80"
                            VerticalAlignment="Center">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BaseBtnStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <!-- 編輯 -->
                    <Button DockPanel.Dock="Right" Content="{DynamicResource Str.Monitor.Edit}" Command="{Binding ToggleEditModeCommand}"
                            Padding="16,6" Margin="4,4"
                            FontSize="{DynamicResource FontSize.Large}" Height="42" MinWidth="80"
                            VerticalAlignment="Center">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BaseBtnStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsGCodeEditable}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <!-- 開啟舊檔 -->
                    <Button DockPanel.Dock="Right" Content="{DynamicResource Str.File.Open}" Command="{Binding OpenLocalFileCommand}"
                            Padding="16,6" Margin="4,4"
                            FontSize="{DynamicResource FontSize.Large}" Height="42" MinWidth="80"
                            VerticalAlignment="Center">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BaseBtnStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- 已載入檔名顯示 -->
                    <TextBlock Text="{Binding CurrentFileName}" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="{DynamicResource FontSize.Large}"
                               VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>

            <!-- G-Code 逐行顯示（行號 + 高亮執行中行）/ 編輯模式 TextBox -->
            <Border Grid.Row="1" Background="{DynamicResource Brush.Code.Background}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                <Grid>
                <!-- [2026-03-13] 編輯模式：全文 TextBox -->
                <TextBox x:Name="GCodeEditBox"
                         Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" AcceptsTab="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="{DynamicResource FontFamily.Mono}" FontSize="{DynamicResource FontSize.Large}"
                         Background="{DynamicResource Brush.Code.Background}"
                         Foreground="{DynamicResource Brush.Code.Foreground}"
                         BorderThickness="0" Padding="8,4"
                         TextWrapping="NoWrap">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <!-- 空狀態提示 -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding IsGCodeEmpty, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{DynamicResource Str.Monitor.NoProgramLoaded}" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{DynamicResource FontSize.XLarge}"
                               FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="{DynamicResource Str.Monitor.LoadHint}" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{DynamicResource FontSize.Large}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
                <ListBox x:Name="GCodeListBox" ItemsSource="{Binding GCodeLines}"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         Background="{DynamicResource Brush.Code.Background}" BorderThickness="0"
                         HorizontalContentAlignment="Stretch"
                         SelectionMode="Single" IsTabStop="False">
                    <!-- [2026-03-13] 編輯模式時隱藏 ListBox -->
                    <ListBox.Style>
                        <Style TargetType="ListBox">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.Style>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCurrentLine}" Value="True">
                                                <Setter Property="Background" Value="#FFFFCC"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <!-- [2026-03-11] 行號欄加寬配合大字體 -->
                                    <ColumnDefinition Width="55"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding LineNumber}"
                                           Foreground="{DynamicResource Brush.Code.LineNum}" FontFamily="{DynamicResource FontFamily.Mono}" FontSize="{DynamicResource FontSize.Large}"
                                           TextAlignment="Right" Padding="0,1,6,1"
                                           Background="{DynamicResource Brush.Code.LineNumBg}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Text}"
                                           FontFamily="{DynamicResource FontFamily.Mono}" FontSize="{DynamicResource FontSize.Large}" Padding="4,1,0,1">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Code.Foreground}"/>
                                            <Setter Property="FontWeight" Value="Normal"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrentLine}" Value="True">
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Code.Foreground}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                </Grid>
            </Border>

            <!-- [2026-03-11] MDI 輸入列（高度 50px 工控觸控加大） -->
            <Grid Grid.Row="2" Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <ComboBox IsEditable="True" IsTextSearchEnabled="False"
                          Text="{Binding MdiInput, UpdateSourceTrigger=PropertyChanged}"
                          ItemsSource="{Binding MdiHistory}"
                          VerticalContentAlignment="Center" Padding="6"
                          Background="White" FontFamily="{DynamicResource FontFamily.Mono}"
                          FontSize="{DynamicResource FontSize.Large}">
                    <ComboBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding SendMdiCommand}"/>
                    </ComboBox.InputBindings>
                </ComboBox>
                <!-- [2026-03-16] 按鈕防呆 -->
                <Button Grid.Column="1" Content="{DynamicResource Str.Btn.Send}" Margin="2,0,0,0"
                        Command="{Binding SendMdiCommand}"
                        IsEnabled="{Binding DataContext.CanMdi, RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource BaseBtnStyle}" Foreground="White" FontWeight="Bold"
                        FontSize="{DynamicResource FontSize.Large}"/>
            </Grid>
        </Grid>

        <!-- ============================================ -->
        <!-- Column 1: 3D 視角按鈕 -->
        <!-- ============================================ -->
        <StackPanel Grid.Column="1" Margin="2,0">
            <!-- [2026-03-13] 置中充滿（ZoomExtents） -->
            <Button Content="FIT" Height="40" Margin="0,0,0,3" Click="OnFitClick"
                    Background="{DynamicResource Brush.Input.Background}" Foreground="{DynamicResource Brush.Text.Primary}" BorderThickness="0"/>
            <Button Content="ISO" Height="40" Margin="0,0,0,3" Click="OnIsoClick"
                    Background="{DynamicResource Brush.Input.Background}" Foreground="{DynamicResource Brush.Text.Primary}" BorderThickness="0"/>
            <Button Content="TOP" Height="40" Margin="0,0,0,3" Click="OnTopClick"
                    Background="{DynamicResource Brush.Input.Background}" Foreground="{DynamicResource Brush.Text.Primary}" BorderThickness="0"/>
            <Button Content="FRONT" Height="40" Margin="0,0,0,3" Click="OnFrontClick"
                    Background="{DynamicResource Brush.Input.Background}" Foreground="{DynamicResource Brush.Text.Primary}" BorderThickness="0"/>
        </StackPanel>

        <!-- ============================================ -->
        <!-- Column 2: 3D 預覽區 -->
        <!-- ============================================ -->
        <Border Grid.Column="2" Background="{DynamicResource Brush.Viewport.Background}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
            <!-- [2026-03-12] 3D 刀具路徑預覽（綁定 MonitorVM.ToolPathModel） -->
            <hx:HelixViewport3D x:Name="Viewport3D" ZoomExtentsWhenLoaded="True" ShowCoordinateSystem="True" Background="{DynamicResource Brush.Viewport.Background}">
                <hx:SunLight/>
                <hx:GridLinesVisual3D Width="300" Length="300" Thickness="0.5" Fill="{DynamicResource Brush.Viewport.Grid}"/>
                <ModelVisual3D Content="{Binding ToolPathModel}"/>
                <hx:TruncatedConeVisual3D Height="10" BaseRadius="0" TopRadius="3" Fill="Orange"/>
            </hx:HelixViewport3D>
        </Border>
    </Grid>
</UserControl>
