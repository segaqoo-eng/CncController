<UserControl x:Class="CncController.Views.Pages.MonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:hx="http://helix-toolkit.org/wpf"
             xmlns:vm="clr-namespace:CncController.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000">

    <UserControl.DataContext>
        <vm:MonitorViewModel/>
    </UserControl.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="70"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,2,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#444" CornerRadius="2,2,0,0">
                <TextBlock Text="G-CODE PROGRAM" Foreground="White" VerticalAlignment="Center" Margin="10,0" FontWeight="Bold"/>
            </Border>
            <Border Grid.Row="1" Background="White" BorderBrush="#444" BorderThickness="1">
                <ScrollViewer>
                    <TextBlock Text="{Binding GCodeText}" Foreground="Black" FontFamily="Consolas" Margin="5"/>
                </ScrollViewer>
            </Border>
            <Grid Grid.Row="2" Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="MDI Input..." VerticalContentAlignment="Center" Background="White" Padding="5"/>
                <Button Grid.Column="1" Content="SEND" Margin="2,0,0,0" Background="#007ACC" Foreground="White" FontWeight="Bold"/>
            </Grid>
        </Grid>

        <StackPanel Grid.Column="1" Margin="2,0">
            <Button Content="ISO" Height="40" Margin="0,0,0,3" Background="#333" Foreground="White" BorderThickness="0"/>
            <Button Content="TOP" Height="40" Margin="0,0,0,3" Background="#333" Foreground="White" BorderThickness="0"/>
            <Button Content="FRONT" Height="40" Margin="0,0,0,3" Background="#333" Foreground="White" BorderThickness="0"/>
        </StackPanel>

        <Border Grid.Column="2" Background="Black" BorderBrush="#444" BorderThickness="1">
            <hx:HelixViewport3D ZoomExtentsWhenLoaded="True" ShowCoordinateSystem="True" Background="Black">
                <hx:SunLight/>
                <hx:GridLinesVisual3D Width="300" Length="300" Thickness="0.5" Fill="#333"/>
                <hx:TruncatedConeVisual3D Height="20" BaseRadius="0" TopRadius="5" Fill="Orange"/>
            </hx:HelixViewport3D>
        </Border>
    </Grid>
</UserControl>