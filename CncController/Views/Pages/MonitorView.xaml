<UserControl x:Class="CncController.Views.Pages.MonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:hx="http://helix-toolkit.org/wpf"
             xmlns:vm="clr-namespace:CncController.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000"
             d:DataContext="{d:DesignInstance vm:MonitorViewModel, IsDesignTimeCreatable=True}"
             FontFamily="{DynamicResource FontFamily.Default}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="70"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,2,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>

            <!-- [2026-03-04] 標題列：G-CODE PROGRAM + 檔名 + LOAD 按鈕 -->
            <Border Grid.Row="0" Background="#444" CornerRadius="2,2,0,0">
                <DockPanel Margin="10,0,5,0">
                    <TextBlock DockPanel.Dock="Left" Text="G-CODE" Foreground="White"
                               VerticalAlignment="Center" FontWeight="Bold" FontSize="{DynamicResource FontSize.Body}"/>
                    <Button DockPanel.Dock="Right" Content="LOAD" Command="{Binding LoadLocalFileCommand}"
                            Style="{StaticResource BaseBtnStyle}" Padding="12,2" Margin="4,2"
                            FontSize="{DynamicResource FontSize.Body}" VerticalAlignment="Center"/>
                    <!-- [2026-03-04] 已載入檔名顯示（無檔案時隱藏） -->
                    <TextBlock Text="{Binding CurrentFileName}" Foreground="#AAA" FontSize="{DynamicResource FontSize.Body}"
                               VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>

            <!-- [2026-03-04] G-Code 逐行顯示（行號 + 高亮執行中行 + 自動捲動） -->
            <Border Grid.Row="1" Background="White" BorderBrush="#444" BorderThickness="1">
                <Grid>
                <!-- [2026-03-04] 空狀態提示：無程式載入時居中顯示 -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding IsGCodeEmpty, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="NO PROGRAM LOADED" Foreground="#BBB" FontSize="{DynamicResource FontSize.Large}"
                               FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Click LOAD to open a G-Code file" Foreground="#CCC" FontSize="{DynamicResource FontSize.Body}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
                <ListBox x:Name="GCodeListBox" ItemsSource="{Binding GCodeLines}"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         Background="White" BorderThickness="0"
                         HorizontalContentAlignment="Stretch"
                         SelectionMode="Single" IsTabStop="False">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCurrentLine}" Value="True">
                                                <Setter Property="Background" Value="#FFFFCC"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="45"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding LineNumber}"
                                           Foreground="#999" FontFamily="{DynamicResource FontFamily.Mono}" FontSize="{DynamicResource FontSize.Body}"
                                           TextAlignment="Right" Padding="0,0,6,0"
                                           Background="#F0F0F0"/>
                                <TextBlock Grid.Column="1" Text="{Binding Text}"
                                           FontFamily="{DynamicResource FontFamily.Mono}" FontSize="{DynamicResource FontSize.Body}" Padding="4,0,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="Black"/>
                                            <Setter Property="FontWeight" Value="Normal"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrentLine}" Value="True">
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Setter Property="Foreground" Value="#333"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <ComboBox IsEditable="True" IsTextSearchEnabled="False"
                          Text="{Binding MdiInput, UpdateSourceTrigger=PropertyChanged}"
                          ItemsSource="{Binding MdiHistory}"
                          VerticalContentAlignment="Center" Padding="5"
                          Background="White" FontFamily="{DynamicResource FontFamily.Mono}">
                    <ComboBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding SendMdiCommand}"/>
                    </ComboBox.InputBindings>
                </ComboBox>
                <Button Grid.Column="1" Content="SEND" Margin="2,0,0,0"
                        Command="{Binding SendMdiCommand}"
                        Background="#007ACC" Foreground="White" FontWeight="Bold"/>
            </Grid>
        </Grid>

        <StackPanel Grid.Column="1" Margin="2,0">
            <Button Content="ISO" Height="40" Margin="0,0,0,3" Background="#333" Foreground="White" BorderThickness="0"/>
            <Button Content="TOP" Height="40" Margin="0,0,0,3" Background="#333" Foreground="White" BorderThickness="0"/>
            <Button Content="FRONT" Height="40" Margin="0,0,0,3" Background="#333" Foreground="White" BorderThickness="0"/>
        </StackPanel>

        <Border Grid.Column="2" Background="Black" BorderBrush="#444" BorderThickness="1">
            <hx:HelixViewport3D ZoomExtentsWhenLoaded="True" ShowCoordinateSystem="True" Background="Black">
                <hx:SunLight/>
                <hx:GridLinesVisual3D Width="300" Length="300" Thickness="0.5" Fill="#333"/>
                <hx:TruncatedConeVisual3D Height="20" BaseRadius="0" TopRadius="5" Fill="Orange"/>
            </hx:HelixViewport3D>
        </Border>
    </Grid>
</UserControl>