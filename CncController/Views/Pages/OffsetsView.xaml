<UserControl x:Class="CncController.Views.Pages.OffsetsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:CncController.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:OffsetsViewModel}"
             d:DesignHeight="700" d:DesignWidth="1700">

    <UserControl.Resources>
        <Style x:Key="OffsetBtnStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#111"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- WCS 選擇按鈕樣式（大按鈕）-->
        <Style x:Key="WcsBtnStyle" TargetType="Button" BasedOn="{StaticResource OffsetBtnStyle}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="4,3"/>
        </Style>
    </UserControl.Resources>

    <Border Background="#1E1E1E" Padding="10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="55*"/>
                <ColumnDefinition Width="45*"/>
            </Grid.ColumnDefinitions>

            <!-- ========== 左欄：座標系總表 ========== -->
            <Border Grid.Column="0" Background="#252526" BorderBrush="#444" BorderThickness="1" CornerRadius="4" Margin="0,0,5,0">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" Text="WORK OFFSET TABLE" Foreground="#AAAAAA"
                               FontSize="12" FontWeight="Bold" Margin="0,0,0,6"/>

                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0"
                                HorizontalAlignment="Left">
                        <Button Content="CLEAR SELECTED" Style="{StaticResource OffsetBtnStyle}"
                                Command="{Binding ClearAllCommand}" Width="130"/>
                        <Button Content="CLEAR ALL" Style="{StaticResource OffsetBtnStyle}"
                                Command="{Binding ClearAllCommand}" Width="90"/>
                        <Button Content="SAVE TABLE" Style="{StaticResource OffsetBtnStyle}"
                                Command="{Binding SaveTableCommand}" Width="90"
                                Background="#445588"/>
                        <Button Content="RELOAD TABLE" Style="{StaticResource OffsetBtnStyle}"
                                Command="{Binding ReloadTableCommand}" Width="110"
                                Background="#226633"/>
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding OffsetTable}"
                              SelectedItem="{Binding SelectedRow}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#333"
                              Background="#2D2D2D"
                              RowBackground="#2D2D2D"
                              AlternatingRowBackground="#292929"
                              Foreground="White"
                              BorderThickness="0"
                              ColumnHeaderHeight="28"
                              RowHeight="30">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#333"/>
                                <Setter Property="Foreground" Value="#AAAAAA"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="4"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="4,2"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#00539C"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="WCS" Binding="{Binding Name}" Width="70" IsReadOnly="True"/>
                            <DataGridTextColumn Header="X" Binding="{Binding X, StringFormat=F4}" Width="*"/>
                            <DataGridTextColumn Header="Y" Binding="{Binding Y, StringFormat=F4}" Width="*"/>
                            <DataGridTextColumn Header="Z" Binding="{Binding Z, StringFormat=F4}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- ========== 右欄：WORK COORDINATE OFFSETS ========== -->
            <Border Grid.Column="1" Background="#252526" BorderBrush="#444" BorderThickness="1" CornerRadius="4" Margin="5,0,0,0">
                <StackPanel Margin="10">
                    <TextBlock Text="WORK COORDINATE OFFSETS" Foreground="#AAAAAA"
                               FontSize="12" FontWeight="Bold" Margin="0,0,0,10"/>

                    <!-- G54–G59 快選按鈕 -->
                    <UniformGrid Rows="1" Margin="0,0,0,10">
                        <Button Content="G54" Command="{Binding SelectOffsetCommand}" CommandParameter="G54">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource WcsBtnStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveOffset}" Value="G54">
                                            <Setter Property="Background" Value="#007ACC"/>
                                            <Setter Property="BorderBrush" Value="#005A9E"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="G55" Command="{Binding SelectOffsetCommand}" CommandParameter="G55">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource WcsBtnStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveOffset}" Value="G55">
                                            <Setter Property="Background" Value="#007ACC"/>
                                            <Setter Property="BorderBrush" Value="#005A9E"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="G56" Command="{Binding SelectOffsetCommand}" CommandParameter="G56">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource WcsBtnStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveOffset}" Value="G56">
                                            <Setter Property="Background" Value="#007ACC"/>
                                            <Setter Property="BorderBrush" Value="#005A9E"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="G57" Command="{Binding SelectOffsetCommand}" CommandParameter="G57">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource WcsBtnStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveOffset}" Value="G57">
                                            <Setter Property="Background" Value="#007ACC"/>
                                            <Setter Property="BorderBrush" Value="#005A9E"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="G58" Command="{Binding SelectOffsetCommand}" CommandParameter="G58">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource WcsBtnStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveOffset}" Value="G58">
                                            <Setter Property="Background" Value="#007ACC"/>
                                            <Setter Property="BorderBrush" Value="#005A9E"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="G59" Command="{Binding SelectOffsetCommand}" CommandParameter="G59">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource WcsBtnStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveOffset}" Value="G59">
                                            <Setter Property="Background" Value="#007ACC"/>
                                            <Setter Property="BorderBrush" Value="#005A9E"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </UniformGrid>

                    <Separator Background="#444" Margin="0,0,0,10"/>

                    <!-- 座標值顯示（MC Current / WC / G53/G52），暫 hardcode 0.000 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="24"/>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="36"/>
                        </Grid.RowDefinitions>

                        <!-- 表頭 -->
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="MC CURRENT" Foreground="#888" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="WC" Foreground="#888" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="G53/G52" Foreground="#888" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        <!-- X 行 -->
                        <Border Grid.Row="1" Grid.Column="0" Background="#3A2A2A" Margin="1" CornerRadius="2">
                            <TextBlock Text="X" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" Background="#1A1A2E" Margin="1" CornerRadius="2">
                            <TextBlock Text="0.000" Foreground="#00BFFF" FontFamily="Consolas" FontSize="14" FontWeight="Bold"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="6,0"/>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="2" Background="#1A2E1A" Margin="1" CornerRadius="2">
                            <TextBlock Text="0.000" Foreground="#90EE90" FontFamily="Consolas" FontSize="14" FontWeight="Bold"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="6,0"/>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="3" Background="#2A2A2A" Margin="1" CornerRadius="2">
                            <TextBlock Text="0.000" Foreground="#AAAAAA" FontFamily="Consolas" FontSize="14" FontWeight="Bold"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="6,0"/>
                        </Border>

                        <!-- Y 行 -->
                        <Border Grid.Row="2" Grid.Column="0" Background="#3A2A2A" Margin="1" CornerRadius="2">
                            <TextBlock Text="Y" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Grid.Row="2" Grid.Column="1" Background="#1A1A2E" Margin="1" CornerRadius="2">
                            <TextBlock Text="0.000" Foreground="#00BFFF" FontFamily="Consolas" FontSize="14" FontWeight="Bold"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="6,0"/>
                        </Border>
                        <Border Grid.Row="2" Grid.Column="2" Background="#1A2E1A" Margin="1" CornerRadius="2">
                            <TextBlock Text="0.000" Foreground="#90EE90" FontFamily="Consolas" FontSize="14" FontWeight="Bold"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="6,0"/>
                        </Border>
                        <Border Grid.Row="2" Grid.Column="3" Background="#2A2A2A" Margin="1" CornerRadius="2">
                            <TextBlock Text="0.000" Foreground="#AAAAAA" FontFamily="Consolas" FontSize="14" FontWeight="Bold"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="6,0"/>
                        </Border>

                        <!-- Z 行 -->
                        <Border Grid.Row="3" Grid.Column="0" Background="#3A2A2A" Margin="1" CornerRadius="2">
                            <TextBlock Text="Z" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Grid.Row="3" Grid.Column="1" Background="#1A1A2E" Margin="1" CornerRadius="2">
                            <TextBlock Text="0.000" Foreground="#00BFFF" FontFamily="Consolas" FontSize="14" FontWeight="Bold"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="6,0"/>
                        </Border>
                        <Border Grid.Row="3" Grid.Column="2" Background="#1A2E1A" Margin="1" CornerRadius="2">
                            <TextBlock Text="0.000" Foreground="#90EE90" FontFamily="Consolas" FontSize="14" FontWeight="Bold"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="6,0"/>
                        </Border>
                        <Border Grid.Row="3" Grid.Column="3" Background="#2A2A2A" Margin="1" CornerRadius="2">
                            <TextBlock Text="0.000" Foreground="#AAAAAA" FontFamily="Consolas" FontSize="14" FontWeight="Bold"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="6,0"/>
                        </Border>
                    </Grid>

                    <Separator Background="#444" Margin="0,10,0,8"/>

                    <!-- 底部動作按鈕 -->
                    <WrapPanel HorizontalAlignment="Left">
                        <Button Content="SET TO ZERO X" Style="{StaticResource OffsetBtnStyle}"
                                Command="{Binding SetToZeroCommand}" Width="120"/>
                        <Button Content="SET TO ZERO Y" Style="{StaticResource OffsetBtnStyle}"
                                Command="{Binding SetToZeroCommand}" Width="120"/>
                        <Button Content="SET TO ZERO Z" Style="{StaticResource OffsetBtnStyle}"
                                Command="{Binding SetToZeroCommand}" Width="120"/>
                        <Button Content="ZERO ALL" Style="{StaticResource OffsetBtnStyle}"
                                Command="{Binding SetToZeroCommand}" Width="90"
                                Background="#664422"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
