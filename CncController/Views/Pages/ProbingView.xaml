                                <Line X1="48" Y1="52" X2="72" Y2="52" Stroke="#22C55E" StrokeThickness="1.5"/>
                                <Path Data="M60,30 L60,38" Stroke="Black" StrokeThickness="1.5"/>
                                <Polygon Points="57,30 63,30 60,25" Fill="Black"/>
                                <Path Data="M60,66 L60,74" Stroke="Black" StrokeThickness="1.5"/>
                                <Polygon Points="57,74 63,74 60,79" Fill="Black"/>
                                <Path Data="M38,52 L46,52" Stroke="Black" StrokeThickness="1.5"/>
                                <Polygon Points="38,49 38,55 33,52" Fill="Black"/>
                                <Path Data="M74,52 L82,52" Stroke="Black" StrokeThickness="1.5"/>
                                <Polygon Points="82,49 82,55 87,52" Fill="Black"/>
                            </Canvas>
                        </Button>
                        <Button Command="{Binding ProbeAngleECommand}" Style="{StaticResource ProbeGridBtnStyle}"
                                ToolTip="Edge Angle E (right edge)">
                            <Canvas Width="120" Height="110">
                                <Rectangle Canvas.Left="15" Canvas.Top="5" Width="55" Height="100" Fill="#BBBBBB"
                                           RenderTransformOrigin="0.5,0.5">
                                    <Rectangle.RenderTransform><RotateTransform Angle="-5"/></Rectangle.RenderTransform>
                                </Rectangle>
                                <Ellipse Canvas.Left="95" Canvas.Top="30" Width="12" Height="12" Fill="#8B5CF6"/>
                                <Path Data="M93,36 L78,36" Stroke="Black" StrokeThickness="2"/>
                                <Polygon Points="78,32 78,40 72,36" Fill="Black"/>
                                <Ellipse Canvas.Left="67" Canvas.Top="33" Width="8" Height="8" Fill="#22C55E"/>
                                <Ellipse Canvas.Left="95" Canvas.Top="65" Width="12" Height="12" Fill="#8B5CF6"/>
                                <Path Data="M93,71 L78,71" Stroke="Black" StrokeThickness="2"/>
                                <Polygon Points="78,67 78,75 72,71" Fill="Black"/>
                                <Ellipse Canvas.Left="67" Canvas.Top="68" Width="8" Height="8" Fill="#22C55E"/>
                            </Canvas>
                        </Button>

                        <!-- Row 2: SW / S / SE — 探測南面（底邊），箭頭向上 -->
                        <Button Command="{Binding ProbeAngleSWCommand}" Style="{StaticResource ProbeGridBtnStyle}"
                                ToolTip="Edge Angle SW (bottom edge, left start)">
                            <Canvas Width="120" Height="110">
                                <Rectangle Canvas.Left="10" Canvas.Top="5" Width="100" Height="50" Fill="#BBBBBB"
                                           RenderTransformOrigin="0.5,0.5">
                                    <Rectangle.RenderTransform><RotateTransform Angle="-3"/></Rectangle.RenderTransform>
                                </Rectangle>
                                <Ellipse Canvas.Left="25" Canvas.Top="85" Width="12" Height="12" Fill="#8B5CF6"/>
                                <Path Data="M31,83 L31,67" Stroke="Black" StrokeThickness="2"/>
                                <Polygon Points="27,67 35,67 31,61" Fill="Black"/>
                                <Ellipse Canvas.Left="28" Canvas.Top="57" Width="8" Height="8" Fill="#22C55E"/>
                            </Canvas>
                        </Button>
                        <Button Command="{Binding ProbeAngleSCommand}" Style="{StaticResource ProbeGridBtnStyle}"
                                ToolTip="Edge Angle S (bottom edge, centered)">
                            <Canvas Width="120" Height="110">
                                <Rectangle Canvas.Left="10" Canvas.Top="5" Width="100" Height="50" Fill="#BBBBBB"
                                           RenderTransformOrigin="0.5,0.5">
                                    <Rectangle.RenderTransform><RotateTransform Angle="-3"/></Rectangle.RenderTransform>
                                </Rectangle>
                                <Ellipse Canvas.Left="34" Canvas.Top="85" Width="12" Height="12" Fill="#8B5CF6"/>
                                <Path Data="M40,83 L40,67" Stroke="Black" StrokeThickness="2"/>
                                <Polygon Points="36,67 44,67 40,61" Fill="Black"/>
                                <Ellipse Canvas.Left="37" Canvas.Top="57" Width="8" Height="8" Fill="#22C55E"/>
                                <Ellipse Canvas.Left="74" Canvas.Top="85" Width="12" Height="12" Fill="#8B5CF6"/>
                                <Path Data="M80,83 L80,67" Stroke="Black" StrokeThickness="2"/>
                                <Polygon Points="76,67 84,67 80,61" Fill="Black"/>
                                <Ellipse Canvas.Left="77" Canvas.Top="57" Width="8" Height="8" Fill="#22C55E"/>
                            </Canvas>
                        </Button>
                        <Button Command="{Binding ProbeAngleSECommand}" Style="{StaticResource ProbeGridBtnStyle}"
                                ToolTip="Edge Angle SE (bottom edge, right start)">
                            <Canvas Width="120" Height="110">
                                <Rectangle Canvas.Left="10" Canvas.Top="5" Width="100" Height="50" Fill="#BBBBBB"
                                           RenderTransformOrigin="0.5,0.5">
                                    <Rectangle.RenderTransform><RotateTransform Angle="-3"/></Rectangle.RenderTransform>
                                </Rectangle>
                                <Ellipse Canvas.Left="82" Canvas.Top="85" Width="12" Height="12" Fill="#8B5CF6"/>
                                <Path Data="M88,83 L88,67" Stroke="Black" StrokeThickness="2"/>
                                <Polygon Points="84,67 92,67 88,61" Fill="Black"/>
                                <Ellipse Canvas.Left="85" Canvas.Top="57" Width="8" Height="8" Fill="#22C55E"/>
                            </Canvas>
                        </Button>
                    </UniformGrid>
                    <!-- [2026-03-04] SET ROTATION WCO 按鈕 + EDGE WIDTH 輸入框 -->
                    <Border Background="#1A1A1ACC" CornerRadius="4" Padding="8,4" Margin="0,6,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="SET ROTATION WCO"
                                    Style="{StaticResource ProbeBtnStyle}"
                                    Command="{Binding SetRotationWcoCommand}" Padding="10,4"/>
                            <StackPanel Grid.Column="1"/>
                            <TextBlock Grid.Column="2" Text="EDGE WIDTH" Foreground="#AAA"
                                       FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox Grid.Column="3" FontFamily="Consolas" FontSize="12"
                                     Foreground="#000" Background="#FFF" BorderBrush="#999"
                                     HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                     Height="24"
                                     Text="{Binding EdgeWidthInput, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </Border>
                    </StackPanel>
                </Border>

                <!-- ======================================================== -->
                <!-- [2026-03-04] Calibrate 校正面板（對齊 PB 版） -->
                <!-- ======================================================== -->
                <Border Background="#33333366" CornerRadius="5"
                        Padding="12" Margin="4,0" VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedProbeTab}" Value="Calibrate">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Width="420">
                        <!-- 頂列：PROBE CALIBRATION OFFSET + 輸入框 + PROBE CAL RESET -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="PROBE CALIBRATION OFFSET:" Foreground="White"
                                       FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1" FontFamily="Consolas" FontSize="12"
                                     Foreground="#000" Background="#FFF" BorderBrush="#999"
                                     HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                     Height="26"
                                     Text="{Binding ProbeCalOffset, StringFormat='{}{0:F6}', UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="3" Content="PROBE CAL RESET"
                                    Style="{StaticResource ProbeBtnStyle}" Padding="10,4"
                                    Command="{Binding ProbeCalResetCommand}"/>
                        </Grid>

                        <!-- 中段：環校正（2 按鈕）+ CALIBRATION DIAMETER -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- 環孔內探按鈕（Ring bore：環內壁向外探） -->
                            <Button Grid.Column="0" Command="{Binding CalRingInsideCommand}"
                                    Style="{StaticResource ProbeGridBtnStyle}" Height="130">
                                <Canvas Width="120" Height="110">
                                    <!-- 外環 -->
                                    <Ellipse Canvas.Left="10" Canvas.Top="10" Width="100" Height="90"
                                             Stroke="#888" StrokeThickness="18" Fill="#DDD"/>
                                    <!-- 中心探針 -->
                                    <Ellipse Canvas.Left="50" Canvas.Top="42" Width="14" Height="14" Fill="#8B5CF6"/>
                                    <Ellipse Canvas.Left="53" Canvas.Top="45" Width="8" Height="8" Fill="#22C55E"/>
                                    <!-- 箭頭：← → ↑ ↓ -->
                                    <Path Data="M40,49 L30,49" Stroke="Black" StrokeThickness="1.5"/>
                                    <Polygon Points="30,46 30,52 24,49" Fill="Black"/>
                                    <Path Data="M74,49 L84,49" Stroke="Black" StrokeThickness="1.5"/>
                                    <Polygon Points="84,46 84,52 90,49" Fill="Black"/>
                                    <Path Data="M57,35 L57,25" Stroke="Black" StrokeThickness="1.5"/>
                                    <Polygon Points="54,25 60,25 57,19" Fill="Black"/>
                                    <Path Data="M57,63 L57,73" Stroke="Black" StrokeThickness="1.5"/>
                                    <Polygon Points="54,73 60,73 57,79" Fill="Black"/>
                                </Canvas>
                            </Button>
                            <!-- 環外探按鈕（Ring outside：環外面向內探） -->
                            <Button Grid.Column="2" Command="{Binding CalRingOutsideCommand}"
                                    Style="{StaticResource ProbeGridBtnStyle}" Height="130">
                                <Canvas Width="120" Height="110">
                                    <!-- 實心圓（凸柱） -->
                                    <Ellipse Canvas.Left="25" Canvas.Top="15" Width="70" Height="70"
                                             Fill="#BBB" Stroke="#888" StrokeThickness="2"/>
                                    <!-- 中心探針 -->
                                    <Ellipse Canvas.Left="52" Canvas.Top="42" Width="12" Height="12" Fill="#8B5CF6"/>
                                    <Ellipse Canvas.Left="55" Canvas.Top="45" Width="6" Height="6" Fill="#22C55E"/>
                                    <!-- 箭頭：→ → → →（向外） -->
                                    <Path Data="M84,50 L100,50" Stroke="Black" StrokeThickness="1.5"/>
                                    <Polygon Points="100,47 100,53 106,50" Fill="Black"/>
                                    <Path Data="M36,50 L20,50" Stroke="Black" StrokeThickness="1.5"/>
                                    <Polygon Points="20,47 20,53 14,50" Fill="Black"/>
                                </Canvas>
                            </Button>
                            <!-- CALIBRATION DIAMETER -->
                            <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="10,0,0,0">
                                <TextBlock Text="CALIBRATION" Foreground="#AAA" FontSize="10"
                                           FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Text="DIAMETER" Foreground="#AAA" FontSize="10"
                                           FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBox FontFamily="Consolas" FontSize="12" Width="100"
                                         Foreground="#000" Background="#FFF" BorderBrush="#999"
                                         HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                         Height="26"
                                         Text="{Binding CalibrationDiameter, StringFormat='{}{0:F6}', UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <!-- 3 按鈕列：CAL ON AVG XY ERROR / X ERROR / Y ERROR -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="CAL ON AVG XY ERROR" Padding="4,6"
                                    Background="#0078D4" Foreground="White" FontSize="9" FontWeight="Bold"
                                    Cursor="Hand" Command="{Binding CalOnAvgXyErrorCommand}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                                Padding="{TemplateBinding Padding}" BorderBrush="#555" BorderThickness="1">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Grid.Column="2" Content="CAL ON X ERROR"
                                    Style="{StaticResource ProbeBtnStyle}" Padding="4,6" FontSize="9"
                                    Command="{Binding CalOnXErrorCommand}"/>
                            <Button Grid.Column="4" Content="CAL ON Y ERROR"
                                    Style="{StaticResource ProbeBtnStyle}" Padding="4,6" FontSize="9"
                                    Command="{Binding CalOnYErrorCommand}"/>
                        </Grid>

                        <!-- 下段：方塊校正（2 按鈕）+ CALIBRATION WIDTH -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- 方孔內探按鈕（Square pocket：孔內向外探） -->
                            <Button Grid.Column="0" Command="{Binding CalSquareInsideCommand}"
                                    Style="{StaticResource ProbeGridBtnStyle}" Height="130">
                                <Canvas Width="120" Height="110">
                                    <!-- 外框（口袋） -->
                                    <Rectangle Canvas.Left="10" Canvas.Top="5" Width="100" Height="100"
                                               Fill="#DDD" Stroke="#888" StrokeThickness="2"/>
                                    <!-- 內部空間 -->
                                    <Rectangle Canvas.Left="25" Canvas.Top="20" Width="70" Height="70"
                                               Fill="#F5F5F5"/>
                                    <!-- 探針中心 -->
                                    <Ellipse Canvas.Left="52" Canvas.Top="47" Width="12" Height="12" Fill="#8B5CF6"/>
                                    <Ellipse Canvas.Left="55" Canvas.Top="50" Width="6" Height="6" Fill="#22C55E"/>
                                    <!-- 箭頭 4 方向向外 -->
                                    <Path Data="M50,42 L50,28" Stroke="Black" StrokeThickness="1.5"/>
                                    <Polygon Points="47,28 53,28 50,22" Fill="Black"/>
                                    <Path Data="M50,65 L50,78" Stroke="Black" StrokeThickness="1.5"/>
                                    <Polygon Points="47,78 53,78 50,84" Fill="Black"/>
                                    <Path Data="M45,53 L32,53" Stroke="Black" StrokeThickness="1.5"/>
                                    <Polygon Points="32,50 32,56 26,53" Fill="Black"/>
                                    <Path Data="M70,53 L82,53" Stroke="Black" StrokeThickness="1.5"/>
                                    <Polygon Points="82,50 82,56 88,53" Fill="Black"/>
                                </Canvas>
                            </Button>
                            <!-- 方外探按鈕（Square boss：方塊外面向內探） -->
                            <Button Grid.Column="2" Command="{Binding CalSquareOutsideCommand}"
                                    Style="{StaticResource ProbeGridBtnStyle}" Height="130">
                                <Canvas Width="120" Height="110">
                                    <!-- 方塊（凸台） -->
                                    <Rectangle Canvas.Left="30" Canvas.Top="20" Width="60" Height="70"
                                               Fill="#BBB" Stroke="#888" StrokeThickness="2"/>
                                    <!-- 探針中心 -->
                                    <Ellipse Canvas.Left="52" Canvas.Top="47" Width="12" Height="12" Fill="#8B5CF6"/>
                                    <Ellipse Canvas.Left="55" Canvas.Top="50" Width="6" Height="6" Fill="#22C55E"/>
                                    <!-- 箭頭 4 方向（外部向內指） -->
                                    <Path Data="M60,10 L60,18" Stroke="Black" StrokeThickness="1.5"/>
                                    <Polygon Points="57,10 63,10 60,4" Fill="Black"/>
                                    <Path Data="M60,92 L60,84" Stroke="Black" StrokeThickness="1.5"/>
                                    <Polygon Points="57,92 63,92 60,98" Fill="Black"/>
                                    <Path Data="M20,55 L28,55" Stroke="Black" StrokeThickness="1.5"/>
                                    <Polygon Points="20,52 20,58 14,55" Fill="Black"/>
                                    <Path Data="M100,55 L92,55" Stroke="Black" StrokeThickness="1.5"/>
                                    <Polygon Points="100,52 100,58 106,55" Fill="Black"/>
                                </Canvas>
                            </Button>
                            <!-- CALIBRATION WIDTH X / Y -->
                            <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="10,0,0,0">
                                <TextBlock Text="CALIBRATION WIDTH" Foreground="#AAA" FontSize="10"
                                           FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="X :" Foreground="#AAA" FontSize="11" FontWeight="Bold"
                                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBox FontFamily="Consolas" FontSize="12" Width="80"
                                             Foreground="#000" Background="#FFF" BorderBrush="#999"
                                             HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                             Height="26"
                                             Text="{Binding CalibrationWidthX, StringFormat='{}{0:F6}', UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Y :" Foreground="#AAA" FontSize="11" FontWeight="Bold"
                                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBox FontFamily="Consolas" FontSize="12" Width="80"
                                             Foreground="#000" Background="#FFF" BorderBrush="#999"
                                             HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                             Height="26"
                                             Text="{Binding CalibrationWidthY, StringFormat='{}{0:F6}', UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ======================================================== -->
                <!-- [2026-03-04] PROBE HELP 圖片瀏覽面板 -->
                <!-- ======================================================== -->
                <Border Background="#33333399" CornerRadius="5"
                        Padding="10" Margin="4,0" VerticalAlignment="Stretch"
                        HorizontalAlignment="Stretch" Grid.Column="1" Grid.ColumnSpan="2">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedProbeTab}" Value="ProbeHelp">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <!-- 底部：◄ PREV PAGE / 頁碼 / NEXT PAGE ► -->
                        <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="1" Command="{Binding HelpPrevPageCommand}"
                                    Style="{StaticResource ProbeBtnStyle}" Padding="14,6" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="◄" FontSize="12" Margin="0,0,6,0"/>
                                    <TextBlock Text="PREV PAGE" FontSize="11" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                                       Foreground="#AAA" FontSize="11" FontFamily="Consolas" Margin="8,0">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} / 7">
                                        <Binding Path="HelpPageIndex"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <Button Grid.Column="3" Command="{Binding HelpNextPageCommand}"
                                    Style="{StaticResource ProbeBtnStyle}" Padding="14,6" Margin="10,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="NEXT PAGE" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock Text="►" FontSize="12" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <!-- 中央：圖片顯示 -->
                        <Border Background="#F0F0F0" CornerRadius="6" Padding="4">
                            <Image Source="{Binding HelpImageSource}" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                    </DockPanel>
                </Border>

                </Grid>

                <!-- ======================================================== -->
                <!-- Col 3: 垂直 Tab（TOUCH PROBE / TOOL SETTER） -->
                <!-- ======================================================== -->
                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                    <!-- TOUCH PROBE（藍色） -->
                    <Border Background="#0078D4" CornerRadius="0,4,4,0" Padding="3,16"
                            Margin="0,4" Cursor="Hand"
                            MouseLeftButtonDown="TouchProbeTab_Click">
                        <TextBlock Text="TOUCH PROBE" Foreground="White" FontSize="12" FontWeight="Bold">
                            <TextBlock.LayoutTransform>
                                <RotateTransform Angle="90"/>
                            </TextBlock.LayoutTransform>
                        </TextBlock>
                    </Border>
                    <!-- TOOL SETTER（灰色 disabled） -->
                    <Border Background="#444" CornerRadius="0,4,4,0" Padding="3,16"
                            Margin="0,4" Opacity="0.5">
                        <TextBlock Text="TOOL SETTER" Foreground="#999" FontSize="12" FontWeight="Bold">
                            <TextBlock.LayoutTransform>
                                <RotateTransform Angle="90"/>
                            </TextBlock.LayoutTransform>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ============================================================ -->
            <!-- Row 2: MDI 列 -->
            <!-- ============================================================ -->
            <Border Grid.Row="2" Background="#222222CC" Margin="4,2,4,4"
                    CornerRadius="4" Padding="6,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="MDI" Foreground="#0AF"
                               FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding MdiInput, UpdateSourceTrigger=PropertyChanged}"
                             Background="#1A1A1A" Foreground="#0F0" FontFamily="Consolas" FontSize="12"
                             BorderBrush="#555" BorderThickness="1" Padding="6,3"
                             VerticalContentAlignment="Center" Margin="4,0">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding SendMdiCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Grid.Column="2" Content="SEND" Style="{StaticResource ProbeBtnStyle}"
                            Command="{Binding SendMdiCommand}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
