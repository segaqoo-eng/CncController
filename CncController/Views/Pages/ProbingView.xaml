<!-- [2026-03-04] ProbingView：探測循環頁面（對齊 PB 版 Probing_outSide_2.png）
     Porbing_BACK.png 為整頁背景（Layer 0），所有 UI 元件浮在上面（Layer 1） -->
<UserControl x:Class="CncController.Views.Pages.ProbingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:CncController.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ProbingViewModel}"
             d:DesignHeight="700" d:DesignWidth="1700">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- [2026-03-04] 子頁籤 → 繼承全域 BaseRadioBtnStyle -->
        <Style x:Key="ProbeTabStyle" TargetType="RadioButton" BasedOn="{StaticResource BaseRadioBtnStyle}">
            <Setter Property="FontSize" Value="{DynamicResource BtnFontSize.Medium}"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="1,0"/>
        </Style>

        <!-- [2026-03-04] WCS 按鈕 → 繼承全域 BaseRadioBtnStyle -->
        <Style x:Key="WcsSelectStyle" TargetType="RadioButton" BasedOn="{StaticResource BaseRadioBtnStyle}">
            <Setter Property="FontSize" Value="{DynamicResource BtnFontSize.Large}"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>

        <!-- [2026-03-04] 九宮格探測按鈕（淺色底 + Canvas 繪圖，保留獨立 Template） -->
        <Style x:Key="ProbeGridBtnStyle" TargetType="Button">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="5" BorderThickness="1.5" BorderBrush="#999"
                                Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#F5F5F5" Offset="0"/>
                                    <GradientStop Color="#E0E0E0" Offset="0.5"/>
                                    <GradientStop Color="#D0D0D0" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#0078D4"/>
                                <Setter TargetName="bd" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FFFFFF" Offset="0"/>
                                            <GradientStop Color="#ECECEC" Offset="0.5"/>
                                            <GradientStop Color="#DDDDDD" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#C0C0C0" Offset="0"/>
                                            <GradientStop Color="#D0D0D0" Offset="0.5"/>
                                            <GradientStop Color="#E0E0E0" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsProbing}" Value="True">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- [2026-03-04] 參數標籤 -->
        <Style x:Key="ParamLbl" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DDD"/>
            <Setter Property="FontSize" Value="{DynamicResource BtnFontSize.Medium}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>

        <!-- [2026-03-04] 參數輸入框（白底黑字） -->
        <Style x:Key="ParamTxt" TargetType="TextBox">
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="Foreground" Value="#111"/>
            <Setter Property="FontSize" Value="{DynamicResource BtnFontSize.Large}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="BorderBrush" Value="#888"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>

        <!-- [2026-03-04] 結果標籤 -->
        <Style x:Key="ResultLbl" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DDD"/>
            <Setter Property="FontSize" Value="{DynamicResource BtnFontSize.Medium}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>

        <!-- [2026-03-04] 結果值（白底黑字） -->
        <Style x:Key="ResultVal" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#111"/>
            <Setter Property="FontSize" Value="{DynamicResource BtnFontSize.Large}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="2,2"/>
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>

        <!-- [2026-03-04] 通用按鈕 → 繼承全域 BaseBtnStyle -->
        <Style x:Key="ProbeBtnStyle" TargetType="Button" BasedOn="{StaticResource BaseBtnStyle}">
        </Style>
    </UserControl.Resources>

    <!-- ================================================================ -->
    <!-- 整頁背景圖（Layer 0）+ UI 疊層（Layer 1） -->
    <!-- ================================================================ -->
    <Grid>
        <!-- Layer 0: 整頁背景圖 -->
        <Image Source="/Resources/Images/Porbing_BACK.png" Stretch="Fill" Opacity="0.6"/>

        <!-- Layer 1: UI 內容 -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- Row 0: 子頁籤 -->
                <RowDefinition Height="*"/>      <!-- Row 1: 主體 -->
                <RowDefinition Height="Auto"/>   <!-- Row 2: MDI -->
            </Grid.RowDefinitions>

            <!-- ============================================================ -->
            <!-- Row 0: 子頁籤列（右對齊） -->
            <!-- ============================================================ -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="4,4,4,0">
                <RadioButton Content="OUTSIDE CORNERS" Style="{StaticResource ProbeTabStyle}"
                             IsChecked="True" GroupName="ProbeTab"
                             Command="{Binding SwitchProbeTabCommand}" CommandParameter="OutsideCorners"/>
                <RadioButton Content="INSIDE CORNERS" Style="{StaticResource ProbeTabStyle}"
                             GroupName="ProbeTab"
                             Command="{Binding SwitchProbeTabCommand}" CommandParameter="InsideCorners"/>
                <RadioButton Content="BOSS AND POCKET" Style="{StaticResource ProbeTabStyle}"
                             GroupName="ProbeTab"
                             Command="{Binding SwitchProbeTabCommand}" CommandParameter="BossAndPocket"/>
                <RadioButton Content="RIDGE AND VALLEY" Style="{StaticResource ProbeTabStyle}"
                             GroupName="ProbeTab"
                             Command="{Binding SwitchProbeTabCommand}" CommandParameter="RidgeAndValley"/>
                <RadioButton Content="EDGE ANGLE" Style="{StaticResource ProbeTabStyle}"
                             GroupName="ProbeTab"
                             Command="{Binding SwitchProbeTabCommand}" CommandParameter="EdgeAngle"/>
                <RadioButton Content="ROTARY AXIS" Style="{StaticResource ProbeTabStyle}"
                             IsEnabled="False" GroupName="ProbeTab"/>
                <RadioButton Content="CALIBRATE" Style="{StaticResource ProbeTabStyle}"
                             GroupName="ProbeTab"
                             Command="{Binding SwitchProbeTabCommand}" CommandParameter="Calibrate"/>
                <RadioButton Content="PROBE HELP" Style="{StaticResource ProbeTabStyle}"
                             GroupName="ProbeTab"
                             Command="{Binding SwitchProbeTabCommand}" CommandParameter="ProbeHelp"/>
            </StackPanel>

            <!-- ============================================================ -->
            <!-- Row 1: 主體（左參數 | 中央底圖 | 右九宮格 | 垂直Tab） -->
            <!-- ============================================================ -->
            <Grid Grid.Row="1" Margin="4,4,4,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="580"/>    <!-- Col 0: 左面板（參數+結果） -->
                    <ColumnDefinition Width="*"/>      <!-- Col 1: 中央（底圖穿透） -->
                    <ColumnDefinition Width="420"/>    <!-- Col 2: 九宮格 -->
                    <ColumnDefinition Width="36"/>     <!-- Col 3: 垂直 Tab -->
                </Grid.ColumnDefinitions>

                <!-- ======================================================== -->
                <!-- [2026-03-04] Col 0: 左面板（上中下三段，對齊 PB 版） -->
                <!-- ======================================================== -->
                <Border Grid.Column="0" Background="#444444CC" CornerRadius="5"
                        Margin="0,0,4,0" Padding="0">
                    <StackPanel>

                        <!-- ====== 上：WORK OFFSETS ====== -->
                        <Border Background="#333" CornerRadius="5,5,0,0" Padding="6,4">
                            <StackPanel>
                                <TextBlock Text="WORK OFFSETS" Foreground="#FFF" FontSize="15"
                                           FontWeight="Bold" Margin="0,0,0,4"/>
                                <!-- Row 1: G54~G59 -->
                                <UniformGrid Rows="1" Columns="6" Margin="0,0,0,2">
                                    <RadioButton Content="G54" Style="{StaticResource WcsSelectStyle}"
                                                 IsChecked="True" GroupName="WcsSelect"
                                                 Command="{Binding SelectWcsCommand}" CommandParameter="G54"/>
                                    <RadioButton Content="G55" Style="{StaticResource WcsSelectStyle}"
                                                 GroupName="WcsSelect"
                                                 Command="{Binding SelectWcsCommand}" CommandParameter="G55"/>
                                    <RadioButton Content="G56" Style="{StaticResource WcsSelectStyle}"
                                                 GroupName="WcsSelect"
                                                 Command="{Binding SelectWcsCommand}" CommandParameter="G56"/>
                                    <RadioButton Content="G57" Style="{StaticResource WcsSelectStyle}"
                                                 GroupName="WcsSelect"
                                                 Command="{Binding SelectWcsCommand}" CommandParameter="G57"/>
                                    <RadioButton Content="G58" Style="{StaticResource WcsSelectStyle}"
                                                 GroupName="WcsSelect"
                                                 Command="{Binding SelectWcsCommand}" CommandParameter="G58"/>
                                    <RadioButton Content="G59" Style="{StaticResource WcsSelectStyle}"
                                                 GroupName="WcsSelect"
                                                 Command="{Binding SelectWcsCommand}" CommandParameter="G59"/>
                                </UniformGrid>
                                <!-- Row 2: G59.1~G59.3 + PROBE POSITION ONLY -->
                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="2*"/>
                                    </Grid.ColumnDefinitions>
                                    <RadioButton Grid.Column="0" Content="G59.1" Style="{StaticResource WcsSelectStyle}"
                                                 GroupName="WcsSelect"
                                                 Command="{Binding SelectWcsCommand}" CommandParameter="G59.1"/>
                                    <RadioButton Grid.Column="1" Content="G59.2" Style="{StaticResource WcsSelectStyle}"
                                                 GroupName="WcsSelect"
                                                 Command="{Binding SelectWcsCommand}" CommandParameter="G59.2"/>
                                    <RadioButton Grid.Column="2" Content="G59.3" Style="{StaticResource WcsSelectStyle}"
                                                 GroupName="WcsSelect"
                                                 Command="{Binding SelectWcsCommand}" CommandParameter="G59.3"/>
                                    <ToggleButton Grid.Column="3" Content="PROBE POSITION ONLY"
                                                  IsChecked="{Binding IsProbePositionOnly}"
                                                  Foreground="#FFF" FontSize="14" FontWeight="Bold"
                                                  Background="#3A3A3A" Margin="2,0" Padding="6,3" Cursor="Hand">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                        BorderBrush="#555" BorderThickness="1" CornerRadius="3"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#0078D4"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#4A4A4A"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ====== 中：PROBING PARAMETERS ====== -->
                        <Border Background="#3A3A3ACC" Padding="6,4" Margin="0,2,0,0">
                            <StackPanel>
                                <TextBlock Text="PROBING PARAMETERS" Foreground="#FFF" FontSize="15"
                                           FontWeight="Bold" Margin="0,0,0,4"/>
                                <!-- 5 行參數：標籤靠右 + 白底輸入框 -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="PROBE TOOL #" Style="{StaticResource ParamLbl}" HorizontalAlignment="Right" Margin="0,2,6,2"/>
                                    <TextBox   Grid.Row="0" Grid.Column="1" Text="{Binding ProbeToolNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ParamTxt}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="PROBE SLOW FDRATE" Style="{StaticResource ParamLbl}" HorizontalAlignment="Right" Margin="0,2,6,2"/>
                                    <TextBox   Grid.Row="0" Grid.Column="4" Text="{Binding ProbeSlowFeed, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ParamTxt}"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="PROBE TRAVERSE FR" Style="{StaticResource ParamLbl}" HorizontalAlignment="Right" Margin="0,2,6,2"/>
                                    <TextBox   Grid.Row="1" Grid.Column="1" Text="{Binding ProbeTraverseFr, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ParamTxt}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="3" Text="PROBE FAST FDRATE" Style="{StaticResource ParamLbl}" HorizontalAlignment="Right" Margin="0,2,6,2"/>
                                    <TextBox   Grid.Row="1" Grid.Column="4" Text="{Binding ProbeFastFeed, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ParamTxt}"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="MAX X/Y DISTANCE" Style="{StaticResource ParamLbl}" HorizontalAlignment="Right" Margin="0,2,6,2"/>
                                    <TextBox   Grid.Row="2" Grid.Column="1" Text="{Binding MaxXyDistance, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ParamTxt}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="3" Text="X/Y CLEARANCE" Style="{StaticResource ParamLbl}" HorizontalAlignment="Right" Margin="0,2,6,2"/>
                                    <TextBox   Grid.Row="2" Grid.Column="4" Text="{Binding XyClearance, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ParamTxt}"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="MAX Z DISTANCE" Style="{StaticResource ParamLbl}" HorizontalAlignment="Right" Margin="0,2,6,2"/>
                                    <TextBox   Grid.Row="3" Grid.Column="1" Text="{Binding MaxZDistance, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ParamTxt}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="3" Text="Z CLEARANCE" Style="{StaticResource ParamLbl}" HorizontalAlignment="Right" Margin="0,2,6,2"/>
                                    <TextBox   Grid.Row="3" Grid.Column="4" Text="{Binding ZClearance, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ParamTxt}"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="EXTRA PROBE DEPTH" Style="{StaticResource ParamLbl}" HorizontalAlignment="Right" Margin="0,2,6,2"/>
                                    <TextBox   Grid.Row="4" Grid.Column="1" Text="{Binding ExtraProbeDepth, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ParamTxt}"/>
                                    <TextBlock Grid.Row="4" Grid.Column="3" Text="STEP OFF WIDTH" Style="{StaticResource ParamLbl}" HorizontalAlignment="Right" Margin="0,2,6,2"/>
                                    <TextBox   Grid.Row="4" Grid.Column="4" Text="{Binding StepOffWidth, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ParamTxt}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ====== 下：4 按鈕 + 結果 + 狀態 ====== -->
                        <Border Background="#333333CC" CornerRadius="0,0,5,5" Padding="6,4" Margin="0,2,0,0">
                            <StackPanel>
                                <!-- 4 按鈕等寬一列 -->
                                <UniformGrid Rows="1" Columns="4" Margin="0,0,0,4">
                                    <Button Content="UPDATE PROBE PARAMS" Style="{StaticResource ProbeBtnStyle}"
                                            Command="{Binding UpdateProbeParamsCommand}" Padding="4,5" FontSize="11"/>
                                    <Button Content="RESET ALL DATA" Style="{StaticResource ProbeBtnStyle}"
                                            Command="{Binding ResetAllDataCommand}" Padding="4,5"/>
                                    <Button Content="X DATA RESET" Style="{StaticResource ProbeBtnStyle}"
                                            Command="{Binding XDataResetCommand}" Padding="4,5"/>
                                    <Button Content="Y DATA RESET" Style="{StaticResource ProbeBtnStyle}"
                                            Command="{Binding YDataResetCommand}" Padding="4,5"/>
                                </UniformGrid>

                                <!-- 結果 4 行 × 3 組：標籤靠右 + 白底值 -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="X- PROBED" Style="{StaticResource ResultLbl}" HorizontalAlignment="Right" Margin="0,2,4,2"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ResultX, StringFormat='{}{0:F4}'}" Style="{StaticResource ResultVal}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="X+ PROBED" Style="{StaticResource ResultLbl}" HorizontalAlignment="Right" Margin="0,2,4,2"/>
                                    <TextBlock Grid.Row="0" Grid.Column="4" Text="{Binding ResultXOffset, StringFormat='{}{0:F4}'}" Style="{StaticResource ResultVal}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="6" Text="X WIDTH" Style="{StaticResource ResultLbl}" HorizontalAlignment="Right" Margin="0,2,4,2"/>
                                    <TextBlock Grid.Row="0" Grid.Column="7" Text="{Binding ResultWidthX, StringFormat='{}{0:F4}'}" Style="{StaticResource ResultVal}"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Y- PROBED" Style="{StaticResource ResultLbl}" HorizontalAlignment="Right" Margin="0,2,4,2"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ResultY, StringFormat='{}{0:F4}'}" Style="{StaticResource ResultVal}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="3" Text="Y+ PROBED" Style="{StaticResource ResultLbl}" HorizontalAlignment="Right" Margin="0,2,4,2"/>
                                    <TextBlock Grid.Row="1" Grid.Column="4" Text="{Binding ResultYOffset, StringFormat='{}{0:F4}'}" Style="{StaticResource ResultVal}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="6" Text="Y WIDTH" Style="{StaticResource ResultLbl}" HorizontalAlignment="Right" Margin="0,2,4,2"/>
                                    <TextBlock Grid.Row="1" Grid.Column="7" Text="{Binding ResultWidthY, StringFormat='{}{0:F4}'}" Style="{StaticResource ResultVal}"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Z- PROBED" Style="{StaticResource ResultLbl}" HorizontalAlignment="Right" Margin="0,2,4,2"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ResultZ, StringFormat='{}{0:F4}'}" Style="{StaticResource ResultVal}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="3" Text="DIAM ∅" Style="{StaticResource ResultLbl}" HorizontalAlignment="Right" Margin="0,2,4,2"/>
                                    <TextBlock Grid.Row="2" Grid.Column="4" Text="{Binding ResultEdgeWidth, StringFormat='{}{0:F4}'}" Style="{StaticResource ResultVal}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="6" Text="X CENTER" Style="{StaticResource ResultLbl}" HorizontalAlignment="Right" Margin="0,2,4,2"/>
                                    <TextBlock Grid.Row="2" Grid.Column="7" Text="{Binding ResultXCenter, StringFormat='{}{0:F4}'}" Style="{StaticResource ResultVal}"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="EDGE Δ" Style="{StaticResource ResultLbl}" HorizontalAlignment="Right" Margin="0,2,4,2"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ResultEdgeDelta, StringFormat='{}{0:F4}'}" Style="{StaticResource ResultVal}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="3" Text="EDGE ∠" Style="{StaticResource ResultLbl}" HorizontalAlignment="Right" Margin="0,2,4,2"/>
                                    <TextBlock Grid.Row="3" Grid.Column="4" Text="{Binding ResultAngle, StringFormat='{}{0:F4}'}" Style="{StaticResource ResultVal}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="6" Text="Y CENTER" Style="{StaticResource ResultLbl}" HorizontalAlignment="Right" Margin="0,2,4,2"/>
                                    <TextBlock Grid.Row="3" Grid.Column="7" Text="{Binding ResultYCenter, StringFormat='{}{0:F4}'}" Style="{StaticResource ResultVal}"/>
                                </Grid>

                                <!-- 狀態文字 -->
                                <TextBlock Text="{Binding ProbeStatusText}" Foreground="#FFD700"
                                           FontSize="11" TextWrapping="Wrap" Margin="0,4,0,2"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Border>

                <!-- ======================================================== -->
                <!-- Col 1: 中央（底圖穿透可見） -->
                <!-- ======================================================== -->
                <!-- 留空，讓 Layer 0 背景圖穿透 -->

                <!-- ======================================================== -->
                <!-- Col 2: 3x3 九宮格（依 SelectedProbeTab 切換） -->
                <!-- ======================================================== -->
                <Grid Grid.Column="2">

                <!-- [2026-03-04] Outside Corners 九宮格 -->
                <Border Background="#33333366" CornerRadius="5"
                        Padding="8" Margin="4,0" VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedProbeTab}" Value="OutsideCorners">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <UniformGrid Rows="3" Columns="3">

                        <!-- NW：外角左上（→↓）工件在右下 -->
                        <Button Command="{Binding ProbeNWCommand}" Style="{StaticResource ProbeGridBtnStyle}"
                                ToolTip="Outside Corner NW (X+, Y-)">
                            <Canvas Width="110" Height="110">
                                <Rectangle Canvas.Left="40" Canvas.Top="40" Width="70" Height="70" Fill="#BBBBBB"/>
                                <Ellipse Canvas.Left="8" Canvas.Top="8" Width="16" Height="16" Fill="#8B5CF6"/>
                                <Line X1="8" Y1="38" X2="38" Y2="38" Stroke="#22C55E" StrokeThickness="2.5"/>
                                <Line X1="38" Y1="8" X2="38" Y2="38" Stroke="#22C55E" StrokeThickness="2.5"/>
                                <Ellipse Canvas.Left="34" Canvas.Top="34" Width="8" Height="8" Fill="#22C55E"/>
                                <Line X1="20" Y1="16" X2="34" Y2="16" Stroke="Black" StrokeThickness="2"/>
                                <Polygon Points="34,12 34,20 40,16" Fill="Black"/>
                                <Line X1="16" Y1="20" X2="16" Y2="34" Stroke="Black" StrokeThickness="2"/>
                                <Polygon Points="12,34 20,34 16,40" Fill="Black"/>
                            </Canvas>
                        </Button>

                        <!-- N：北側邊緣（↓）工件在下方 -->
                        <Button Command="{Binding ProbeNCommand}" Style="{StaticResource ProbeGridBtnStyle}"
                                ToolTip="Edge N (Y-)">
                            <Canvas Width="110" Height="110">
                                <Rectangle Canvas.Left="0" Canvas.Top="55" Width="110" Height="55" Fill="#BBBBBB"/>
                                <Ellipse Canvas.Left="47" Canvas.Top="12" Width="16" Height="16" Fill="#8B5CF6"/>
                                <Line X1="0" Y1="53" X2="110" Y2="53" Stroke="#22C55E" StrokeThickness="2.5"/>
                                <Line X1="55" Y1="32" X2="55" Y2="50" Stroke="Black" StrokeThickness="2"/>
                                <Polygon Points="51,50 59,50 55,56" Fill="Black"/>
                            </Canvas>
                        </Button>

