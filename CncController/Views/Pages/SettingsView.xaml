<UserControl x:Class="CncController.Views.Pages.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CncController.ViewModels"
             
             xmlns:views="clr-namespace:CncController.Views"
             xmlns:comp="clr-namespace:CncController.Views.Components"
             
             mc:Ignorable="d" d:DesignHeight="800" d:DesignWidth="1200">

    <UserControl.DataContext>
        <vm:SettingsViewModel/> 
    </UserControl.DataContext>

    <Grid Background="#1E1E1E">
        <TabControl Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="FontSize" Value="16"/>
                    <Setter Property="Foreground" Value="Gray"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="bd" Background="#333" Padding="20,10" Margin="0,0,2,0">
                                    <ContentPresenter ContentSource="Header"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#5E70FF"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <TabItem Header="HARDWARE SCAN" DataContext="{Binding HardwareVM}">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="60"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding StartScanCommand}" Content="SCAN BUS" Width="150" Height="40" Background="#5E70FF" Foreground="White" FontWeight="Bold"/>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="White" VerticalAlignment="Center" Margin="20,0"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Slaves}" AutoGenerateColumns="False" 
                              Background="#2D2D2D" RowBackground="#333" Foreground="White" Margin="0,20"
                              CanUserAddRows="False">

                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#333333"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                <Setter Property="BorderBrush" Value="#555"/>
                                <Setter Property="FontWeight" Value="Bold"/> 
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Index" Binding="{Binding Index}" Width="50"/>
                            <DataGridTextColumn Header="Vendor" Binding="{Binding VendorId}" Width="100"/>
                            <DataGridTextColumn Header="Product" Binding="{Binding ProductCode}" Width="100"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="AXIS MAPPING">
                <Grid Margin="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                        <comp:MachineConfigView DataContext="{Binding MachineConfigVM}"/>

                        <Button Content="UPDATE MAPPING TABLE" 
                                Command="{Binding ApplyMachineConfigCommand}"
                                Height="45" Margin="0,20,0,0" 
                                Background="#007ACC" Foreground="White" FontWeight="Bold" 
                                BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>

                    <comp:AxisMappingView Grid.Column="1" DataContext="{Binding MappingVM}"/>
                </Grid>
            </TabItem>

            <TabItem Header="AXIS PARAMETERS" DataContext="{Binding AxisVM}">
                <Grid Margin="20">
                    <ItemsControl ItemsSource="{Binding Axes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#333" Margin="0,0,0,10" Padding="15" CornerRadius="4">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" Foreground="#5E70FF" FontWeight="Bold" FontSize="18" Margin="0,0,0,10"/>
                                        <UniformGrid Columns="4" Rows="1">
                                            <StackPanel Margin="5">
                                                <TextBlock Text="Pitch (mm)" Foreground="Gray"/>
                                                <TextBox Text="{Binding Pitch}" Background="#222" Foreground="White" Padding="5"/>
                                            </StackPanel>
                                            <StackPanel Margin="5">
                                                <TextBlock Text="Pulse/Rev" Foreground="Gray"/>
                                                <TextBox Text="{Binding PulsePerRev}" Background="#222" Foreground="White" Padding="5"/>
                                            </StackPanel>
                                            <StackPanel Margin="5">
                                                <TextBlock Text="Soft Limit +" Foreground="Gray"/>
                                                <TextBox Text="{Binding SoftLimitPos}" Background="#222" Foreground="White" Padding="5"/>
                                            </StackPanel>
                                            <StackPanel Margin="5">
                                                <TextBlock Text="Home Speed" Foreground="Gray"/>
                                                <TextBox Text="{Binding HomeSpeed}" Background="#222" Foreground="White" Padding="5"/>
                                            </StackPanel>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </TabItem>

        </TabControl>

        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="20" Orientation="Horizontal">
            <TextBlock Text="{Binding DeployStatus}" Foreground="#AAA" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <Button Command="{Binding GenerateAndDeployCommand}" Content="GENERATE &amp; RESTART" Width="200" Height="40" Background="#28a745" Foreground="White" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</UserControl>