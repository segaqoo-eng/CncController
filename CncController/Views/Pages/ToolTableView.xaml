<!-- [2026-03-03] 新增 ToolTableView：刀具表管理頁面（對齊 PB 版 TOOL.png）
     TOOL_BACK.png 為整頁背景，TOOL TABLE DataGrid + 右側面板全部浮在圖上 -->
<UserControl x:Class="CncController.Views.Pages.ToolTableView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:CncController.ViewModels"
             xmlns:helpers="clr-namespace:CncController.Helpers"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ToolTableViewModel}"
             FontFamily="{DynamicResource FontFamily.Default}"
             d:DesignHeight="700" d:DesignWidth="1700">

    <UserControl.Resources>
        <!-- [2026-03-03] BindingProxy：讓 DataGridColumn 可綁定 ViewModel 的軸可見性屬性 -->
        <helpers:BindingProxy x:Key="Proxy" Data="{Binding}"/>

        <!-- [2026-03-04] 通用按鈕 → 繼承全域 BaseBtnStyle（移除本地 Template） -->
        <Style x:Key="ToolBtnStyle" TargetType="Button" BasedOn="{StaticResource BaseBtnStyle}">
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Small}"/>
            <Setter Property="Padding" Value="{DynamicResource BtnPadding.Small}"/>
            <Setter Property="Margin" Value="3"/>
        </Style>

        <!-- [2026-03-04] 右側面板大按鈕 → 繼承 ToolBtnStyle（間接繼承 BaseBtnStyle） -->
        <Style x:Key="PanelBtnStyle" TargetType="Button" BasedOn="{StaticResource ToolBtnStyle}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}"/>
            <Setter Property="Margin" Value="4,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <!-- [2026-03-03] 最外層 Grid：Layer 0 = 背景圖，Layer 1 = 所有 UI 浮在上面 -->
    <Grid ClipToBounds="True">

        <!-- Layer 0: TOOL_BACK.png 填滿整個頁面背景 -->
        <Image Source="/Resources/Images/TOOL_BACK.png"
               Stretch="UniformToFill" HorizontalAlignment="Right" VerticalAlignment="Center"/>

        <!-- Layer 1: 所有 UI 元素浮在背景圖上方 -->
        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="55*"/>
                <ColumnDefinition Width="45*"/>
            </Grid.ColumnDefinitions>

            <!-- ========== 左欄：TOOL TABLE (DataGrid) — 半透明深色底，浮在背景圖上 ========== -->
            <Border Grid.Column="0" Background="#E8252526" BorderBrush="#444" BorderThickness="1"
                    CornerRadius="4" Margin="0,0,5,0">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" Text="TOOL TABLE" Foreground="#AAAAAA"
                               FontSize="{DynamicResource FontSize.Body}" FontWeight="Bold" Margin="0,0,0,6"/>

                    <!-- 底部按鈕列 -->
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0"
                                HorizontalAlignment="Left">
                        <!-- [2026-03-11] 移除 inline 色彩，統一 BaseBtnStyle 深灰漸層 -->
                        <Button Content="DELETE" Style="{StaticResource ToolBtnStyle}"
                                Command="{Binding DeleteToolCommand}" Width="80"/>
                        <Button Content="ADD TOOL" Style="{StaticResource ToolBtnStyle}"
                                Command="{Binding AddToolCommand}" Width="90"/>
                        <Button Content="SAVE TABLE" Style="{StaticResource ToolBtnStyle}"
                                Command="{Binding SaveTableCommand}" Width="100"/>
                        <Button Content="RELOAD TABLE" Style="{StaticResource ToolBtnStyle}"
                                Command="{Binding ReloadTableCommand}" Width="110"/>
                    </StackPanel>

                    <!-- DataGrid -->
                    <DataGrid ItemsSource="{Binding ToolTable}"
                              SelectedItem="{Binding SelectedTool}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#333"
                              Background="#2D2D2D"
                              RowBackground="#2D2D2D"
                              AlternatingRowBackground="#292929"
                              Foreground="White"
                              BorderThickness="0"
                              ColumnHeaderHeight="28"
                              RowHeight="28">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#333"/>
                                <Setter Property="Foreground" Value="#AAAAAA"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize" Value="{DynamicResource FontSize.Small}"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="4"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="4,2"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#00539C"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <!-- [2026-03-03] 欄位依啟用軸動態顯示：XYZ 永遠顯示，ABC 依 MachineType -->
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="TOOL" Binding="{Binding ToolNumber}" Width="50" IsReadOnly="True"/>
                            <DataGridTextColumn Header="POCKET" Binding="{Binding Pocket}" Width="60"/>
                            <DataGridTextColumn Header="X OFFSET" Binding="{Binding XOffset, StringFormat=F4}" Width="*"/>
                            <DataGridTextColumn Header="Y OFFSET" Binding="{Binding YOffset, StringFormat=F4}" Width="*"/>
                            <DataGridTextColumn Header="Z OFFSET" Binding="{Binding ZOffset, StringFormat=F4}" Width="*"/>
                            <DataGridTextColumn Header="A OFFSET" Binding="{Binding AOffset, StringFormat=F4}" Width="*"
                                                Visibility="{Binding Data.IsAxisAEnabled, Source={StaticResource Proxy}, Converter={StaticResource BoolToVis}}"/>
                            <DataGridTextColumn Header="B OFFSET" Binding="{Binding BOffset, StringFormat=F4}" Width="*"
                                                Visibility="{Binding Data.IsAxisBEnabled, Source={StaticResource Proxy}, Converter={StaticResource BoolToVis}}"/>
                            <DataGridTextColumn Header="C OFFSET" Binding="{Binding COffset, StringFormat=F4}" Width="*"
                                                Visibility="{Binding Data.IsAxisCEnabled, Source={StaticResource Proxy}, Converter={StaticResource BoolToVis}}"/>
                            <DataGridTextColumn Header="U OFFSET" Binding="{Binding UOffset, StringFormat=F4}" Width="*"
                                                Visibility="{Binding Data.IsAxisUEnabled, Source={StaticResource Proxy}, Converter={StaticResource BoolToVis}}"/>
                            <DataGridTextColumn Header="V OFFSET" Binding="{Binding VOffset, StringFormat=F4}" Width="*"
                                                Visibility="{Binding Data.IsAxisVEnabled, Source={StaticResource Proxy}, Converter={StaticResource BoolToVis}}"/>
                            <DataGridTextColumn Header="W OFFSET" Binding="{Binding WOffset, StringFormat=F4}" Width="*"
                                                Visibility="{Binding Data.IsAxisWEnabled, Source={StaticResource Proxy}, Converter={StaticResource BoolToVis}}"/>
                            <DataGridTextColumn Header="DIAMETER" Binding="{Binding Diameter, StringFormat=F4}" Width="*"/>
                            <!-- [2026-03-03] 新增 FNT ANG / BAK ANG / ORIENT 欄位（對齊 PB 版 TOOLPARAM） -->
                            <DataGridTextColumn Header="FNT ANG" Binding="{Binding FrontAngle, StringFormat=F4}" Width="*"/>
                            <DataGridTextColumn Header="BAK ANG" Binding="{Binding BackAngle, StringFormat=F4}" Width="*"/>
                            <DataGridTextColumn Header="ORIENT" Binding="{Binding Orientation}" Width="55"/>
                            <DataGridTextColumn Header="REMARK" Binding="{Binding Remark}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- ========== 右欄：UI 元素浮在背景圖上（背景圖從 Layer 0 穿透可見） ========== -->
            <DockPanel Grid.Column="1" Margin="5,0,0,0">

                <!-- ===== 頂部：COMMENT ===== -->
                <Border DockPanel.Dock="Top" Background="#DD333333" CornerRadius="3" Padding="6,4" Margin="0,0,0,6"
                        BorderBrush="#666" BorderThickness="1">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="REMARK" Foreground="#CCC" FontSize="{DynamicResource FontSize.Body}" FontWeight="Bold"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Text="{Binding SelectedTool.Remark, UpdateSourceTrigger=PropertyChanged}"
                                 Background="White" Foreground="Black" FontSize="{DynamicResource FontSize.Body}" FontWeight="Bold" Padding="6,3"
                                 BorderBrush="#888" BorderThickness="1"/>
                    </DockPanel>
                </Border>

                <!-- ===== 底部：MDI ===== -->
                <Border DockPanel.Dock="Bottom" Background="#DD333333" CornerRadius="3" Padding="6,4" Margin="0,6,0,0"
                        BorderBrush="#666" BorderThickness="1">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="MDI" Foreground="#CCC" FontSize="{DynamicResource FontSize.Body}" FontWeight="Bold"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding MdiInput, UpdateSourceTrigger=PropertyChanged}"
                                 Background="White" Foreground="Black" FontSize="{DynamicResource FontSize.Body}" Padding="6,3"
                                 BorderBrush="#888" BorderThickness="1"/>
                    </DockPanel>
                </Border>

                <!-- [2026-03-03] 中間主區域：Canvas 直接 Left/Top 像素定位，對齊 DIFF3.PNG -->
                <Grid>
                    <Canvas>
                        <!-- 咖啡色框：T{n} 刀具號（夾頭處） -->
                        <Border Canvas.Left="370" Canvas.Top="220" Background="White" CornerRadius="3" Padding="10,3"
                                BorderBrush="#666" BorderThickness="1">
                            <TextBlock Foreground="Black" FontSize="{DynamicResource FontSize.Medium}" FontWeight="Bold" HorizontalAlignment="Center">
                                <Run Text="T"/>
                                <Run Text="{Binding MachineStatus.ToolNumber, Mode=OneWay}"/>
                            </TextBlock>
                        </Border>

                        <!-- 紅色框：TOOL LENGTH（垂直箭頭↕旁） -->
                        <StackPanel Canvas.Left="170" Canvas.Top="300" Orientation="Horizontal">
                            <TextBlock Text="TOOL&#x0a;LENGTH" Foreground="White" FontSize="{DynamicResource FontSize.Small}" FontWeight="Bold"
                                       VerticalAlignment="Center" Margin="0,0,4,0" TextAlignment="Right">
                                <TextBlock.Effect>
                                    <DropShadowEffect ShadowDepth="1" Color="Black" Opacity="0.8" BlurRadius="3"/>
                                </TextBlock.Effect>
                            </TextBlock>
                            <Border Background="White" CornerRadius="2" Padding="8,4"
                                    BorderBrush="#666" BorderThickness="1">
                                <TextBlock Text="{Binding MachineStatus.ToolLength, StringFormat={}{0:F4}, Mode=OneWay}"
                                           Foreground="Black" FontFamily="Consolas" FontSize="{DynamicResource FontSize.Medium}" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>

                        <!-- 綠色框：DIAM（水平箭頭↔旁） -->
                        <StackPanel Canvas.Left="230" Canvas.Top="480" Orientation="Horizontal">
                            <TextBlock Text="DIAM" Foreground="White" FontSize="{DynamicResource FontSize.Small}" FontWeight="Bold"
                                       VerticalAlignment="Center" Margin="0,0,4,0">
                                <TextBlock.Effect>
                                    <DropShadowEffect ShadowDepth="1" Color="Black" Opacity="0.8" BlurRadius="3"/>
                                </TextBlock.Effect>
                            </TextBlock>
                            <Border Background="White" CornerRadius="2" Padding="8,4"
                                    BorderBrush="#666" BorderThickness="1">
                                <TextBlock Text="{Binding MachineStatus.ToolDiameter, StringFormat={}{0:F4}, Mode=OneWay}"
                                           Foreground="Black" FontFamily="Consolas" FontSize="{DynamicResource FontSize.Medium}" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                    </Canvas>

                    <!-- 黃色框：TOOL CHANGE PANEL（最右側） -->
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,70,10,0" Width="210">

                        <!-- [2026-03-11] TOOL CHANGE PANEL 標題（統一 PanelTitle） -->
                        <Border Style="{StaticResource PanelTitleBorder}" Margin="0,0,0,6">
                            <TextBlock Text="TOOL CHANGE PANEL" Style="{StaticResource PanelTitleText}"/>
                        </Border>

                        <!-- [n] LOAD SPINDLE -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="White" CornerRadius="2" Margin="0,0,4,0"
                                    BorderBrush="#666" BorderThickness="1">
                                <TextBox Text="{Binding ChangeToolNumber, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent" Foreground="Black" FontSize="{DynamicResource FontSize.Medium}" FontWeight="Bold"
                                         TextAlignment="Center" BorderThickness="0" VerticalContentAlignment="Center"
                                         Padding="2"/>
                            </Border>
                            <Button Grid.Column="1" Content="LOAD SPINDLE" Style="{StaticResource PanelBtnStyle}"
                                    Command="{Binding LoadSpindleCommand}" Background="#444" BorderBrush="#666"/>
                        </Grid>

                        <!-- UNLOAD SPINDLE -->
                        <Button Content="UNLOAD SPINDLE" Style="{StaticResource PanelBtnStyle}"
                                Command="{Binding UnloadSpindleCommand}" Background="#444" BorderBrush="#666"/>

                        <!-- [n] M6 G43 -->
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="White" CornerRadius="2" Margin="0,0,4,0"
                                    BorderBrush="#666" BorderThickness="1">
                                <TextBox Text="{Binding ChangeToolNumber, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent" Foreground="Black" FontSize="{DynamicResource FontSize.Medium}" FontWeight="Bold"
                                         TextAlignment="Center" BorderThickness="0" VerticalContentAlignment="Center"
                                         Padding="2"/>
                            </Border>
                            <Button Grid.Column="1" Content="M6 G43" Style="{StaticResource PanelBtnStyle}"
                                    Command="{Binding M6G43Command}" Background="#444" BorderBrush="#666"/>
                        </Grid>

                        <Separator Background="Transparent" Margin="0,8,0,8"/>

                        <!-- ELECTRONIC TOOL SETTER -->
                        <Button Content="ELECTRONIC TOOL SETTER" Style="{StaticResource PanelBtnStyle}"
                                Command="{Binding ElectronicToolSetterCommand}" Background="#444" BorderBrush="#666"/>

                        <!-- TOUCH OFF CURRENT TOOL -->
                        <Button Content="TOUCH OFF CURRENT TOOL" Style="{StaticResource PanelBtnStyle}"
                                Command="{Binding TouchOffCurrentToolCommand}" Background="#444" BorderBrush="#666"/>
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
