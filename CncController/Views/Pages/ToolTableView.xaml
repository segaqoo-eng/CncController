<!-- [2026-03-03] 新增 ToolTableView：刀具表管理頁面（對齊 PB 版 TOOL.png）
     TOOL_BACK.png 為整頁背景，TOOL TABLE DataGrid + 右側面板全部浮在圖上 -->
<UserControl x:Class="CncController.Views.Pages.ToolTableView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:CncController.ViewModels"
             xmlns:helpers="clr-namespace:CncController.Helpers"
             xmlns:controls="clr-namespace:CncController.Views.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ToolTableViewModel}"
             FontFamily="{DynamicResource FontFamily.Default}"
             d:DesignHeight="700" d:DesignWidth="1700">

    <UserControl.Resources>
        <!-- [2026-03-03] BindingProxy：讓 DataGridColumn 可綁定 ViewModel 的軸可見性屬性 -->
        <helpers:BindingProxy x:Key="Proxy" Data="{Binding}"/>

        <!-- [2026-03-04] 通用按鈕 → 繼承全域 BaseBtnStyle（移除本地 Template） -->
        <!-- [2026-03-11] 字體加大 FontSize.Large + Height 45 + Padding 加大 -->
        <Style x:Key="ToolBtnStyle" TargetType="Button" BasedOn="{StaticResource BaseBtnStyle}">
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Large}"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="3"/>
        </Style>

        <!-- [2026-03-11] 右側面板按鈕加大 Height 45 + FontSize.Large -->
        <Style x:Key="PanelBtnStyle" TargetType="Button" BasedOn="{StaticResource ToolBtnStyle}">
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Large}"/>
            <Setter Property="Margin" Value="4,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <!-- [2026-03-11] 最外層 Grid：移除 TOOL_BACK.png 背景圖，改用自繪刀具 -->
    <Grid ClipToBounds="True">
        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="55*"/>
                <ColumnDefinition Width="45*"/>
            </Grid.ColumnDefinitions>

            <!-- ========== 左欄：TOOL TABLE (DataGrid) — 半透明深色底，浮在背景圖上 ========== -->
            <Border Grid.Column="0" Background="#E8252526" BorderBrush="#444" BorderThickness="1"
                    CornerRadius="4" Margin="0,0,5,0">
                <DockPanel Margin="8">
                    <!-- [2026-03-11] TOOL TABLE 標題字體加大 FontSize.XLarge -->
                    <!-- [2026-03-11] i18n: TOOL TABLE -->
                    <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Str.Tool.Table}" Foreground="#AAAAAA"
                               FontSize="{DynamicResource FontSize.XLarge}" FontWeight="Bold" Margin="0,0,0,6"/>

                    <!-- 底部按鈕列 -->
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0"
                                HorizontalAlignment="Left">
                        <!-- [2026-03-11] 移除 inline 色彩，統一 BaseBtnStyle 深灰漸層 -->
                        <!-- [2026-03-11] 按鈕寬度加大配合 FontSize.Large -->
                        <Button Content="{DynamicResource Str.Btn.Delete}" Style="{StaticResource ToolBtnStyle}"
                                Command="{Binding DeleteToolCommand}" Width="100"/>
                        <Button Content="{DynamicResource Str.Btn.AddTool}" Style="{StaticResource ToolBtnStyle}"
                                Command="{Binding AddToolCommand}" Width="120"/>
                        <Button Content="{DynamicResource Str.Btn.SaveTable}" Style="{StaticResource ToolBtnStyle}"
                                Command="{Binding SaveTableCommand}" Width="130"/>
                        <Button Content="{DynamicResource Str.Btn.ReloadTable}" Style="{StaticResource ToolBtnStyle}"
                                Command="{Binding ReloadTableCommand}" Width="150"/>
                    </StackPanel>

                    <!-- DataGrid -->
                    <DataGrid ItemsSource="{Binding ToolTable}"
                              SelectedItem="{Binding SelectedTool}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#333"
                              Background="#2D2D2D"
                              RowBackground="#2D2D2D"
                              AlternatingRowBackground="#292929"
                              Foreground="White"
                              BorderThickness="0"
                              ColumnHeaderHeight="34"
                              RowHeight="34">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#333"/>
                                <Setter Property="Foreground" Value="#AAAAAA"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <!-- [2026-03-11] 欄位標頭字體加大 Small→Large -->
                                <Setter Property="FontSize" Value="{DynamicResource FontSize.Large}"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="4"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <!-- [2026-03-11] DataGrid 內容字體加大 FontSize.Large -->
                                <Setter Property="FontSize" Value="{DynamicResource FontSize.Large}"/>
                                <Setter Property="Padding" Value="4,2"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#00539C"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <!-- [2026-03-03] 欄位依啟用軸動態顯示：XYZ 永遠顯示，ABC 依 MachineType -->
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="TOOL" Binding="{Binding ToolNumber}" Width="50" IsReadOnly="True"/>
                            <DataGridTextColumn Header="POCKET" Binding="{Binding Pocket}" Width="60"/>
                            <DataGridTextColumn Header="X OFFSET" Binding="{Binding XOffset, StringFormat=F4}" Width="*"/>
                            <DataGridTextColumn Header="Y OFFSET" Binding="{Binding YOffset, StringFormat=F4}" Width="*"/>
                            <DataGridTextColumn Header="Z OFFSET" Binding="{Binding ZOffset, StringFormat=F4}" Width="*"/>
                            <DataGridTextColumn Header="A OFFSET" Binding="{Binding AOffset, StringFormat=F4}" Width="*"
                                                Visibility="{Binding Data.IsAxisAEnabled, Source={StaticResource Proxy}, Converter={StaticResource BoolToVis}}"/>
                            <DataGridTextColumn Header="B OFFSET" Binding="{Binding BOffset, StringFormat=F4}" Width="*"
                                                Visibility="{Binding Data.IsAxisBEnabled, Source={StaticResource Proxy}, Converter={StaticResource BoolToVis}}"/>
                            <DataGridTextColumn Header="C OFFSET" Binding="{Binding COffset, StringFormat=F4}" Width="*"
                                                Visibility="{Binding Data.IsAxisCEnabled, Source={StaticResource Proxy}, Converter={StaticResource BoolToVis}}"/>
                            <DataGridTextColumn Header="U OFFSET" Binding="{Binding UOffset, StringFormat=F4}" Width="*"
                                                Visibility="{Binding Data.IsAxisUEnabled, Source={StaticResource Proxy}, Converter={StaticResource BoolToVis}}"/>
                            <DataGridTextColumn Header="V OFFSET" Binding="{Binding VOffset, StringFormat=F4}" Width="*"
                                                Visibility="{Binding Data.IsAxisVEnabled, Source={StaticResource Proxy}, Converter={StaticResource BoolToVis}}"/>
                            <DataGridTextColumn Header="W OFFSET" Binding="{Binding WOffset, StringFormat=F4}" Width="*"
                                                Visibility="{Binding Data.IsAxisWEnabled, Source={StaticResource Proxy}, Converter={StaticResource BoolToVis}}"/>
                            <DataGridTextColumn Header="DIAMETER" Binding="{Binding Diameter, StringFormat=F4}" Width="*"/>
                            <!-- [2026-03-03] 新增 FNT ANG / BAK ANG / ORIENT 欄位（對齊 PB 版 TOOLPARAM） -->
                            <DataGridTextColumn Header="FNT ANG" Binding="{Binding FrontAngle, StringFormat=F4}" Width="*"/>
                            <DataGridTextColumn Header="BAK ANG" Binding="{Binding BackAngle, StringFormat=F4}" Width="*"/>
                            <DataGridTextColumn Header="ORIENT" Binding="{Binding Orientation}" Width="55"/>
                            <DataGridTextColumn Header="REMARK" Binding="{Binding Remark}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- ========== 右欄：UI 元素浮在背景圖上（背景圖從 Layer 0 穿透可見） ========== -->
            <DockPanel Grid.Column="1" Margin="5,0,0,0">

                <!-- ===== 頂部：COMMENT ===== -->
                <Border DockPanel.Dock="Top" Background="#DD333333" CornerRadius="3" Padding="6,4" Margin="0,0,0,6"
                        BorderBrush="#666" BorderThickness="1">
                    <DockPanel>
                        <!-- [2026-03-11] REMARK 標籤和輸入框字體加大 FontSize.Large -->
                        <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Str.Tool.Remark}" Foreground="#CCC" FontSize="{DynamicResource FontSize.Large}" FontWeight="Bold"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Text="{Binding SelectedTool.Remark, UpdateSourceTrigger=PropertyChanged}"
                                 Background="White" Foreground="Black" FontSize="{DynamicResource FontSize.Large}" FontWeight="Bold" Padding="6,3"
                                 BorderBrush="#888" BorderThickness="1"/>
                    </DockPanel>
                </Border>

                <!-- ===== 底部：MDI ===== -->
                <Border DockPanel.Dock="Bottom" Background="#DD333333" CornerRadius="3" Padding="6,4" Margin="0,6,0,0"
                        BorderBrush="#666" BorderThickness="1">
                    <DockPanel>
                        <!-- [2026-03-11] MDI 標籤和輸入框字體加大 FontSize.Large -->
                        <TextBlock DockPanel.Dock="Left" Text="MDI" Foreground="#CCC" FontSize="{DynamicResource FontSize.Large}" FontWeight="Bold"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding MdiInput, UpdateSourceTrigger=PropertyChanged}"
                                 Background="White" Foreground="Black" FontSize="{DynamicResource FontSize.Large}" Padding="6,3"
                                 BorderBrush="#888" BorderThickness="1"/>
                    </DockPanel>
                </Border>

                <!-- [2026-03-11] 中間主區域：自繪刀具圖 + TOOL CHANGE PANEL -->
                <Grid>
                    <!-- [2026-03-11] 自繪刀具圖示（取代 TOOL_BACK.png + Canvas 像素定位） -->
                    <controls:ToolDisplayControl
                        HorizontalAlignment="Left" VerticalAlignment="Stretch"
                        Margin="10,0,0,0"
                        ToolNumber="{Binding MachineStatus.ToolNumber, Mode=OneWay}"
                        ToolLength="{Binding MachineStatus.ToolLength, Mode=OneWay}"
                        ToolDiameter="{Binding MachineStatus.ToolDiameter, Mode=OneWay}"/>

                    <!-- TOOL CHANGE PANEL（最右側） -->
                    <!-- [2026-03-11] 右側面板寬度加大 210→260 配合按鈕加大 -->
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,70,10,0" Width="260">

                        <!-- [2026-03-11] TOOL CHANGE PANEL 標題（統一 PanelTitle） -->
                        <Border Style="{StaticResource PanelTitleBorder}" Margin="0,0,0,6">
                            <TextBlock Text="{DynamicResource Str.Tool.ChangePanel}" Style="{StaticResource PanelTitleText}"/>
                        </Border>

                        <!-- [2026-03-11] 右側按鈕移除 inline Background/BorderBrush，統一由 BaseBtnStyle 控制 -->
                        <!-- [n] LOAD SPINDLE -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="White" CornerRadius="2" Margin="0,0,4,0"
                                    BorderBrush="#666" BorderThickness="1">
                                <TextBox Text="{Binding ChangeToolNumber, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent" Foreground="Black" FontSize="{DynamicResource FontSize.Large}" FontWeight="Bold"
                                         TextAlignment="Center" BorderThickness="0" VerticalContentAlignment="Center"
                                         Padding="2"/>
                            </Border>
                            <Button Grid.Column="1" Content="{DynamicResource Str.Tool.LoadSpindle}" Style="{StaticResource PanelBtnStyle}"
                                    Command="{Binding LoadSpindleCommand}"/>
                        </Grid>

                        <!-- UNLOAD SPINDLE -->
                        <Button Content="{DynamicResource Str.Tool.UnloadSpindle}" Style="{StaticResource PanelBtnStyle}"
                                Command="{Binding UnloadSpindleCommand}"/>

                        <!-- [n] M6 G43 -->
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="White" CornerRadius="2" Margin="0,0,4,0"
                                    BorderBrush="#666" BorderThickness="1">
                                <TextBox Text="{Binding ChangeToolNumber, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent" Foreground="Black" FontSize="{DynamicResource FontSize.Large}" FontWeight="Bold"
                                         TextAlignment="Center" BorderThickness="0" VerticalContentAlignment="Center"
                                         Padding="2"/>
                            </Border>
                            <Button Grid.Column="1" Content="M6 G43" Style="{StaticResource PanelBtnStyle}"
                                    Command="{Binding M6G43Command}"/>
                        </Grid>

                        <Separator Background="Transparent" Margin="0,8,0,8"/>

                        <!-- ELECTRONIC TOOL SETTER -->
                        <Button Content="{DynamicResource Str.Tool.ElectronicToolSetter}" Style="{StaticResource PanelBtnStyle}"
                                Command="{Binding ElectronicToolSetterCommand}"/>

                        <!-- TOUCH OFF CURRENT TOOL -->
                        <Button Content="{DynamicResource Str.Tool.TouchOffCurrentTool}" Style="{StaticResource PanelBtnStyle}"
                                Command="{Binding TouchOffCurrentToolCommand}"/>
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
