<Window x:Class="CncController.Views.Windows.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login" Height="300" Width="400"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Panel.Secondary}" BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="1"
        FontFamily="{DynamicResource FontFamily.Default}">

    <Grid>
        <StackPanel VerticalAlignment="Center" Margin="40">
            <TextBlock Text="SYSTEM LOGIN" Foreground="{DynamicResource Brush.Text.Primary}" FontSize="{DynamicResource FontSize.DRO}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,30"/>

            <TextBlock Text="Password:" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,0,0,5"/>
            <PasswordBox x:Name="TxtPassword" 
                         Height="40" FontSize="{DynamicResource FontSize.XLarge}"
                         Background="{DynamicResource Brush.Input.Background}" Foreground="{DynamicResource Brush.Text.Primary}"
                         BorderThickness="0" Padding="5"
                         HorizontalContentAlignment="Center"/>

            <Button Content="LOGIN" Click="BtnLogin_Click"
                    Height="45" Margin="0,30,0,0"
                    Background="{DynamicResource Brush.Accent}" Foreground="{DynamicResource Brush.Text.Primary}"
                    FontWeight="Bold" FontSize="{DynamicResource FontSize.Large}" BorderThickness="0" Cursor="Hand"/>

            <Button Content="Cancel" IsCancel="True"
                    Height="30" Margin="0,10,0,0"
                    Background="Transparent" Foreground="{DynamicResource Brush.Text.Dim}" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>