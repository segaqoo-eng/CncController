<!-- [2026-03-12] 主軸暖機對話框：逐步升速 + 進度顯示 + 可中斷 -->
<Window x:Class="CncController.Views.Windows.SpindleWarmupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CncController.ViewModels"
        Title="{DynamicResource Str.Warmup.Title}" Height="520" Width="480"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Panel.Secondary}"
        BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="1"
        FontFamily="{DynamicResource FontFamily.Default}">

    <Window.DataContext>
        <vm:SpindleWarmupViewModel/>
    </Window.DataContext>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 標題 -->
        <Border Grid.Row="0" Style="{StaticResource PanelTitleBorder}" Margin="0,0,0,10">
            <TextBlock Text="{DynamicResource Str.Warmup.Title}" Style="{StaticResource PanelTitleText}"
                       TextAlignment="Center" FontSize="{DynamicResource FontSize.XLarge}"/>
        </Border>

        <!-- 階梯清單 DataGrid -->
        <DataGrid x:Name="StepsGrid" Grid.Row="1" ItemsSource="{Binding Steps}" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  Background="{DynamicResource Brush.PanelBackground}"
                  Foreground="{DynamicResource Brush.Text.Primary}"
                  BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                  RowBackground="{DynamicResource Brush.Panel.Secondary}"
                  AlternatingRowBackground="{DynamicResource Brush.Panel.Overlay}"
                  FontSize="{DynamicResource FontSize.Body}"
                  RowHeight="32" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{DynamicResource Brush.Border}"
                  SelectionMode="Single" IsReadOnly="{Binding IsRunning}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="RPM" Width="100"
                                    Binding="{Binding Rpm, UpdateSourceTrigger=PropertyChanged}"/>
                <DataGridTextColumn Header="{DynamicResource Str.Warmup.Duration}" Width="100"
                                    Binding="{Binding DurationSeconds, UpdateSourceTrigger=PropertyChanged}"/>
                <DataGridTemplateColumn Header="{DynamicResource Str.Warmup.Status}" Width="*" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                                <Ellipse Width="10" Height="10" Margin="0,0,6,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="Gray"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StepStatus}" Value="Running">
                                                    <Setter Property="Fill" Value="#FFD700"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StepStatus}" Value="Done">
                                                    <Setter Property="Fill" Value="Lime"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StepStatus}" Value="Skipped">
                                                    <Setter Property="Fill" Value="#FF4444"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding StepStatus}" Foreground="{DynamicResource Brush.Text.Secondary}"
                                           FontSize="{DynamicResource FontSize.Small}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 新增/移除步驟（暖機執行中隱藏） -->
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="RPM:" Foreground="{DynamicResource Brush.Text.Secondary}"
                       VerticalAlignment="Center" Margin="0,0,4,0" FontSize="{DynamicResource FontSize.Body}"/>
            <TextBox Grid.Column="1" Text="{Binding NewStepRpm, UpdateSourceTrigger=PropertyChanged}"
                     Background="White" Foreground="Black" FontSize="{DynamicResource FontSize.Body}"
                     TextAlignment="Center" VerticalContentAlignment="Center" Padding="2" Margin="0,0,8,0"/>
            <TextBlock Grid.Column="2" Text="{DynamicResource Str.Warmup.Seconds}" Foreground="{DynamicResource Brush.Text.Secondary}"
                       VerticalAlignment="Center" Margin="0,0,4,0" FontSize="{DynamicResource FontSize.Body}"/>
            <TextBox Grid.Column="3" Text="{Binding NewStepDuration, UpdateSourceTrigger=PropertyChanged}"
                     Background="White" Foreground="Black" FontSize="{DynamicResource FontSize.Body}"
                     TextAlignment="Center" VerticalContentAlignment="Center" Padding="2" Margin="0,0,8,0"/>
            <Button Grid.Column="4" Content="{DynamicResource Str.Warmup.AddStep}" Style="{StaticResource BaseBtnStyle}"
                    Command="{Binding AddStepCommand}" FontSize="{DynamicResource FontSize.Body}" Padding="10,4" Margin="0,0,4,0"/>
            <Button Grid.Column="5" Content="{DynamicResource Str.Warmup.RemoveStep}" Style="{StaticResource BaseBtnStyle}"
                    Command="{Binding RemoveStepCommand}"
                    CommandParameter="{Binding SelectedItem, ElementName=StepsGrid}"
                    FontSize="{DynamicResource FontSize.Body}" Padding="10,4"/>
        </Grid>

        <!-- 整體進度條 -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <ProgressBar Height="24" Minimum="0" Maximum="100" Value="{Binding OverallProgress}"
                         Background="{DynamicResource Brush.Panel.Overlay}"
                         Foreground="{DynamicResource Brush.Accent}" BorderThickness="0"/>
            <TextBlock Text="{Binding OverallProgress, StringFormat={}{0:F0}%}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontWeight="Bold" FontSize="{DynamicResource FontSize.Body}"
                       Foreground="White"/>
        </Grid>

        <!-- 狀態文字 -->
        <TextBlock Grid.Row="4" Text="{Binding StatusText}" Margin="0,8,0,0"
                   Foreground="{DynamicResource Brush.Text.Primary}" FontSize="{DynamicResource FontSize.Large}"
                   FontWeight="Bold" HorizontalAlignment="Center"/>

        <!-- 按鈕列 -->
        <UniformGrid Grid.Row="5" Rows="1" Columns="3" Margin="0,12,0,0">
            <!-- START：非執行中才啟用 -->
            <Button Content="{DynamicResource Str.Warmup.Start}"
                    Command="{Binding StartWarmupCommand}"
                    FontSize="{DynamicResource FontSize.Large}" FontWeight="Bold"
                    Padding="8,10" Margin="4">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource BaseBtnStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <!-- STOP：執行中才啟用 -->
            <Button Content="{DynamicResource Str.Btn.Stop}" Style="{StaticResource BaseBtnStyle}"
                    Command="{Binding StopWarmupCommand}"
                    FontSize="{DynamicResource FontSize.Large}" FontWeight="Bold"
                    Padding="8,10" Margin="4"
                    IsEnabled="{Binding IsRunning}"/>
            <!-- CLOSE -->
            <Button Content="{DynamicResource Str.Warmup.Close}" Style="{StaticResource BaseBtnStyle}"
                    Click="CloseButton_Click"
                    FontSize="{DynamicResource FontSize.Large}" FontWeight="Bold"
                    Padding="8,10" Margin="4"/>
        </UniformGrid>
    </Grid>
</Window>
