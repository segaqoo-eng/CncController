net Pin27 => lcec.0.13.dout-27
net Pin28 => lcec.0.13.dout-28
net Pin29 => lcec.0.13.dout-29
net Pin30 => lcec.0.13.dout-30
net Pin31 => lcec.0.13.dout-31


# --- SAFETY BYPASS (FORCE CONNECTION) ---
unlinkp iocontrol.0.emc-enable-in
net logic-enable iocontrol.0.user-enable-out => iocontrol.0.emc-enable-in


# --- 自動執行 IO 解鎖腳本 ---
# -W 代表 Wait (等待腳本跑完再繼續啟動)，確保解鎖成功
#loadusr -W ./unlock_io.sh

