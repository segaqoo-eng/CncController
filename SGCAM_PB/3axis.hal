# Generated by CncController (Smart Feedback + IO Support)
loadrt [KINS]KINEMATICS
loadrt [EMCMOT]EMCMOT servo_period_nsec=[EMCMOT]SERVO_PERIOD num_joints=[KINS]JOINTS
loadrt cia402 count=3
loadrt bitslice names=slice_X,slice_Y,slice_Z personality=32,32,32
loadrt not count=9
loadusr -W lcec_conf ethercat-conf.xml
loadrt lcec

addf lcec.read-all servo-thread
addf slice_X servo-thread
addf slice_Y servo-thread
addf slice_Z servo-thread
addf cia402.0.read-all servo-thread
addf cia402.1.read-all servo-thread
addf cia402.2.read-all servo-thread
addf not.0 servo-thread
addf not.1 servo-thread
addf not.2 servo-thread
addf not.3 servo-thread
addf not.4 servo-thread
addf not.5 servo-thread
addf not.6 servo-thread
addf not.7 servo-thread
addf not.8 servo-thread
addf motion-command-handler servo-thread
addf motion-controller servo-thread
addf cia402.0.write-all servo-thread
addf cia402.1.write-all servo-thread
addf cia402.2.write-all servo-thread
addf lcec.write-all servo-thread

# --- Axis X (Slave 0) [Type: Servo] ---
net X-enable  joint.0.amp-enable-out => cia402.0.enable
net X-control cia402.0.controlword => lcec.0.0.control_word_J0
net X-status  lcec.0.0.status_word_J0 => cia402.0.statusword
setp cia402.0.csp-mode 1
setp lcec.0.0.modes_of_operation_J0 8
setp cia402.0.pos-scale [JOINT_0]STEP_SCALE
net X-pos-cmd joint.0.motor-pos-cmd => cia402.0.pos-cmd
net X-drv-target cia402.0.drv-target-position => lcec.0.0.target_position_J0
net X-pos-fb lcec.0.0.position_actual_value_J0 => cia402.0.drv-actual-position
# [Feedback] Real Encoder Feedback (Closed Loop)
net X-pos-fb-final cia402.0.pos-fb => joint.0.motor-pos-fb
net X-di-raw lcec.0.0.digital_inputs_J0 => slice_X.in
# Homing: Immediate
net X-neg-lim joint.0.neg-lim-sw-in <= slice_X.out-01
net X-pos-lim joint.0.pos-lim-sw-in <= slice_X.out-00

# --- Axis Y (Slave 2) [Type: Servo] ---
net Y-enable  joint.1.amp-enable-out => cia402.1.enable
net Y-control cia402.1.controlword => lcec.0.2.control_word_J2
net Y-status  lcec.0.2.status_word_J2 => cia402.1.statusword
setp cia402.1.csp-mode 1
setp cia402.1.pos-scale [JOINT_1]STEP_SCALE
net Y-pos-cmd joint.1.motor-pos-cmd => cia402.1.pos-cmd
net Y-drv-target cia402.1.drv-target-position => lcec.0.2.target_position_J2
net Y-pos-fb lcec.0.2.position_actual_value_J2 => cia402.1.drv-actual-position
# [Feedback] Real Encoder Feedback (Closed Loop)
net Y-pos-fb-final cia402.1.pos-fb => joint.1.motor-pos-fb
net Y-di-raw lcec.0.2.digital_inputs_J2 => slice_Y.in
# Homing: Immediate

# --- Axis Z (Slave 3) [Type: Servo] ---
net Z-enable  joint.2.amp-enable-out => cia402.2.enable
net Z-control cia402.2.controlword => lcec.0.3.control_word_J3
net Z-status  lcec.0.3.status_word_J3 => cia402.2.statusword
setp cia402.2.csp-mode 1
setp cia402.2.pos-scale [JOINT_2]STEP_SCALE
net Z-pos-cmd joint.2.motor-pos-cmd => cia402.2.pos-cmd
net Z-drv-target cia402.2.drv-target-position => lcec.0.3.target_position_J3
net Z-pos-fb lcec.0.3.position_actual_value_J3 => cia402.2.drv-actual-position
# [Feedback] Real Encoder Feedback (Closed Loop)
net Z-pos-fb-final cia402.2.pos-fb => joint.2.motor-pos-fb
net Z-di-raw lcec.0.3.digital_inputs_J3 => slice_Z.in
# Homing: Immediate

# === STANDARD SIGNALS (Source) ===
net coolant-flood iocontrol.0.coolant-flood
net coolant-mist  iocontrol.0.coolant-mist
net spindle-on    spindle.0.on
net spindle-cw    spindle.0.forward
net spindle-ccw   spindle.0.reverse
net spindle-brake spindle.0.brake

# === GENERAL IO MAPPINGS ===
# Input Group 0 (Slave 13)
net probe-in lcec.0.13.din-00
net Pin1 lcec.0.13.din-01
net Pin2 lcec.0.13.din-02
net Pin3 lcec.0.13.din-03
net Pin4 lcec.0.13.din-04
net Pin5 lcec.0.13.din-05
net Pin6 lcec.0.13.din-06
net Pin7 lcec.0.13.din-07
net Pin8 lcec.0.13.din-08
net Pin9 lcec.0.13.din-09
net Pin10 lcec.0.13.din-10
net Pin11 lcec.0.13.din-11
net Pin12 lcec.0.13.din-12
net Pin13 lcec.0.13.din-13
net Pin14 lcec.0.13.din-14
net Pin15 lcec.0.13.din-15
net Pin16 lcec.0.13.din-16
net Pin17 lcec.0.13.din-17
net Pin18 lcec.0.13.din-18
net Pin19 lcec.0.13.din-19
net Pin20 lcec.0.13.din-20
net Pin21 lcec.0.13.din-21
net Pin22 lcec.0.13.din-22
net Pin23 lcec.0.13.din-23
net Pin24 lcec.0.13.din-24
net Pin25 lcec.0.13.din-25
net Pin26 lcec.0.13.din-26
net Pin27 lcec.0.13.din-27
net Pin28 lcec.0.13.din-28
net Pin29 lcec.0.13.din-29
net Pin30 lcec.0.13.din-30
net Pin31 lcec.0.13.din-31

# Output Group 0 (Slave 13)
net ---CustomNone--- => lcec.0.13.dout-00
net ---CustomNone--- => lcec.0.13.dout-01
net coolant-flood => lcec.0.13.dout-02
net coolant-mist => lcec.0.13.dout-03
net Pin4 => lcec.0.13.dout-04
net Pin5 => lcec.0.13.dout-05
net Pin6 => lcec.0.13.dout-06
net Pin7 => lcec.0.13.dout-07
net Pin8 => lcec.0.13.dout-08
net Pin9 => lcec.0.13.dout-09
net Pin10 => lcec.0.13.dout-10
net Pin11 => lcec.0.13.dout-11
net Pin12 => lcec.0.13.dout-12
net Pin13 => lcec.0.13.dout-13
net Pin14 => lcec.0.13.dout-14
net Pin15 => lcec.0.13.dout-15
net Pin16 => lcec.0.13.dout-16
net Pin17 => lcec.0.13.dout-17
net Pin18 => lcec.0.13.dout-18
net Pin19 => lcec.0.13.dout-19
net Pin20 => lcec.0.13.dout-20
net Pin21 => lcec.0.13.dout-21
net Pin22 => lcec.0.13.dout-22
net Pin23 => lcec.0.13.dout-23
