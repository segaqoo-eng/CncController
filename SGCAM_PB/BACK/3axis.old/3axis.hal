# Generated by CncController
loadrt [KINS]KINEMATICS
loadrt [EMCMOT]EMCMOT servo_period_nsec=[EMCMOT]SERVO_PERIOD num_joints=[KINS]JOINTS
loadrt cia402 count=3
loadrt bitslice names=slice_X,slice_Y,slice_Z personality=32,32,32
loadusr -W lcec_conf ethercat-conf.xml
loadrt lcec

addf lcec.read-all          servo-thread
addf slice_X             servo-thread
addf slice_Y             servo-thread
addf slice_Z             servo-thread
addf cia402.0.read-all      servo-thread
addf cia402.1.read-all      servo-thread
addf cia402.2.read-all      servo-thread
addf motion-command-handler servo-thread
addf motion-controller      servo-thread
addf cia402.0.write-all     servo-thread
addf cia402.1.write-all     servo-thread
addf cia402.2.write-all     servo-thread
addf lcec.write-all         servo-thread

# Axis X -> Slave 0
net X-enable      joint.0.amp-enable-out  => cia402.0.enable
net X-control     cia402.0.controlword    => lcec.0.0.control_word_J0
net X-status      lcec.0.0.status_word_J0 => cia402.0.statusword
setp cia402.0.csp-mode 1
setp lcec.0.0.modes_of_operation_J0 8
setp cia402.0.pos-scale [JOINT_0]STEP_SCALE
net X-pos-cmd     joint.0.motor-pos-cmd         => cia402.0.pos-cmd
net X-drv-target  cia402.0.drv-target-position  => lcec.0.0.target_position_J0
net X-pos-fb      lcec.0.0.position_actual_value_J0 => cia402.0.drv-actual-position
net X-pos-fb-final cia402.0.pos-fb              => joint.0.motor-pos-fb
net X-di-raw      lcec.0.0.digital_inputs_J0 => slice_X.in
net X-home-sw     slice_X.out-02 => joint.0.home-sw-in

# Axis Y -> Slave 2
net Y-enable      joint.1.amp-enable-out  => cia402.1.enable
net Y-control     cia402.1.controlword    => lcec.0.2.control_word_J2
net Y-status      lcec.0.2.status_word_J2 => cia402.1.statusword
setp cia402.1.csp-mode 1
setp lcec.0.2.modes_of_operation_J2 8
setp cia402.1.pos-scale [JOINT_1]STEP_SCALE
net Y-pos-cmd     joint.1.motor-pos-cmd         => cia402.1.pos-cmd
net Y-drv-target  cia402.1.drv-target-position  => lcec.0.2.target_position_J2
net Y-pos-fb      lcec.0.2.position_actual_value_J2 => cia402.1.drv-actual-position
net Y-pos-fb-final cia402.1.pos-fb              => joint.1.motor-pos-fb
net Y-di-raw      lcec.0.2.digital_inputs_J2 => slice_Y.in
net Y-home-sw     slice_Y.out-02 => joint.1.home-sw-in

# Axis Z -> Slave 3
net Z-enable      joint.2.amp-enable-out  => cia402.2.enable
net Z-control     cia402.2.controlword    => lcec.0.3.control_word_J3
net Z-status      lcec.0.3.status_word_J3 => cia402.2.statusword
setp cia402.2.csp-mode 1
setp lcec.0.3.modes_of_operation_J3 8
setp cia402.2.pos-scale [JOINT_2]STEP_SCALE
net Z-pos-cmd     joint.2.motor-pos-cmd         => cia402.2.pos-cmd
net Z-drv-target  cia402.2.drv-target-position  => lcec.0.3.target_position_J3
net Z-pos-fb      lcec.0.3.position_actual_value_J3 => cia402.2.drv-actual-position
net Z-pos-fb-final cia402.2.pos-fb              => joint.2.motor-pos-fb
net Z-di-raw      lcec.0.3.digital_inputs_J3 => slice_Z.in
net Z-home-sw     slice_Z.out-02 => joint.2.home-sw-in

